import { ListView, LineEdit, ScrollView, ComboBox } from "std-widgets.slint";

// ── Data ───────────────────────────────────────────────────────────────────

struct CardItem {
    id: string,
    title: string,
    subtitle: string,
    cover: image,
    installed: bool,
    is-windows: bool,
    update-available: bool,
    needs-rom: bool,
    rom-ok: bool,
    busy: bool,
    progress: float,
    kind: string,
    sys-color: color,
    favorite: bool,
    play-state: int, // 0 none, 1 launching, 2 failed
    install-error: bool,
    version: string,     // installed tag, or latest for catalog cards
    new-version: string, // target tag when an update is available
    meta: string,        // extra line for the "Seguir jugando" strip ("hace 2h")
    is-new: bool,        // recently added to the catalog
    versions: int,       // projects folded into this card (1 = plain project)
    aspect: float,       // width/height of the system's original box (1.43 N64, 1.0 PS1, 0.58 PSP…)
    card-w: float,       // px: slot width for this card (box height is shared by the whole grid)
    experimental: bool,  // tier experimental: shown with a warning badge
}

// A grid row: either a section header or a packed row of cards.
struct GridRow {
    header: string,     // non-empty = section header row (no cards)
    cards: [CardItem],
}

// One version of a game in the detail page's selector.
struct VersionRow {
    id: string,
    name: string,
    kind: string,        // "RECOMP" | "PORT"
    is-windows: bool,
    installed: bool,
    active: bool,        // the version currently shown
    platforms: string,   // "Linux · Windows"
    meta: string,        // latest tag
}

struct SysRow {
    id: string,
    name: string,
    count: int,
    color: color,
    logo: image,
    has-logo: bool,
    exp-on: bool,     // experimental ports of this system are listed
    exp-hidden: int,  // experimental ports currently hidden
}

struct FactRow {
    label: string,
    value: string,
    accent: color,
}

struct RaBadge {
    img: image,
    has-img: bool,
    unlocked: bool,
}

struct ScreenShot {
    img: image,
    path: string,
}

struct TvShelf {
    name: string,
    count: int,
    card-w: float,       // px: box width at the shelf's 237px height, per system aspect
    games: [CardItem],
}

struct ModRow {
    full-name: string,
    name: string,
    owner: string,
    downloads: string,
    description: string,
    icon: image,
    has-icon: bool,
    installed: bool,
    update: bool,
    busy: bool,
    progress: float,
    phase: string,
}

struct DetailData {
    id: string,
    title: string,
    subtitle: string,
    cover: image,
    installed: bool,
    is-windows: bool,
    update-available: bool,
    needs-rom: bool,
    rom-ok: bool,
    is-ps4: bool,      // PS4 port: offers the PKG importer
    is-switch: bool,   // Switch port: offers the NSP/XCI importer
    phase: string,     // busy label override (e.g. PKG import)
    busy: bool,
    progress: float,
    play-state: int,
    install-error: bool,
    stats: string,
    repo-url: string,
    last-updated: string,
    changelog: string,
    about: string,
    port-notes: string,
    has-related: bool,
    has-versions: bool,
    has-mods: bool,
    has-screens: bool,
    ra-eligible: bool,
    ra-enabled: bool,
    ra-beta: bool,
    kind: string,        // "RECOMP" | "PORT"
    tier: string,        // "curado" | "comunidad" | "experimental"
    aspect: float,       // width/height of the system's original box
    default-labels: [string], // "Preguntar", then one per version
    default-index: int,       // current choice in default-labels
    version: string,     // installed tag
    new-version: string, // latest tag when an update is available
    facts: [FactRow],
    repo-label: string,      // "↗ Ver en GitHub" | "↗ Web oficial"
    ra-summary: string,      // "12/97 logros · 80/749 pts" (empty = no section)
    badge-rows: [[RaBadge]],
    related: [CardItem],
    versions: [VersionRow],
    mods: [ModRow],
    screens: [ScreenShot],
}

// ── Building blocks ────────────────────────────────────────────────────────
// Palette: bg #0b0c10 · panel #14161d · raised #1c1f28 · line #262a35 ·
// accent #ffb23e (primary) · ok #4de1c1 · danger #ff5d73 · warn #ff9f43.

// Button. `kind`: "primary" (amber), "secondary" (raised), "ghost" (text only),
// "danger" (red text). `big` gives the page-level size.
component Btn inherits Rectangle {
    in property <string> label;
    in property <string> kind: "primary";
    in property <bool> big: false;
    in property <color> fg: root.kind == "primary" ? #0b0c10
                          : (root.kind == "danger" ? #ff5d73 : (root.kind == "ghost" ? #ffffffcc : white));
    in property <color> bg: root.kind == "primary" ? #ffb23e : (root.kind == "ghost" ? #00000000 : #1c1f28);
    out property <bool> hovered: touch.has-hover;
    callback clicked;
    height: root.big ? 36px : 28px;
    border-radius: 7px;
    background: touch.pressed ? bg.darker(20%)
              : (touch.has-hover ? (root.kind == "ghost" ? #ffffff14 : bg.brighter(18%)) : bg);
    border-width: root.kind == "secondary" || root.kind == "danger" ? 1px : 0px;
    border-color: #2b2f3a;
    animate background { duration: 120ms; easing: ease-out; }
    preferred-width: t.preferred-width + (root.big ? 28px : 20px);
    min-width: t.preferred-width + (root.big ? 28px : 20px);
    t := Text { x: root.big ? 14px : 10px; width: parent.width - (root.big ? 28px : 20px); height: parent.height;
                text: root.label; color: root.fg; font-size: root.big ? 13px : 12px; font-weight: 700;
                horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Cover art that never crops the boxart: the full image is shown (contain) on
// a dark slot. Slots already follow the system's box shape, so the art fills it.
component Cover inherits Rectangle {
    in property <image> source;
    in property <string> title;
    in property <bool> hovered;
    background: #14161d;
    if root.source.width == 0: Text {
        x: 8px; width: parent.width - 16px; height: parent.height;
        text: root.title; color: #ffffff66; font-size: 12px; font-weight: 700;
        wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center;
    }
    Image {
        source: root.source;
        width: root.hovered ? parent.width * 1.04 : parent.width;
        height: root.hovered ? parent.height * 1.04 : parent.height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
        animate width, height { duration: 220ms; easing: ease-out; }
    }
}

// Segmented option (S / M / L, sort modes…).
component Seg inherits Rectangle {
    in property <string> label;
    in property <string> mode;
    in property <string> active;
    callback pick(string);
    height: 28px;
    width: max(34px, sg-t.preferred-width + 18px);
    border-radius: 6px;
    background: root.active == root.mode ? #ffb23e : (sg-ta.has-hover ? #ffffff10 : #00000000);
    animate background { duration: 120ms; easing: ease-out; }
    sg-t := Text { width: 100%; height: 100%; text: root.label; color: root.active == root.mode ? #0b0c10 : #ffffffaa;
                   font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    sg-ta := TouchArea { mouse-cursor: pointer; clicked => { root.pick(root.mode); } }
}

// On/off switch.
component Toggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);
    width: 40px; height: 22px; border-radius: 11px;
    background: root.checked ? #ffb23e : (tg-ta.has-hover ? #3a3f4c : #2b2f3a);
    animate background { duration: 140ms; easing: ease-out; }
    Rectangle {
        x: root.checked ? 20px : 2px; y: 2px; width: 18px; height: 18px; border-radius: 9px;
        background: root.checked ? #0b0c10 : #ffffffcc;
        animate x { duration: 140ms; easing: ease-out; }
    }
    tg-ta := TouchArea { mouse-cursor: pointer; clicked => { root.checked = !root.checked; root.toggled(root.checked); } }
}

// Thin progress bar. `value` in 0.0..1.0; when < 0 shows an indeterminate sweep.
component Bar inherits Rectangle {
    in property <float> value;
    in property <color> fill: #ffb23e;
    height: 5px;
    border-radius: 3px;
    background: #ffffff1a;
    clip: true;
    property <float> sweep;
    animate sweep { duration: 1100ms; iteration-count: -1; easing: ease-in-out; }
    init => { self.sweep = 1.0; }
    Rectangle {
        x: root.value >= 0 ? 0px : (parent.width * 0.6) * root.sweep;
        width: root.value >= 0 ? parent.width * clamp(root.value, 0.0, 1.0) : parent.width * 0.4;
        height: parent.height;
        border-radius: 3px;
        background: root.fill;
        animate width { duration: 180ms; easing: ease-out; }
    }
}

// Small status chip: tinted text on a translucent fill of the same colour.
component Tag inherits Rectangle {
    in property <string> label;
    in property <color> tint: #ffffffcc;
    in property <bool> solid: false;
    border-radius: 4px;
    background: root.solid ? root.tint : root.tint.with-alpha(0.16);
    height: 18px;
    width: tg-l.preferred-width;
    tg-l := HorizontalLayout {
        padding-left: 6px; padding-right: 6px;
        Text { text: root.label; color: root.solid ? #0b0c10 : root.tint; font-size: 9px; font-weight: 800;
               vertical-alignment: center; letter-spacing: 0.4px; }
    }
}

// RECOMP (amber) / PORT (blue) pill — one look everywhere.
component KindPill inherits Rectangle {
    in property <string> kind;
    height: 18px;
    width: kp-l.preferred-width;
    border-radius: 4px;
    background: root.kind == "RECOMP" ? #ffb23e : #3fa7e0;
    kp-l := HorizontalLayout {
        padding-left: 7px; padding-right: 7px;
        Text { text: root.kind == "RECOMP" ? "RECOMP" : "PORT";
               color: #0b0c10; font-size: 9px; font-weight: 900; vertical-alignment: center; letter-spacing: 0.5px; }
    }
}

// Version selector chip (detail hero): name + kind/platforms, amber when active.
component VersionChip inherits Rectangle {
    in property <VersionRow> ver;
    callback clicked;
    height: 38px;
    width: vc-l.preferred-width;
    border-radius: 8px;
    background: root.ver.active ? #ffb23e1f : (vc-ta.has-hover ? #ffffff12 : #ffffff08);
    border-width: 1px;
    border-color: root.ver.active ? #ffb23e : #ffffff1f;
    animate background, border-color { duration: 150ms; }
    vc-l := HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 8px;
        VerticalLayout {
            alignment: center; spacing: 1px;
            Text { text: root.ver.name; color: root.ver.active ? #ffb23e : white; font-size: 12px; font-weight: 800; }
            Text { text: (root.ver.kind == "RECOMP" ? "Recomp" : "Port")
                         + (root.ver.platforms != "" ? " · " + root.ver.platforms : "")
                         + (root.ver.is-windows ? " · Wine/Proton" : "")
                         + (root.ver.meta != "" ? " · " + root.ver.meta : "");
                   color: #ffffff80; font-size: 9px; }
        }
        if root.ver.installed: Text { text: "✓"; color: #4de1c1; font-size: 13px; font-weight: 900; vertical-alignment: center; }
    }
    vc-ta := TouchArea { mouse-cursor: root.ver.active ? MouseCursor.default : MouseCursor.pointer; clicked => { root.clicked(); } }
}

// Section header with an accent bar.
component SectionHeader inherits HorizontalLayout {
    in property <string> label;
    in property <string> meta;
    in property <color> accent: #ffb23e;
    spacing: 10px;
    alignment: start;
    Rectangle { width: 3px; height: 18px; border-radius: 2px; background: root.accent; }
    Text { text: root.label; font-size: 16px; font-weight: 800; color: white; vertical-alignment: center; }
    if root.meta != "": Text { text: root.meta; color: #ffffff66; font-size: 12px; vertical-alignment: center; }
}

// Sidebar navigation entry: icon + label, optional count badge.
component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active;
    in property <int> badge: 0;
    callback clicked;
    height: 36px; border-radius: 8px;
    background: root.active ? #ffb23e1a : (nv-ta.has-hover ? #ffffff0a : #00000000);
    animate background { duration: 130ms; easing: ease-out; }
    Rectangle { x: 0px; y: 9px; width: 3px; height: 18px; border-radius: 2px;
                background: root.active ? #ffb23e : #00000000; animate background { duration: 160ms; } }
    HorizontalLayout {
        padding-left: 14px; padding-right: 10px; spacing: 10px;
        Image { source: root.icon; width: 18px; height: 18px; y: (parent.height - 18px) / 2;
                colorize: root.active ? #ffb23e : (nv-ta.has-hover ? white : #ffffffb0); }
        Text { text: root.label; color: root.active ? white : #ffffffcc; font-size: 13px; font-weight: 700;
               vertical-alignment: center; horizontal-stretch: 1; }
        if root.badge > 0: Rectangle {
            width: 22px; height: 18px; border-radius: 9px; background: #ffb23e; y: (parent.height - 18px) / 2;
            Text { text: "\{root.badge}"; color: #0b0c10; font-size: 10px; font-weight: 900;
                   horizontal-alignment: center; vertical-alignment: center; }
        }
    }
    nv-ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Sidebar console entry: colour logo, name, count.
component SideRow inherits Rectangle {
    in property <string> label;
    in property <int> count;
    in property <image> logo;
    in property <bool> has-logo;
    in property <bool> active;
    in property <image> icon;      // shown in the logo slot when there is no logo
    callback clicked;
    height: 36px; border-radius: 8px;
    background: root.active ? #ffb23e1a : (sr-ta.has-hover ? #ffffff0a : #00000000);
    animate background { duration: 130ms; easing: ease-out; }
    Rectangle { x: 0px; y: 8px; width: 3px; height: 18px; border-radius: 2px;
                background: root.active ? #ffb23e : #00000000; animate background { duration: 160ms; } }
    HorizontalLayout {
        padding-left: 12px; padding-right: 10px; spacing: 10px;
        Rectangle {
            width: 70px;
            if root.has-logo: Image { source: root.logo; width: 70px; height: 24px; image-fit: contain;
                                      horizontal-alignment: left; y: (parent.height - 24px) / 2;
                                      opacity: root.active ? 1.0 : 0.92; }
            if !root.has-logo: Image { source: root.icon; width: 18px; height: 18px; x: 2px; y: (parent.height - 18px) / 2;
                                       colorize: root.active ? #ffb23e : #ffffffaa; }
        }
        Text { text: root.label; color: root.active ? white : #ffffffcc; font-size: 12px; font-weight: 600;
               vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        Text { text: "\{root.count}"; color: #ffffff55; font-size: 11px; vertical-alignment: center; }
    }
    sr-ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Settings section: title, description, content.
component SettingsCard inherits Rectangle {
    in property <string> title;
    in property <string> desc;
    border-radius: 10px;
    background: #14161d;
    border-width: 1px; border-color: #262a35;
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        VerticalLayout {
            spacing: 4px;
            Text { text: root.title; color: white; font-size: 15px; font-weight: 800; }
            if root.desc != "": Text { text: root.desc; color: #ffffff77; font-size: 12px; wrap: word-wrap; }
        }
        @children
    }
}

// A labelled row inside a settings card: text on the left, control on the right.
component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: 14px;
    VerticalLayout {
        alignment: center; spacing: 2px; horizontal-stretch: 1;
        Text { text: root.label; color: white; font-size: 13px; }
        if root.hint != "": Text { text: root.hint; color: #ffffff66; font-size: 11px; wrap: word-wrap; }
    }
    @children
}

// ── Window ─────────────────────────────────────────────────────────────────

export component MainWindow inherits Window {
    in property <[SysRow]> systems;
    in property <[GridRow]> rows;
    in property <string> header-title;
    in property <int> header-count;
    in-out property <string> active-system;
    in-out property <bool> library-tab;
    in-out property <string> search-text;
    // Bulk "update everything" state
    in property <int> updates-pending;
    in property <bool> bulk-busy;
    in property <float> bulk-progress;
    in property <string> bulk-label;
    callback update-all();
    // "Seguir jugando" strip (library tab)
    in property <[CardItem]> recent;
    // "Nuevas incorporaciones" strip (catalog tab): games added in the last week.
    in property <[CardItem]> newcomers;
    // Card size (from settings): height of every box in the grid; widths follow
    // each system's box shape so a row reads like a shelf.
    in property <length> card-h: 190px;
    in-out property <string> card-size: "m";
    callback set-card-size(string);
    // Library footprint on disk ("3.2 GB"), shown in settings.
    in property <string> library-size;
    // Add-to-Steam (game page side panel)
    callback add-steam(string);
    in property <string> detail-msg;
    callback cancel-update-all();
    callback cancel-install(string);
    callback refresh();
    callback toggle-favorite(string);
    callback open-folder(string);
    callback open-game(string);
    callback install(string);
    callback play(string);
    callback uninstall(string);
    callback pick-rom(string);
    callback import-pkg(string);
    callback import-switch(string);
    callback close-detail();
    callback install-mod(string, string);
    callback uninstall-mod(string, string);
    callback toggle-ra(string, bool);
    callback open-url(string);
    // In-app screenshot viewer (lightbox)
    in-out property <image> viewer-image;
    in-out property <bool> viewer-visible;
    in property <DetailData> detail;
    in property <bool> detail-visible;
    // Uninstall confirmation
    in-out property <bool> confirm-visible;
    // Version chooser (install / play / uninstall when a game has several ports)
    in-out property <bool> chooser-visible;
    in property <string> chooser-title;
    in property <string> chooser-mode;        // "install" | "play" | "uninstall"
    in property <[VersionRow]> chooser-items;
    in-out property <bool> chooser-remember;
    callback choose-version(string, bool);    // project id, remember
    callback request-uninstall(string);       // card ✕: Rust decides (chooser or confirm)
    callback set-default-version(string, int); // detail id, index in default-labels (0 = ask)
    in-out property <string> confirm-id;
    in-out property <string> confirm-title;
    // Settings
    in-out property <bool> settings-visible;
    in-out property <bool> show-windows;
    in property <[SysRow]> settings-systems;    // first half of every system (per-system experimental switches)
    in property <[SysRow]> settings-systems-b;  // second half (two columns)
    in property <bool> active-exp-on;         // header: experimentals shown for the selected system
    in property <int> active-exp-hidden;      // header: how many are hidden for it
    // Experimental 3D box viewer (box painted by OpenGL inside `v3-*`)
    in-out property <bool> viewer3d-visible;
    in property <string> viewer3d-id;
    in property <string> viewer3d-title;
    in property <bool> viewer3d-installed;
    out property <length> v3-x: v3-area.absolute-position.x;
    out property <length> v3-y: v3-area.absolute-position.y;
    out property <length> v3-w: v3-area.width;
    out property <length> v3-h: v3-area.height;
    callback open-viewer3d(string);
    callback close-viewer3d();
    callback viewer3d-drag(length, length);
    callback viewer3d-release();
    in-out property <string> notice;          // transient message bar (bottom); empty = hidden
    in-out property <string> rail-tip;        // (kept for compatibility; unused)
    in-out property <length> rail-tip-y;
    in-out property <string> current-runner-label;
    in property <string> version;
    in property <string> platform-label;
    in property <[string]> runner-labels;
    in property <string> settings-msg;
    in-out property <bool> catalog-busy;
    // RetroAchievements account
    in property <bool> ra-logged-in;
    in property <string> ra-status;
    callback ra-login(string, string);
    callback ra-logout();
    // RomM (the user's own ROM library server)
    in-out property <bool> romm-connected;
    in-out property <string> romm-status;
    in-out property <string> romm-url;
    in-out property <string> romm-user;
    callback romm-connect(string, string, string);
    callback romm-forget();
    callback romm-search(string);
    callback toggle-windows(bool);
    callback toggle-experimental-system(string, bool);
    callback set-runner(string);
    callback refresh-catalog();
    callback open-tv();
    // TV / Big Picture
    in property <[TvShelf]> tv-shelves;
    in property <int> tv-shelf-count;
    in property <bool> tv-visible;
    in-out property <int> tv-shelf;
    in-out property <int> tv-col;
    in property <image> tv-hero-cover;
    in property <string> tv-hero-title;
    in property <string> tv-hero-subtitle;
    callback tv-input(string);
    // Self-update
    in property <bool> update-available;
    in property <string> update-version;
    in property <string> update-notes;
    in-out property <bool> update-busy;
    in property <bool> update-error;
    callback do-update();
    callback dismiss-update();
    callback check-updates();
    // Retro CRT effect
    in-out property <bool> crt-visible;
    callback toggle-crt(bool);

    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 860px;
    min-height: 560px;
    title: "Freeport";
    background: #0b0c10;
    default-font-size: 13px;
    default-font-family: "DejaVu Sans";

    // Layout constants shared with Rust's row packer.
    property <length> side-w: 240px;
    property <length> grid-pad: 24px;
    // Pixel width the grid rows can use (Rust packs variable-width cards into it).
    out property <length> grid-width: root.width - root.side-w - 2 * root.grid-pad;
    // Coarse column estimate: repack when it changes (not on every resize pixel).
    out property <int> cols: max(1, floor(root.grid-width / (root.card-h * 0.75 + 14px)));
    changed cols => { root.refresh(); }
    // Narrow main column (set from Rust on repack): shorter header labels.
    in property <bool> narrow;

    // Navigation helpers: every sidebar action lands on a clean view.
    function go-catalog() { root.settings-visible = false; root.library-tab = false; root.active-system = ""; root.close-detail(); }
    function go-library() { root.settings-visible = false; root.library-tab = true; root.active-system = ""; root.close-detail(); }
    function go-system(id: string) { root.settings-visible = false; root.active-system = id; root.close-detail(); }

    HorizontalLayout {
        // ── Sidebar: brand, navigation, consoles ─────────────────────────
        Rectangle {
            width: root.side-w;
            background: #0e1016;
            VerticalLayout {
                padding-top: 14px; padding-bottom: 10px; padding-left: 10px; padding-right: 10px;
                spacing: 4px;
                HorizontalLayout {
                    padding-left: 10px; padding-right: 6px; padding-bottom: 8px; spacing: 9px;
                    Image { source: @image-url("../assets/logo.svg"); width: 22px; height: 22px; y: (parent.height - 22px) / 2; }
                    Text { text: "Freeport"; color: white; font-weight: 800; font-size: 16px; vertical-alignment: center; horizontal-stretch: 1; }
                }
                NavItem { icon: @image-url("../assets/icons/catalog.svg"); label: "Catálogo";
                          active: !root.library-tab && !root.settings-visible;
                          clicked => { root.go-catalog(); } }
                NavItem { icon: @image-url("../assets/icons/library.svg"); label: "Mi biblioteca";
                          active: root.library-tab && !root.settings-visible; badge: root.updates-pending;
                          clicked => { root.go-library(); } }
                NavItem { icon: @image-url("../assets/icons/tv.svg"); label: "Modo TV"; active: false;
                          clicked => { root.open-tv(); } }
                NavItem { icon: @image-url("../assets/icons/settings.svg"); label: "Configuración";
                          active: root.settings-visible;
                          clicked => { root.settings-visible = true; } }
                Rectangle { height: 1px; background: #1f232d; }
                Text { text: "CONSOLAS"; color: #ffffff55; font-size: 10px; font-weight: 800; letter-spacing: 1px;
                       height: 26px; vertical-alignment: center; x: 14px; }
                SideRow { label: "Todas"; count: root.header-count; has-logo: false; icon: @image-url("../assets/icons/catalog.svg");
                          active: root.active-system == "" && !root.settings-visible;
                          clicked => { root.go-system(""); } }
                ListView {
                    vertical-stretch: 1;
                    for s in root.systems: SideRow {
                        label: s.name; count: s.count; logo: s.logo; has-logo: s.has-logo;
                        active: root.active-system == s.id && !root.settings-visible;
                        clicked => { root.go-system(s.id); }
                    }
                }
                Text { text: "v\{root.version}"; color: #ffffff33; font-size: 10px; x: 14px; height: 18px; vertical-alignment: center; }
            }
        }
        Rectangle { width: 1px; background: #1f232d; }

        // ── Main column ─────────────────────────────────────────────────
        VerticalLayout {
            // Self-update banner. Absolute geometry: nothing here can push the
            // buttons out of view, whatever the window width.
            if root.update-available: Rectangle {
                height: 44px;
                background: #1c1f28;
                Rectangle { x: 0; width: 3px; height: 100%; background: #ffb23e; }
                Rectangle { y: parent.height - 1px; height: 1px; background: #262a35; }
                Text {
                    x: 18px; y: 0; height: parent.height;
                    width: parent.width - 18px - (root.update-busy ? 200px : 214px);
                    text: root.update-busy ? "Actualizando Freeport…"
                          : (root.update-error ? "La actualización falló"
                             : (root.update-notes != ""
                                ? "Freeport v\{root.update-version} disponible · \{root.update-notes}"
                                : "Freeport v\{root.update-version} disponible"));
                    color: white; font-size: 12px; font-weight: 700; overflow: elide; vertical-alignment: center;
                }
                if root.update-busy: Bar { x: parent.width - 190px; y: (parent.height - 5px) / 2; width: 176px; value: -1; }
                if !root.update-busy: Btn { x: parent.width - 204px; y: 8px; width: 100px;
                                            label: root.update-error ? "Reintentar" : "Actualizar"; clicked => { root.do-update(); } }
                if !root.update-busy: Btn { x: parent.width - 96px; y: 8px; width: 84px; kind: "ghost"; label: "Después";
                                            clicked => { root.dismiss-update(); } }
            }

            // ── Settings ────────────────────────────────────────────────
            if root.settings-visible: ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    padding-left: 28px; padding-right: 28px; padding-top: 22px; padding-bottom: 28px;
                    spacing: 14px;
                    alignment: start;
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: "Configuración"; font-size: 22px; font-weight: 800; color: white; }
                        Text { text: "Freeport \{root.version} · \{root.platform-label}"
                                     + (root.library-size != "" ? " · biblioteca \{root.library-size}" : "");
                               color: #ffffff66; font-size: 12px; }
                    }
                    SettingsCard {
                        title: "Juegos de Windows";
                        desc: "Muchos ports solo publican binario para Windows. Activa esto para verlos en el catálogo y lanzarlos con Wine o Proton.";
                        SettingRow { label: "Mostrar juegos de Windows";
                            Toggle { checked <=> root.show-windows; y: (parent.height - 22px) / 2; toggled(v) => { root.toggle-windows(v); } } }
                        if root.show-windows: SettingRow { label: "Runner por defecto"; hint: "Se puede cambiar por juego desde su ficha.";
                            ComboBox { width: 300px; model: root.runner-labels; current-value <=> root.current-runner-label;
                                       selected(v) => { root.set-runner(v); } } }
                    }
                    SettingsCard {
                        title: "Apariencia";
                        SettingRow { label: "Tamaño de las carátulas";
                            HorizontalLayout { spacing: 2px; alignment: end;
                                Rectangle { border-radius: 7px; background: #0e1016; border-width: 1px; border-color: #262a35;
                                    HorizontalLayout { padding: 2px; spacing: 2px;
                                        Seg { label: "S"; mode: "s"; active: root.card-size; pick(m) => { root.set-card-size(m); } }
                                        Seg { label: "M"; mode: "m"; active: root.card-size; pick(m) => { root.set-card-size(m); } }
                                        Seg { label: "L"; mode: "l"; active: root.card-size; pick(m) => { root.set-card-size(m); } } } } } }
                        SettingRow { label: "Efecto CRT"; hint: "Líneas de barrido y viñeta sobre toda la interfaz.";
                            Toggle { checked <=> root.crt-visible; y: (parent.height - 22px) / 2; toggled(v) => { root.toggle-crt(v); } } }
                    }
                    SettingsCard {
                        title: "Ports experimentales";
                        desc: "Proyectos nuevos, de un solo autor o con pocas descargas. Van marcados con ⚠ y agrupados al final de cada lista. Si desactivas una consola, sus ports experimentales no se muestran, ni siquiera los instalados.";
                        HorizontalLayout {
                            spacing: 24px;
                            VerticalLayout { spacing: 2px; horizontal-stretch: 1; alignment: start;
                                for sys in root.settings-systems: HorizontalLayout {
                                    spacing: 10px; height: 32px;
                                    Toggle { checked: sys.exp-on; y: 5px; toggled(v) => { root.toggle-experimental-system(sys.id, v); } }
                                    Rectangle { width: 64px;
                                        if sys.has-logo: Image { source: sys.logo; width: 64px; height: 20px; image-fit: contain; horizontal-alignment: left; y: 6px; }
                                        if !sys.has-logo: Text { text: sys.name; color: white; font-size: 11px; font-weight: 800; vertical-alignment: center; height: 100%; } }
                                    Text { text: sys.name; color: #ffffffcc; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                    Text { text: sys.exp-hidden > 1 ? "\{sys.exp-hidden} ocultos" : (sys.exp-hidden == 1 ? "1 oculto" : "");
                                           color: #ffffff55; font-size: 11px; vertical-alignment: center; }
                                }
                            }
                            VerticalLayout { spacing: 2px; horizontal-stretch: 1; alignment: start;
                                for sys in root.settings-systems-b: HorizontalLayout {
                                    spacing: 10px; height: 32px;
                                    Toggle { checked: sys.exp-on; y: 5px; toggled(v) => { root.toggle-experimental-system(sys.id, v); } }
                                    Rectangle { width: 64px;
                                        if sys.has-logo: Image { source: sys.logo; width: 64px; height: 20px; image-fit: contain; horizontal-alignment: left; y: 6px; }
                                        if !sys.has-logo: Text { text: sys.name; color: white; font-size: 11px; font-weight: 800; vertical-alignment: center; height: 100%; } }
                                    Text { text: sys.name; color: #ffffffcc; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                    Text { text: sys.exp-hidden > 1 ? "\{sys.exp-hidden} ocultos" : (sys.exp-hidden == 1 ? "1 oculto" : "");
                                           color: #ffffff55; font-size: 11px; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 14px;
                        SettingsCard {
                            horizontal-stretch: 1;
                            title: "RetroAchievements";
                            desc: "Logros en los recomps compatibles. La contraseña no se guarda: solo el token de sesión.";
                            if root.ra-logged-in: HorizontalLayout {
                                spacing: 10px;
                                Text { text: root.ra-status; color: #4de1c1; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                Btn { label: "Cerrar sesión"; kind: "danger"; clicked => { root.ra-logout(); } }
                            }
                            if !root.ra-logged-in: VerticalLayout {
                                spacing: 8px;
                                ra-user := LineEdit { placeholder-text: "Usuario"; height: 32px; }
                                ra-pass := LineEdit { placeholder-text: "Contraseña"; input-type: password; height: 32px; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    Btn { label: "Iniciar sesión"; clicked => { root.ra-login(ra-user.text, ra-pass.text); } }
                                    Text { text: root.ra-status; color: #ffd166; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                                }
                            }
                        }
                        SettingsCard {
                            horizontal-stretch: 1;
                            title: "RomM";
                            desc: "Con un servidor RomM conectado, cada ficha ofrece «Buscar en RomM»: baja la ROM o el volcado y lo deja donde el port lo espera.";
                            if root.romm-connected: HorizontalLayout {
                                spacing: 10px;
                                Text { text: root.romm-status; color: #4de1c1; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                Btn { label: "Desconectar"; kind: "danger"; clicked => { root.romm-forget(); } }
                            }
                            if !root.romm-connected: VerticalLayout {
                                spacing: 8px;
                                romm-url-e := LineEdit { placeholder-text: "URL, p. ej. http://192.168.1.10:8080"; text: root.romm-url; height: 32px; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    romm-user-e := LineEdit { placeholder-text: "Usuario"; text: root.romm-user; height: 32px; }
                                    romm-pass-e := LineEdit { placeholder-text: "Contraseña"; input-type: password; height: 32px; }
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    Btn { label: "Conectar"; clicked => { root.romm-connect(romm-url-e.text, romm-user-e.text, romm-pass-e.text); } }
                                    Text { text: root.romm-status; color: #ffd166; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                                }
                            }
                        }
                    }
                    SettingsCard {
                        title: "Catálogo y actualizaciones";
                        desc: "El catálogo se descarga al arrancar; aquí puedes forzarlo. Freeport avisa solo cuando hay una versión nueva.";
                        HorizontalLayout {
                            spacing: 10px; alignment: start;
                            Btn { label: root.catalog-busy ? "Actualizando…" : "Actualizar catálogo"; kind: root.catalog-busy ? "secondary" : "primary";
                                  clicked => { if (!root.catalog-busy) { root.refresh-catalog(); } } }
                            Btn { label: "Buscar actualizaciones de Freeport"; kind: "secondary"; clicked => { root.check-updates(); } }
                        }
                        if root.settings-msg != "": Text { text: root.settings-msg; color: #ffd166; font-size: 12px; wrap: word-wrap; }
                    }
                }
            }

            // ── Game page (inside the main column: the sidebar stays) ────
            if !root.settings-visible && root.detail-visible: detail-root := Rectangle {
                vertical-stretch: 1;
                background: #0b0c10;
                opacity: 0;
                init => { self.opacity = 1; }
                animate opacity { duration: 170ms; easing: ease-out; }
                TouchArea { }
                // Width available to wrapping text in the left body column.
                property <length> body-w: max(160px, dscroll.visible-width - 2 * root.grid-pad - 22px - 270px);
                VerticalLayout {
                    Rectangle {
                        height: 48px;
                        background: #0e1016;
                        Rectangle { y: parent.height - 1px; height: 1px; background: #1f232d; }
                        HorizontalLayout {
                            padding-left: 14px; padding-right: 14px; padding-top: 9px; padding-bottom: 9px;
                            spacing: 10px;
                            Btn { label: "← Volver"; kind: "ghost"; clicked => { root.close-detail(); } }
                            Text { text: root.detail.title; color: #ffffff77; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            if root.detail.installed && root.detail.update-available && !root.detail.busy: Btn {
                                label: root.detail.new-version != "" ? "↑ Actualizar a \{root.detail.new-version}" : "↑ Actualizar";
                                clicked => { root.install(root.detail.id); }
                            }
                        }
                    }
                    dscroll := ScrollView {
                        VerticalLayout {
                            width: dscroll.visible-width;
                            spacing: 0px;
                            // ── Hero: the cover as ambient backdrop, content on top ──
                            Rectangle {
                                height: 340px;
                                clip: true;
                                Image { source: root.detail.cover; width: 100%; height: 100%; image-fit: cover; opacity: 0.22; }
                                Rectangle { background: @linear-gradient(180deg, #0b0c1055 0%, #0b0c10 96%); }
                                HorizontalLayout {
                                    padding: root.grid-pad;
                                    spacing: 24px;
                                    alignment: start;
                                    Rectangle {
                                        width: min(320px, 260px * (root.detail.aspect > 0 ? root.detail.aspect : 0.667));
                                        height: self.width / (root.detail.aspect > 0 ? root.detail.aspect : 0.667);
                                        y: parent.height - self.height - root.grid-pad;
                                        border-radius: 10px; clip: true;
                                        border-width: 1px; border-color: #ffffff1f;
                                        drop-shadow-blur: 28px; drop-shadow-color: #00000099;
                                        Cover { width: 100%; height: 100%; source: root.detail.cover; title: root.detail.title; }
                                    }
                                    VerticalLayout {
                                        alignment: end;
                                        spacing: 10px;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;
                                            KindPill { kind: root.detail.kind; }
                                            if root.detail.tier == "experimental": Tag { label: "EXPERIMENTAL"; tint: #ff9f43; }
                                            if root.detail.tier == "curado": Tag { label: "CURADO"; tint: #4de1c1; }
                                            if root.detail.is-windows: Tag { label: "WINDOWS · WINE/PROTON"; tint: #9fc3ff; }
                                            if root.detail.installed && root.detail.version != "": Tag { label: "INSTALADO · \{root.detail.version}"; tint: #4de1c1; }
                                            if root.detail.update-available && root.detail.new-version != "": Tag { label: "↑ NUEVA \{root.detail.new-version}"; tint: #ffd166; }
                                        }
                                        Text { text: root.detail.title; font-size: 30px; font-weight: 900; color: white; wrap: word-wrap; }
                                        Text { text: root.detail.subtitle; font-size: 14px; color: #ffb23e; wrap: word-wrap; }
                                        if root.detail.has-versions: HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;
                                            Text { text: "VERSIONES"; color: #ffffff66; font-size: 10px; font-weight: 800;
                                                   vertical-alignment: center; letter-spacing: 0.6px; }
                                            for v in root.detail.versions: VersionChip {
                                                ver: v;
                                                clicked => { if !v.active { root.open-game(v.id); } }
                                            }
                                        }
                                        if root.detail.has-versions && root.detail.default-labels.length > 1: HorizontalLayout {
                                            spacing: 8px;
                                            alignment: start;
                                            Text { text: "Al jugar desde la tarjeta"; color: #ffffff77; font-size: 11px; vertical-alignment: center; }
                                            ComboBox {
                                                width: 260px; height: 30px;
                                                model: root.detail.default-labels;
                                                current-index: root.detail.default-index;
                                                selected => { root.set-default-version(root.detail.id, self.current-index); }
                                            }
                                        }
                                        if root.detail.stats != "": Text { text: root.detail.stats; font-size: 12px; color: #ffffff99; }
                                        if root.detail.busy: HorizontalLayout {
                                            spacing: 10px;
                                            alignment: start;
                                            VerticalLayout {
                                                spacing: 6px;
                                                width: 320px;
                                                Text { text: root.detail.phase != ""
                                                           ? (root.detail.progress > 0 ? "\{root.detail.phase} \{floor(root.detail.progress * 100)}%" : root.detail.phase)
                                                           : root.detail.installed
                                                           ? (root.detail.progress > 0 ? "Actualizando \{floor(root.detail.progress * 100)}%" : "Actualizando…")
                                                           : (root.detail.progress > 0 ? "Instalando \{floor(root.detail.progress * 100)}%" : "Instalando…");
                                                       color: #ffb23e; font-weight: 700; }
                                                Bar { value: root.detail.progress > 0 ? root.detail.progress : -1; height: 6px; }
                                            }
                                            Btn { label: "Cancelar"; kind: "danger"; clicked => { root.cancel-install(root.detail.id); } }
                                        }
                                        if !root.detail.busy: HorizontalLayout {
                                            spacing: 8px;
                                            alignment: start;
                                            if root.detail.installed: Btn {
                                                big: true;
                                                label: root.detail.play-state == 1 ? "Jugando…" : (root.detail.play-state == 2 ? "⚠ Reintentar" : "▶  Jugar");
                                                kind: root.detail.play-state == 2 ? "danger" : "primary";
                                                clicked => { if (root.detail.play-state != 1) { root.play(root.detail.id); } }
                                            }
                                            if !root.detail.installed: Btn {
                                                big: true;
                                                label: root.detail.install-error ? "⚠ Reintentar" : "↓  Instalar";
                                                kind: root.detail.install-error ? "danger" : "primary";
                                                clicked => { root.install(root.detail.id); }
                                            }
                                            if root.detail.installed && root.detail.update-available: Btn {
                                                big: true; kind: "secondary"; fg: #ffd166;
                                                label: root.detail.new-version != "" ? "↑ Actualizar a \{root.detail.new-version}" : "↑ Actualizar";
                                                clicked => { root.install(root.detail.id); }
                                            }
                                            if root.detail.installed && root.detail.needs-rom: Btn { big: true; kind: "secondary"; label: root.detail.rom-ok ? "ROM ✓" : "Seleccionar ROM"; fg: root.detail.rom-ok ? #4de1c1 : white; clicked => { root.pick-rom(root.detail.id); } }
                                            if root.detail.installed && root.detail.is-ps4: Btn { big: true; kind: "secondary"; label: root.detail.rom-ok ? "PKG importado ✓" : "Importar PKG de PS4"; fg: root.detail.rom-ok ? #4de1c1 : white; clicked => { root.import-pkg(root.detail.id); } }
                                            if root.detail.installed && root.detail.is-switch: Btn { big: true; kind: "secondary"; label: root.detail.rom-ok ? "Juego importado ✓" : "Importar NSP/XCI/NSZ"; fg: root.detail.rom-ok ? #4de1c1 : white; clicked => { root.import-switch(root.detail.id); } }
                                            if root.detail.installed && root.romm-connected: Btn { big: true; kind: "secondary"; label: "Buscar en RomM"; clicked => { root.romm-search(root.detail.id); } }
                                            if root.detail.installed && root.detail.ra-eligible && root.ra-logged-in: Btn {
                                                big: true; kind: "secondary";
                                                label: root.detail.ra-enabled
                                                    ? "RetroAchievements ✓"
                                                    : (root.detail.ra-beta ? "RetroAchievements (beta)" : "RetroAchievements");
                                                fg: root.detail.ra-enabled ? #4de1c1 : white;
                                                clicked => { root.toggle-ra(root.detail.id, !root.detail.ra-enabled); }
                                            }
                                        }
                                    }
                                }
                            }
                            // ── Body: content column + facts panel ──
                            HorizontalLayout {
                                padding: root.grid-pad;
                                padding-top: 14px;
                                spacing: 22px;
                                alignment: start;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 22px;
                                    if root.detail.has-screens: VerticalLayout {
                                        spacing: 10px;
                                        SectionHeader { label: "Capturas"; }
                                        ScrollView {
                                            height: 152px;
                                            HorizontalLayout {
                                                spacing: 10px;
                                                alignment: start;
                                                for s in root.detail.screens: Rectangle {
                                                    width: 260px; height: 146px; border-radius: 8px; background: #1c1f28; clip: true;
                                                    Image { source: s.img; width: 100%; height: 100%; image-fit: cover; }
                                                    sc-ta := TouchArea { mouse-cursor: pointer;
                                                        clicked => { root.viewer-image = s.img; root.viewer-visible = true; } }
                                                }
                                            }
                                        }
                                    }
                                    if root.detail.about != "": VerticalLayout {
                                        spacing: 10px;
                                        SectionHeader { label: "Acerca del juego"; }
                                        Text { text: root.detail.about; color: #ffffffcc; font-size: 13px; wrap: word-wrap;
                                               width: detail-root.body-w; }
                                    }
                                    if root.detail.port-notes != "": Rectangle {
                                        border-radius: 10px;
                                        background: #14161d;
                                        border-width: 1px;
                                        border-color: #262a35;
                                        VerticalLayout {
                                            padding: 16px;
                                            spacing: 8px;
                                            Text { text: "Cómo funciona (ROM / instalación)"; font-size: 13px; font-weight: 800; color: #ffb23e; }
                                            Text { text: root.detail.port-notes; color: #ffffffbb; font-size: 12px; wrap: word-wrap;
                                                   width: detail-root.body-w - 32px; }
                                        }
                                    }
                                    if root.detail.changelog != "": VerticalLayout {
                                        spacing: 10px;
                                        SectionHeader { label: "Novedades"; meta: root.detail.last-updated; }
                                        Rectangle {
                                            border-radius: 10px;
                                            background: #14161d;
                                            border-width: 1px;
                                            border-color: #262a35;
                                            VerticalLayout {
                                                padding: 16px;
                                                Text { text: root.detail.changelog; color: #ffffffcc; font-size: 12px; wrap: word-wrap;
                                                       width: detail-root.body-w - 32px; }
                                            }
                                        }
                                    }
                                    if root.detail.ra-summary != "": VerticalLayout {
                                        spacing: 10px;
                                        SectionHeader { label: "Logros"; meta: root.detail.ra-summary; }
                                        VerticalLayout {
                                            spacing: 6px;
                                            for row in root.detail.badge-rows: HorizontalLayout {
                                                spacing: 6px;
                                                alignment: start;
                                                for b in row: Rectangle {
                                                    width: 44px; height: 44px; border-radius: 6px; clip: true;
                                                    background: #14161d;
                                                    border-width: 1px;
                                                    border-color: b.unlocked ? #ffb23e88 : #262a35;
                                                    opacity: b.unlocked ? 1.0 : 0.4;
                                                    if b.has-img: Image { source: b.img; width: 100%; height: 100%; image-fit: cover; }
                                                    if !b.has-img: Text { text: "?"; color: #ffffff44; font-size: 16px;
                                                                          horizontal-alignment: center; vertical-alignment: center; }
                                                }
                                            }
                                        }
                                    }
                                    if root.detail.has-related: VerticalLayout {
                                        spacing: 10px;
                                        SectionHeader { label: "Relacionados"; }
                                        ScrollView {
                                            height: 200px;
                                            HorizontalLayout {
                                                spacing: 12px;
                                                alignment: start;
                                                for r in root.detail.related: rel := Rectangle {
                                                    property <length> rel-w: clamp(160px * (r.aspect > 0 ? r.aspect : 0.667), 96px, 230px);
                                                    width: self.rel-w; height: 190px;
                                                    VerticalLayout {
                                                        spacing: 5px;
                                                        alignment: start;
                                                        Rectangle { height: 160px; border-radius: 8px; clip: true; background: #14161d;
                                                            rel-cover := Cover { width: 100%; height: 100%; source: r.cover; title: r.title; hovered: rel-ta.has-hover; }
                                                            rel-ta := TouchArea { mouse-cursor: pointer; clicked => { root.open-game(r.id); } }
                                                        }
                                                        Text { text: r.title; color: #ffffffcc; font-size: 11px; overflow: elide; }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    if root.detail.has-mods: VerticalLayout {
                                        spacing: 10px;
                                        SectionHeader { label: "Mods"; }
                                        for m in root.detail.mods: Rectangle {
                                            height: 74px;
                                            border-radius: 8px;
                                            background: #14161d;
                                            border-width: 1px;
                                            border-color: m.installed ? #4de1c144 : #262a35;
                                            HorizontalLayout {
                                                padding: 10px;
                                                spacing: 10px;
                                                Rectangle {
                                                    width: 54px; height: 54px; border-radius: 8px; background: #1c1f28; clip: true;
                                                    if m.has-icon: Image { source: m.icon; width: 100%; height: 100%; image-fit: cover; }
                                                    if !m.has-icon: Text { text: "◈"; font-size: 24px; color: #ffffff66;
                                                                           horizontal-alignment: center; vertical-alignment: center; }
                                                }
                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    spacing: 3px;
                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        alignment: start;
                                                        Text { text: m.name; color: white; font-weight: 700; font-size: 13px; overflow: elide; }
                                                        if m.installed: Tag { label: "INSTALADO"; tint: #4de1c1; }
                                                    }
                                                    Text { text: "\{m.owner} · \{m.downloads} descargas"; color: #ffffff99; font-size: 11px; }
                                                    if !m.busy: Text { text: m.description; color: #ffffff88; font-size: 11px; overflow: elide; }
                                                    if m.busy: Bar { value: m.progress > 0 ? m.progress : -1; }
                                                }
                                                if m.busy: Text { text: m.phase == "extract" ? "Extrayendo…" : (m.progress > 0 ? "\{floor(m.progress * 100)}%" : "…");
                                                                  color: #ffb23e; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                                if !m.busy && m.update: Btn { label: "Actualizar"; kind: "secondary"; fg: #ffd166; clicked => { root.install-mod(root.detail.id, m.full-name); } }
                                                if !m.busy && m.installed && !m.update: Btn { label: "Quitar"; kind: "danger"; clicked => { root.uninstall-mod(root.detail.id, m.full-name); } }
                                                if !m.busy && !m.installed: Btn { label: "Instalar"; clicked => { root.install-mod(root.detail.id, m.full-name); } }
                                            }
                                        }
                                    }
                                } // end left content column
                                // ── Facts panel (right) ──
                                VerticalLayout {
                                    width: 270px;
                                    spacing: 8px;
                                    alignment: start;
                                    Rectangle {
                                        border-radius: 10px;
                                        background: #14161d;
                                        border-width: 1px;
                                        border-color: #262a35;
                                        VerticalLayout {
                                            padding: 16px;
                                            spacing: 10px;
                                            Text { text: "FICHA TÉCNICA"; color: #ffffff66; font-size: 10px; font-weight: 900; letter-spacing: 1px; }
                                            for f in root.detail.facts: VerticalLayout {
                                                spacing: 1px;
                                                Text { text: f.label; color: #ffffff66; font-size: 10px; }
                                                Text { text: f.value; color: f.accent; font-size: 13px; font-weight: 600; wrap: word-wrap; width: 238px; }
                                            }
                                        }
                                    }
                                    if root.detail.repo-url != "": Btn { label: root.detail.repo-label; kind: "secondary"; clicked => { root.open-url(root.detail.repo-url); } }
                                    if root.detail.installed: Btn { label: "Abrir carpeta"; kind: "secondary"; clicked => { root.open-folder(root.detail.id); } }
                                    if root.detail.installed: Btn { label: "Añadir a Steam"; kind: "secondary"; clicked => { root.add-steam(root.detail.id); } }
                                    Btn { label: "Ver la caja en 3D"; kind: "secondary"; clicked => { root.open-viewer3d(root.detail.id); } }
                                    if root.detail.installed: Btn { label: "Eliminar del equipo"; kind: "danger"; clicked => { root.confirm-id = root.detail.id; root.confirm-title = root.detail.title; root.confirm-visible = true; } }
                                    if root.detail-msg != "": Text { text: root.detail-msg; color: #ffd166; font-size: 11px; wrap: word-wrap; width: 270px; }
                                }
                            } // end body row
                        }
                    }
                }
            }

            // ── Catalog / library ───────────────────────────────────────
            if !root.settings-visible && !root.detail-visible: VerticalLayout {
                // Header: title, count, filters, search. Inside a Flickable so its
                // content can never widen the column (and push things off-screen).
                Flickable {
                    height: 62px;
                    interactive: false;
                    HorizontalLayout {
                        padding-left: root.grid-pad; padding-right: root.grid-pad; padding-top: 14px; padding-bottom: 10px;
                        spacing: 10px;
                        Text { text: root.header-title; color: white; font-size: 22px; font-weight: 800; vertical-alignment: center; }
                        Text { text: root.header-count == 1 ? "1 juego" : "\{root.header-count} juegos"; color: #ffffff66; font-size: 13px; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        if root.active-system != "" && (root.active-exp-hidden > 0 || root.active-exp-on): Rectangle {
                            height: 30px; width: hx-l.preferred-width; border-radius: 7px; y: (parent.height - 30px) / 2;
                            background: root.active-exp-on ? #ff9f4322 : (hx-ta.has-hover ? #ffffff12 : #14161d);
                            border-width: 1px; border-color: root.active-exp-on ? #ff9f43 : #262a35;
                            hx-l := HorizontalLayout { padding-left: 10px; padding-right: 10px;
                                Text { text: root.narrow
                                           ? (root.active-exp-on ? "⚠ visibles" : "⚠ \{root.active-exp-hidden} ocultos")
                                           : (root.active-exp-on ? "⚠ Experimentales visibles" : (root.active-exp-hidden == 1 ? "⚠ 1 experimental oculto" : "⚠ \{root.active-exp-hidden} experimentales ocultos"));
                                       color: root.active-exp-on ? #ff9f43 : #ffffffaa; font-size: 11px; font-weight: 700; vertical-alignment: center; } }
                            hx-ta := TouchArea { mouse-cursor: pointer; clicked => { root.toggle-experimental-system(root.active-system, !root.active-exp-on); } }
                        }
                        if root.library-tab && (root.updates-pending > 0 || root.bulk-busy): Btn {
                            y: (parent.height - 30px) / 2; height: 30px; horizontal-stretch: 0;
                            kind: root.bulk-busy ? "secondary" : "primary";
                            label: root.bulk-busy ? "Actualizando…"
                                 : (root.narrow ? "↑ \{root.updates-pending}"
                                    : (root.updates-pending == 1 ? "↑ Actualizar 1 juego" : "↑ Actualizar \{root.updates-pending} juegos"));
                            clicked => { if (!root.bulk-busy) { root.update-all(); } }
                        }
                        Rectangle {
                            width: root.narrow ? 140px : 200px; height: 32px; y: (parent.height - 32px) / 2;
                            LineEdit { width: 100%; height: 100%; placeholder-text: "Buscar juego…"; font-size: 12px;
                                       text <=> root.search-text; edited => { root.refresh(); } }
                        }
                    }
                }
                if root.bulk-busy: Rectangle {
                    height: 30px;
                    HorizontalLayout {
                        padding-left: root.grid-pad; padding-right: root.grid-pad; spacing: 10px;
                        VerticalLayout { alignment: center; horizontal-stretch: 1; Bar { value: root.bulk-progress; } }
                        Text { text: root.bulk-label; color: #ffffff99; font-size: 11px; overflow: elide; vertical-alignment: center; width: 320px; }
                        Btn { label: "Cancelar"; kind: "ghost"; height: 24px; y: 3px; clicked => { root.cancel-update-all(); } }
                    }
                }
                if !root.bulk-busy && root.bulk-label != "": Rectangle {
                    height: 24px;
                    Text { x: root.grid-pad; width: parent.width - 2 * root.grid-pad; height: 100%; text: root.bulk-label; color: #ffd166; font-size: 11px; overflow: elide; vertical-alignment: center; }
                }
                Rectangle { height: 1px; background: #1f232d; }

                // "Nuevas incorporaciones": what landed in the catalog this week.
                if !root.library-tab && root.active-system == "" && root.search-text == "" && root.newcomers.length > 0: Rectangle {
                    height: 150px;
                    background: #0e1016;
                    VerticalLayout {
                        padding-left: root.grid-pad; padding-right: root.grid-pad; padding-top: 12px; padding-bottom: 12px;
                        spacing: 10px;
                        SectionHeader { label: "Nuevas incorporaciones"; accent: #7de17d; }
                        ScrollView {
                            height: 90px;
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                for c in root.newcomers: Rectangle {
                                    width: 262px;
                                    height: 86px;
                                    border-radius: 10px;
                                    clip: true;
                                    background: nc-ta.has-hover ? #1c1f28 : #14161d;
                                    border-width: 1px;
                                    border-color: nc-ta.has-hover ? #7de17d88 : #262a35;
                                    animate border-color, background { duration: 150ms; easing: ease-out; }
                                    nc-ta := TouchArea { mouse-cursor: pointer; clicked => { root.open-game(c.id); } }
                                    HorizontalLayout {
                                        padding: 9px;
                                        spacing: 10px;
                                        Rectangle {
                                            width: 50px; border-radius: 5px; clip: true;
                                            Cover { width: 100%; height: 100%; source: c.cover; title: c.title; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 3px;
                                            horizontal-stretch: 1;
                                            Text { text: c.title; color: white; font-size: 12px; font-weight: 700; overflow: elide; }
                                            Text { text: c.is-windows ? "\{c.meta} · Windows" : c.meta; color: #ffffff77; font-size: 11px; overflow: elide; }
                                            HorizontalLayout {
                                                spacing: 4px;
                                                alignment: start;
                                                if c.installed: Tag { label: "INSTALADO"; tint: #4de1c1; }
                                                if !c.installed: Tag { label: "NUEVO"; tint: #7de17d; }
                                                if c.experimental: Tag { label: "⚠ EXPERIMENTAL"; tint: #ff9f43; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: #1f232d; }
                }
                if !root.library-tab && root.active-system == "" && root.search-text == "" && root.newcomers.length > 0: VerticalLayout {
                    padding-left: root.grid-pad; padding-right: root.grid-pad; padding-top: 14px; padding-bottom: 2px;
                    SectionHeader { label: "Todo el catálogo"; }
                }
                // "Seguir jugando": last-played shelf (library).
                if root.library-tab && root.active-system == "" && root.search-text == "" && root.recent.length > 0: Rectangle {
                    height: 142px;
                    background: #0e1016;
                    VerticalLayout {
                        padding-left: root.grid-pad; padding-right: root.grid-pad; padding-top: 12px; padding-bottom: 12px;
                        spacing: 10px;
                        SectionHeader { label: "Seguir jugando"; }
                        // ScrollView: the strip never dictates the column's minimum width.
                        ScrollView {
                            height: 90px;
                            HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            for c in root.recent: Rectangle {
                                width: 290px;
                                height: 86px;
                                border-radius: 10px;
                                clip: true;
                                background: rc-ta.has-hover ? #1c1f28 : #14161d;
                                border-width: 1px;
                                border-color: rc-ta.has-hover ? #ffb23e88 : #262a35;
                                animate border-color, background { duration: 150ms; easing: ease-out; }
                                rc-ta := TouchArea { mouse-cursor: pointer; clicked => { root.open-game(c.id); } }
                                HorizontalLayout {
                                    padding: 9px;
                                    spacing: 10px;
                                    Rectangle {
                                        width: 50px; border-radius: 5px; clip: true;
                                        Cover { width: 100%; height: 100%; source: c.cover; title: c.title; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 3px;
                                        horizontal-stretch: 1;
                                        Text { text: c.title; color: white; font-size: 12px; font-weight: 700; overflow: elide; }
                                        Text { text: c.meta; color: #ffffff77; font-size: 11px; overflow: elide; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 38px; height: 38px; border-radius: 19px;
                                            background: rp-ta.has-hover ? #ffb23e : #ffb23e22;
                                            animate background { duration: 120ms; }
                                            Text { text: "▶"; color: rp-ta.has-hover ? #0b0c10 : #ffb23e; font-size: 14px; font-weight: 900;
                                                   horizontal-alignment: center; vertical-alignment: center; }
                                            rp-ta := TouchArea { mouse-cursor: pointer; clicked => { root.play(c.id); } }
                                        }
                                    }
                                }
                            }
                            }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: #1f232d; }
                }
                if root.library-tab && root.active-system == "" && root.search-text == "" && root.recent.length > 0: VerticalLayout {
                    padding-left: root.grid-pad; padding-right: root.grid-pad; padding-top: 14px; padding-bottom: 2px;
                    SectionHeader { label: "Toda la biblioteca"; }
                }

                // ── Grid: shelves of boxes, one height per row ──
                Rectangle {
                    vertical-stretch: 1;
                    ListView {
                        for row in root.rows: VerticalLayout {
                            if row.header != "": HorizontalLayout {
                                padding-left: root.grid-pad; padding-right: root.grid-pad; padding-top: 18px; padding-bottom: 6px;
                                SectionHeader { label: row.header; accent: #ff9f43; }
                            }
                            if row.cards.length > 0: HorizontalLayout {
                                spacing: 14px;
                                padding-left: root.grid-pad; padding-right: root.grid-pad; padding-top: 10px; padding-bottom: 10px;
                                alignment: start;
                                // Plain rectangles with absolute geometry: no nested layouts
                                // per card, so rows instantiate fast while scrolling.
                                for c in row.cards: Rectangle {
                                    property <length> slot-w: c.card-w > 0 ? c.card-w * 1px : root.card-h * 0.7;
                                    property <bool> hov: cover-ta.has-hover || act-btn.hovered || fav-ta.has-hover || cancel-ta.has-hover;
                                    width: self.slot-w;
                                    height: root.card-h + 44px;
                                    cover := Rectangle {
                                        x: 0; y: 0; width: parent.width; height: root.card-h;
                                        border-radius: 8px;
                                        background: #14161d;
                                        clip: true;
                                        border-width: c.installed ? 2px : 1px;
                                        border-color: hov ? (c.installed ? #4de1c1 : #ffb23e) : (c.installed ? #4de1c1aa : #262a35);
                                        drop-shadow-blur: hov ? 18px : 0px;
                                        drop-shadow-color: hov ? #000000cc : #00000000;
                                        animate border-color, drop-shadow-blur, drop-shadow-color { duration: 180ms; easing: ease-out; }
                                        Cover { width: 100%; height: 100%; source: c.cover; title: c.title; hovered: hov; }
                                        cover-ta := TouchArea { mouse-cursor: pointer; clicked => { root.open-game(c.id); } }
                                        // Chips on the art: only what matters at a glance.
                                        if c.experimental: Tag { x: 6px; y: 6px; label: "⚠"; tint: #ff9f43; solid: true; }
                                        if c.update-available && !c.busy: Tag { x: 6px; y: c.experimental ? 28px : 6px;
                                            label: c.new-version != "" ? "↑ \{c.new-version}" : "↑"; tint: #ffd166; solid: true; }
                                        // Hover: primary action on a dark gradient at the bottom.
                                        Rectangle {
                                            visible: hov && !c.busy;
                                            y: parent.height - 52px; height: 52px; width: parent.width;
                                            background: @linear-gradient(180deg, #0b0c1000 0%, #0b0c10dd 55%, #0b0c10f2 100%);
                                        }
                                        act-btn := Btn {
                                            visible: hov && !c.busy;
                                            x: 8px; y: parent.height - 36px; width: parent.width - 16px;
                                            label: c.installed
                                                ? (c.play-state == 1 ? "Jugando…" : (c.play-state == 2 ? "⚠ Reintentar" : "▶  Jugar"))
                                                : (c.install-error ? "⚠ Reintentar" : "↓  Instalar");
                                            kind: (c.play-state == 2 || c.install-error) ? "danger" : "primary";
                                            clicked => { if (c.installed) { if (c.play-state != 1) { root.play(c.id); } } else { root.install(c.id); } }
                                        }
                                        // Busy: progress at the bottom, cancel at the right.
                                        Rectangle {
                                            visible: c.busy;
                                            y: parent.height - 44px; height: 44px; width: parent.width;
                                            background: @linear-gradient(180deg, #0b0c1000 0%, #0b0c10ee 60%);
                                            Text { x: 8px; y: 6px; width: parent.width - 40px; height: 16px;
                                                   text: c.installed
                                                       ? (c.progress > 0 ? "Actualizando \{floor(c.progress * 100)}%" : "Actualizando…")
                                                       : (c.progress > 0 ? "Instalando \{floor(c.progress * 100)}%" : "Instalando…");
                                                   color: #ffb23e; font-size: 11px; font-weight: 700; overflow: elide; }
                                            Bar { x: 8px; y: 28px; width: parent.width - 40px; value: c.progress > 0 ? c.progress : -1; }
                                            Rectangle { x: parent.width - 28px; y: 12px; width: 22px; height: 22px; border-radius: 11px;
                                                background: cancel-ta.has-hover ? #ff5d7333 : #00000000;
                                                Text { text: "✕"; color: #ff5d73; font-size: 11px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
                                                cancel-ta := TouchArea { enabled: c.busy; mouse-cursor: pointer; clicked => { root.cancel-install(c.id); } } }
                                        }
                                        // Favorite star (top-right)
                                        Rectangle {
                                            x: parent.width - 28px; y: 6px; width: 22px; height: 22px;
                                            border-radius: 11px;
                                            background: fav-ta.has-hover ? #000000dd : #00000099;
                                            visible: c.favorite || hov;
                                            Text { text: c.favorite ? "★" : "☆"; color: c.favorite ? #ffd166 : white;
                                                   font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                                            fav-ta := TouchArea { enabled: parent.visible; mouse-cursor: pointer; clicked => { root.toggle-favorite(c.id); } }
                                        }
                                    }
                                    Text { x: 0; y: cover.height + 8px; width: parent.width; height: 16px;
                                           text: c.title; color: white; font-size: 12px; font-weight: 700; overflow: elide; }
                                    Text { x: 0; y: cover.height + 25px; width: parent.width; height: 14px;
                                           text: c.busy ? "" : (c.installed
                                                     ? (c.needs-rom && !c.rom-ok ? "Falta la ROM" : (c.version != "" ? "Instalado · \{c.version}" : "Instalado"))
                                                     : (c.is-windows ? "\{c.subtitle} · Windows" : c.subtitle));
                                           color: c.installed ? (c.needs-rom && !c.rom-ok ? #ffd166 : #4de1c1aa) : #ffffff66;
                                           font-size: 10px; overflow: elide; }
                                }
                            }
                        }
                    }
                    if root.header-count == 0: Rectangle {
                        width: 100%; height: 100%;
                        VerticalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text { text: root.library-tab ? "Tu biblioteca está vacía"
                                         : (root.search-text != "" ? "Sin resultados para «\{root.search-text}»" : "Nada por aquí");
                                   color: #ffffffcc; font-size: 18px; font-weight: 800; horizontal-alignment: center; }
                            Text { text: root.library-tab ? "Instala un juego desde el catálogo"
                                         : "Prueba otra búsqueda o cambia de consola";
                                   color: #ffffff77; font-size: 13px; horizontal-alignment: center; }
                        }
                    }
                }
            }
        }
    }

    // ── Notice bar (window level, bottom) ──
    if root.notice != "": Rectangle {
        x: root.side-w + (root.width - root.side-w - self.width) / 2; y: root.height - 56px; height: 40px;
        width: min(root.width - root.side-w - 40px, nt-l.preferred-width);
        border-radius: 9px; background: #1c1f28; border-width: 1px; border-color: #343947;
        drop-shadow-blur: 18px; drop-shadow-color: #000000aa;
        nt-l := HorizontalLayout { padding-left: 14px; padding-right: 6px; spacing: 8px;
            Text { text: root.notice; color: white; font-size: 12px; vertical-alignment: center; overflow: elide; }
            Btn { label: "✕"; kind: "ghost"; clicked => { root.notice = ""; } } }
    }

    // ── 3D box viewer (experimental) ─────────────────────
    Rectangle {
        visible: root.viewer3d-visible;
        width: 100%; height: 100%;
        background: #0b0c10ee;
        TouchArea { clicked => { root.close-viewer3d(); } }
        VerticalLayout {
            padding: 20px; spacing: 12px;
            HorizontalLayout {
                Btn { label: "← Cerrar"; kind: "secondary"; clicked => { root.close-viewer3d(); } }
                Rectangle { horizontal-stretch: 1; }
                Text { text: "Arrastra para girar la caja"; color: #ffffff66; font-size: 12px; vertical-alignment: center; }
            }
            v3-area := Rectangle {
                vertical-stretch: 1;
                v3-ta := TouchArea {
                    property <length> lx; property <length> ly;
                    mouse-cursor: grab;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) { self.lx = self.mouse-x; self.ly = self.mouse-y; }
                        if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { root.viewer3d-release(); }
                    }
                    moved => {
                        if (self.pressed) {
                            root.viewer3d-drag(self.mouse-x - self.lx, self.mouse-y - self.ly);
                            self.lx = self.mouse-x; self.ly = self.mouse-y;
                        }
                    }
                }
            }
            Text { text: root.viewer3d-title; color: white; font-size: 26px; font-weight: 900; horizontal-alignment: center; }
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 260px; height: 52px; border-radius: 26px;
                    background: v3-play.has-hover ? #ffc766 : #ffb23e;
                    drop-shadow-blur: 24px; drop-shadow-color: #ffb23e66;
                    animate background { duration: 120ms; }
                    Text { text: root.viewer3d-installed ? "▶  JUGAR" : "↓  INSTALAR"; color: #0b0c10; font-size: 18px; font-weight: 900;
                           horizontal-alignment: center; vertical-alignment: center; letter-spacing: 1px; }
                    v3-play := TouchArea { mouse-cursor: pointer;
                        clicked => { if (root.viewer3d-installed) { root.play(root.viewer3d-id); } else { root.install(root.viewer3d-id); } root.close-viewer3d(); } }
                }
            }
            Rectangle { height: 8px; }
        }
    }

    // ── Modo TV / Big Picture ────────────────────────────
    if root.tv-visible: FocusScope {
        width: 100%;
        height: 100%;
        opacity: 0;
        init => { self.focus(); self.opacity = 1; }
        animate opacity { duration: 220ms; easing: ease-out; }
        key-pressed(e) => {
            if (e.text == Key.UpArrow) { root.tv-input("up"); return EventResult.accept; }
            if (e.text == Key.DownArrow) { root.tv-input("down"); return EventResult.accept; }
            if (e.text == Key.LeftArrow) { root.tv-input("left"); return EventResult.accept; }
            if (e.text == Key.RightArrow) { root.tv-input("right"); return EventResult.accept; }
            if (e.text == Key.Return) { root.tv-input("a"); return EventResult.accept; }
            if (e.text == Key.Escape) { root.tv-input("start"); return EventResult.accept; }
            return EventResult.reject;
        }
        Rectangle {
            background: #07080c;
            VerticalLayout {
                // Hero
                Rectangle {
                    height: 300px;
                    clip: true;
                    Image { source: root.tv-hero-cover; width: 100%; height: 100%; image-fit: cover; }
                    Rectangle { background: @linear-gradient(180deg, #07080c00 0%, #07080cee 100%); }
                    VerticalLayout {
                        padding: 28px;
                        alignment: end;
                        Text { text: root.tv-hero-title; color: white; font-size: 40px; font-weight: 900; }
                        Text { text: root.tv-hero-subtitle; color: #ffb23e; font-size: 18px; }
                    }
                }
                if root.tv-shelf-count == 0: Rectangle {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: center; spacing: 6px;
                        Text { text: "No hay juegos instalados"; color: white; font-size: 22px; font-weight: 800; horizontal-alignment: center; }
                        Text { text: "Instala juegos desde el catálogo y aparecerán aquí"; color: #ffffff88; font-size: 14px; horizontal-alignment: center; }
                    }
                }
                // Shelves (viewport follows focus on both axes)
                Flickable {
                    interactive: false;
                    vertical-stretch: 1;
                    viewport-height: root.tv-shelf-count * 279px;
                    viewport-y: -root.tv-shelf * 279px;
                    animate viewport-y { duration: 280ms; easing: ease-in-out; }
                    VerticalLayout {
                        for shelf[si] in root.tv-shelves: VerticalLayout {
                            height: 279px;
                            padding-left: 24px;
                            spacing: 6px;
                            Text { text: shelf.name; color: white; font-weight: 800; font-size: 16px;
                                   opacity: si == root.tv-shelf ? 1.0 : 0.55;
                                   animate opacity { duration: 220ms; } }
                            Flickable {
                                interactive: false;
                                height: 241px;
                                viewport-width: shelf.count * (shelf.card-w * 1px + 12px);
                                viewport-x: si == root.tv-shelf ? -root.tv-col * (shelf.card-w * 1px + 12px) : 0px;
                                animate viewport-x { duration: 240ms; easing: ease-out; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    for game[col] in shelf.games: Rectangle {
                                        property <bool> focused: si == root.tv-shelf && col == root.tv-col;
                                        width: shelf.card-w * 1px;
                                        height: 237px;
                                        border-radius: 10px;
                                        clip: true;
                                        background: #1c1f28;
                                        border-width: 3px;
                                        border-color: focused ? #ffb23e : #00000000;
                                        drop-shadow-blur: focused ? 26px : 0px;
                                        drop-shadow-color: focused ? #ffb23eaa : #00000000;
                                        animate border-color, drop-shadow-blur, drop-shadow-color { duration: 200ms; easing: ease-out; }
                                        Cover { width: 100%; height: 100%; source: game.cover; title: game.title; hovered: focused; }
                                        if game.experimental: Tag { x: 8px; y: 8px; label: "⚠ EXPERIMENTAL"; tint: #ff9f43; solid: true; }
                                        if game.update-available: Tag { x: parent.width - self.width - 8px; y: 8px;
                                            label: game.new-version != "" ? "↑ \{game.new-version}" : "↑"; tint: #ffd166; solid: true; }
                                    }
                                }
                            }
                        }
                    }
                }
                // Hint bar
                Rectangle {
                    height: 42px;
                    background: #14161d;
                    HorizontalLayout {
                        padding-left: 24px;
                        spacing: 24px;
                        Text { text: "✚ Mover"; color: #ffffff88; vertical-alignment: center; }
                        Text { text: "A  Jugar"; color: #ffb23e; vertical-alignment: center; }
                        Text { text: "Y  Actualizar"; color: #ffd166; vertical-alignment: center; }
                        Text { text: "LB / RB  Consola"; color: #ffffff88; vertical-alignment: center; }
                        Text { text: "B / ☰ / Esc  Salir"; color: #ffffff88; vertical-alignment: center; }
                    }
                }
            }
        }
    }

    // ── Confirm uninstall ────────────────────────────────
    if root.confirm-visible: Rectangle {
        width: 100%; height: 100%;
        background: #000000cc;
        opacity: 0;
        init => { self.opacity = 1; }
        animate opacity { duration: 140ms; easing: ease-out; }
        TouchArea { clicked => { root.confirm-visible = false; } }
        Rectangle {
            width: 400px; height: 180px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 12px; background: #14161d;
            border-width: 1px; border-color: #343947;
            drop-shadow-blur: 40px; drop-shadow-color: #00000099;
            TouchArea { }
            VerticalLayout {
                padding: 22px; spacing: 10px;
                Text { text: "¿Eliminar «\{root.confirm-title}»?"; color: white; font-size: 17px; font-weight: 800; wrap: word-wrap; }
                Text { text: "Se borrará la instalación y sus mods. No se puede deshacer."; color: #ffffffaa; font-size: 12px; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end; spacing: 8px;
                    Btn { label: "Cancelar"; kind: "secondary"; clicked => { root.confirm-visible = false; } }
                    Btn { label: "Eliminar"; bg: #e04b5a; fg: white; clicked => { root.uninstall(root.confirm-id); root.confirm-visible = false; } }
                }
            }
        }
    }

    // ── Version chooser ──────────────────────────────────
    if root.chooser-visible: Rectangle {
        width: 100%; height: 100%;
        background: #000000cc;
        opacity: 0;
        init => { self.opacity = 1; }
        animate opacity { duration: 140ms; easing: ease-out; }
        TouchArea { clicked => { root.chooser-visible = false; } }
        Rectangle {
            width: 460px;
            height: ch-l.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 12px; background: #14161d;
            border-width: 1px; border-color: #343947;
            drop-shadow-blur: 40px; drop-shadow-color: #00000099;
            TouchArea { }
            ch-l := VerticalLayout {
                padding: 22px; spacing: 10px;
                Text { text: root.chooser-title; color: white; font-size: 17px; font-weight: 800; wrap: word-wrap; }
                Text { text: root.chooser-mode == "install" ? "Este juego tiene varios ports. ¿Cuál quieres instalar?"
                           : (root.chooser-mode == "play" ? "Tienes varias versiones instaladas. ¿Cuál quieres jugar?"
                              : (root.chooser-mode == "romm" ? "Resultados en tu RomM. ¿Cuál quieres traer?"
                                 : "Tienes varias versiones instaladas. ¿Cuál quieres eliminar?"));
                       color: #ffffffaa; font-size: 12px; wrap: word-wrap; }
                for v in root.chooser-items: Rectangle {
                    height: 54px;
                    border-radius: 9px;
                    background: ch-ta.has-hover ? #ffffff12 : #1c1f28;
                    border-width: 1px; border-color: ch-ta.has-hover ? #ffb23e : #262a35;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 10px;
                        VerticalLayout {
                            alignment: center; spacing: 2px; horizontal-stretch: 1;
                            Text { text: v.name; color: white; font-size: 13px; font-weight: 800; overflow: elide; }
                            Text { text: (v.kind == "RECOMP" ? "Recomp" : (v.kind == "PORT" ? "Port" : v.kind))
                                         + (v.platforms != "" ? " · " + v.platforms : "")
                                         + (v.is-windows ? " · Wine/Proton" : "")
                                         + (v.meta != "" ? " · " + v.meta : "");
                                   color: #ffffff88; font-size: 10px; overflow: elide; }
                        }
                        if v.installed: Text { text: "✓ instalado"; color: #4de1c1; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                    }
                    ch-ta := TouchArea { mouse-cursor: pointer; clicked => { root.chooser-visible = false; root.choose-version(v.id, root.chooser-remember); } }
                }
                if root.chooser-mode == "play": HorizontalLayout {
                    spacing: 10px;
                    Toggle { checked <=> root.chooser-remember; }
                    Text { text: "Recordar para la próxima vez (se cambia en la ficha del juego)"; color: #ffffffaa; font-size: 12px; vertical-alignment: center; wrap: word-wrap; }
                }
                HorizontalLayout {
                    alignment: end;
                    Btn { label: "Cancelar"; kind: "secondary"; clicked => { root.chooser-visible = false; } }
                }
            }
        }
    }

    // ── Screenshot viewer (lightbox) ─────────────────────
    if root.viewer-visible: Rectangle {
        width: 100%; height: 100%;
        background: #000000ee;
        opacity: 0;
        init => { self.opacity = 1; }
        animate opacity { duration: 140ms; easing: ease-out; }
        TouchArea { clicked => { root.viewer-visible = false; } }
        Image {
            source: root.viewer-image;
            width: parent.width * 0.92; height: parent.height * 0.9;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            image-fit: contain;
        }
        Text { y: parent.height - 34px; width: parent.width; text: "Clic para cerrar";
               color: #ffffff88; font-size: 12px; horizontal-alignment: center; }
    }

    // ── Retro CRT effect (scanlines + vignette), purely visual ───────────
    if root.crt-visible: Rectangle {
        width: 100%; height: 100%;
        Image {
            source: @image-url("../assets/crt-scanlines.png");
            width: 100%; height: 100%;
            vertical-tiling: repeat;
            horizontal-tiling: repeat;
            image-rendering: pixelated;
            opacity: 0.7;
        }
        Rectangle { background: @radial-gradient(circle, #00000000 48%, #000000b0 120%); }
    }
}
