import { ListView, LineEdit, ScrollView, CheckBox, ComboBox } from "std-widgets.slint";

struct CardItem {
    id: string,
    title: string,
    subtitle: string,
    cover: image,
    installed: bool,
    is-windows: bool,
    update-available: bool,
    needs-rom: bool,
    rom-ok: bool,
    busy: bool,
    progress: float,
    kind: string,
    sys-color: color,
}

component Btn inherits Rectangle {
    in property <string> label;
    in property <color> fg: #0b0c10;
    in property <color> bg: #ffb23e;
    callback clicked;
    height: 26px;
    border-radius: 6px;
    background: touch.pressed ? bg.darker(20%) : (touch.has-hover ? bg.brighter(18%) : bg);
    animate background { duration: 120ms; easing: ease-out; }
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px;
        Text { text: root.label; color: root.fg; font-size: 12px; font-weight: 700;
               horizontal-alignment: center; vertical-alignment: center; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Thin progress bar. `value` in 0.0..1.0; when < 0 shows an indeterminate sweep.
component Bar inherits Rectangle {
    in property <float> value;
    in property <color> fill: #ffb23e;
    height: 6px;
    border-radius: 3px;
    background: #00000066;
    clip: true;
    property <float> sweep;
    animate sweep { duration: 1100ms; iteration-count: -1; easing: ease-in-out; }
    init => { self.sweep = 1.0; }
    Rectangle {
        x: root.value >= 0 ? 0px : (parent.width * 0.6) * root.sweep;
        width: root.value >= 0 ? parent.width * clamp(root.value, 0.0, 1.0) : parent.width * 0.4;
        height: parent.height;
        border-radius: 3px;
        background: root.fill;
        animate width { duration: 180ms; easing: ease-out; }
    }
}

struct SysRow {
    id: string,
    name: string,
    count: int,
    color: color,
    logo: image,
    has-logo: bool,
}

// Window control button (minimize / maximize / close).
component WinBtn inherits Rectangle {
    in property <string> symbol;
    in property <color> hover-bg: #ffffff26;
    callback clicked;
    width: 40px;
    height: 28px;
    border-radius: 6px;
    background: ta.has-hover ? root.hover-bg : #00000000;
    animate background { duration: 120ms; easing: ease-out; }
    Text { text: root.symbol; color: white; font-size: 14px;
           horizontal-alignment: center; vertical-alignment: center; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

struct ChipData {
    text: string,
    color: color,
}

struct ScreenShot {
    img: image,
    path: string,
}

struct TvShelf {
    name: string,
    count: int,
    games: [CardItem],
}

struct ModRow {
    full-name: string,
    name: string,
    owner: string,
    downloads: string,
    description: string,
    icon: image,
    has-icon: bool,
    installed: bool,
    update: bool,
    busy: bool,
    progress: float,
    phase: string,
}

struct DetailData {
    id: string,
    title: string,
    subtitle: string,
    cover: image,
    installed: bool,
    is-windows: bool,
    update-available: bool,
    needs-rom: bool,
    rom-ok: bool,
    busy: bool,
    progress: float,
    about: string,
    port-notes: string,
    has-related: bool,
    has-mods: bool,
    has-screens: bool,
    chips: [ChipData],
    related: [CardItem],
    mods: [ModRow],
    screens: [ScreenShot],
}

component Tag inherits Rectangle {
    in property <string> label;
    in property <color> fg: white;
    in property <color> bg: #000000aa;
    border-radius: 4px;
    background: bg;
    height: 16px;
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        Text { text: root.label; color: root.fg; font-size: 9px; font-weight: 800; vertical-alignment: center; }
    }
}

export component MainWindow inherits Window {
    in property <[SysRow]> systems;
    in property <[[CardItem]]> rows;
    in property <string> header-title;
    in property <int> header-count;
    in-out property <string> active-system;
    in-out property <bool> library-tab;
    in-out property <string> search-text;
    callback refresh();
    callback open-game(string);
    callback install(string);
    callback play(string);
    callback uninstall(string);
    callback pick-rom(string);
    callback close-detail();
    callback install-mod(string, string);
    callback uninstall-mod(string, string);
    callback open-screenshot(string);
    in property <DetailData> detail;
    in property <bool> detail-visible;
    // Shared-element transition: origin rect of the clicked cover (window coords).
    in-out property <length> anim-from-x;
    in-out property <length> anim-from-y;
    in-out property <length> anim-from-w;
    in-out property <length> anim-from-h;
    // Settings
    in-out property <bool> settings-visible;
    in-out property <bool> show-windows;
    in-out property <string> current-runner-label;
    in property <string> version;
    in property <string> platform-label;
    in property <[string]> runner-labels;
    in property <string> settings-msg;
    callback toggle-windows(bool);
    callback set-runner(string);
    callback refresh-catalog();
    callback open-tv();
    // TV / Big Picture
    in property <[TvShelf]> tv-shelves;
    in property <int> tv-shelf-count;
    in property <bool> tv-visible;
    in-out property <int> tv-shelf;
    in-out property <int> tv-col;
    in property <image> tv-hero-cover;
    in property <string> tv-hero-title;
    in property <string> tv-hero-subtitle;
    callback tv-input(string);
    // Self-update
    in property <bool> update-available;
    in property <string> update-version;
    in-out property <bool> update-busy;
    callback do-update();
    callback dismiss-update();
    // Frameless window controls
    callback win-minimize();
    callback win-maximize();
    callback win-close();
    callback title-press();
    callback resize-press(string);

    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 900px;
    min-height: 600px;
    title: "Freeport";
    no-frame: true;
    background: #0b0c10;
    default-font-size: 14px;

    // Responsive column count for the cover grid. Card slot ≈ 158px + 14px gap;
    // main area = window width minus the 244px sidebar and grid padding.
    out property <int> cols: max(1, floor((root.width - 244px - 24px) / 172px));
    changed cols => { root.refresh(); }

    VerticalLayout {
    // ── Custom titlebar (frameless) ─────────────
    Rectangle {
        height: 40px;
        background: #101219;
        // Drag region (behind the buttons; brand/spacer let events fall through).
        // Drag starts on the first move after a press so a plain double-click can
        // still reach `double-clicked` (maximize) instead of grabbing a move.
        drag-ta := TouchArea {
            mouse-cursor: default;
            property <bool> drag-started;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    self.drag-started = false;
                }
            }
            moved => {
                if (self.pressed && !self.drag-started) {
                    self.drag-started = true;
                    root.title-press();
                }
            }
            double-clicked => { root.win-maximize(); }
        }
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 6px;
            spacing: 6px;
            Text { text: "⚓ FREEPORT"; color: #ffb23e; font-weight: 900; font-size: 15px;
                   vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            WinBtn { symbol: "–"; clicked => { root.win-minimize(); } }
            WinBtn { symbol: "▢"; clicked => { root.win-maximize(); } }
            WinBtn { symbol: "✕"; hover-bg: #e04b5a; clicked => { root.win-close(); } }
        }
    }
    // ── Content area (holds base view + modal overlays) ─────────────
    Rectangle {
        vertical-stretch: 1;
    HorizontalLayout {
        // ── Sidebar ─────────────────────────────
        Rectangle {
            width: 244px;
            background: #14161d;
            VerticalLayout {
                padding: 12px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 6px;
                    Rectangle {
                        height: 30px;
                        border-radius: 8px;
                        background: root.library-tab ? #1c1f28 : #ffb23e;
                        animate background { duration: 160ms; easing: ease-out; }
                        Text { text: "Catálogo"; font-weight: 700; horizontal-alignment: center; vertical-alignment: center;
                               color: root.library-tab ? white : #0b0c10;
                               animate color { duration: 160ms; } }
                        TouchArea { mouse-cursor: pointer; clicked => { root.library-tab = false; root.active-system = ""; root.refresh(); } }
                    }
                    Rectangle {
                        height: 30px;
                        border-radius: 8px;
                        background: root.library-tab ? #ffb23e : #1c1f28;
                        animate background { duration: 160ms; easing: ease-out; }
                        Text { text: "Biblioteca"; font-weight: 700; horizontal-alignment: center; vertical-alignment: center;
                               color: root.library-tab ? #0b0c10 : white;
                               animate color { duration: 160ms; } }
                        TouchArea { mouse-cursor: pointer; clicked => { root.library-tab = true; root.active-system = ""; root.refresh(); } }
                    }
                }

                LineEdit {
                    placeholder-text: "Buscar juego…";
                    text <=> root.search-text;
                    edited => { root.refresh(); }
                }

                Rectangle {
                    height: 42px;
                    border-radius: 8px;
                    background: root.active-system == "" ? #ffb23e26 : (all-touch.has-hover ? #ffffff0f : #00000000);
                    animate background { duration: 130ms; easing: ease-out; }
                    all-touch := TouchArea { mouse-cursor: pointer; clicked => { root.active-system = ""; root.refresh(); } }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 10px;
                        spacing: 8px;
                        Rectangle { width: 4px; border-radius: 2px;
                                    background: root.active-system == "" ? #ffb23e : #00000000;
                                    animate background { duration: 160ms; } }
                        Text { text: "Todos los juegos"; color: white; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                    }
                }
                ListView {
                    for s in root.systems: Rectangle {
                        height: 42px;
                        border-radius: 8px;
                        background: root.active-system == s.id ? #ffb23e26 : (row-touch.has-hover ? #ffffff0f : #00000000);
                        animate background { duration: 130ms; easing: ease-out; }
                        row-touch := TouchArea { mouse-cursor: pointer; clicked => { root.active-system = s.id; root.refresh(); } }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 10px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 8px;
                            Rectangle { width: 4px; border-radius: 2px;
                                        background: root.active-system == s.id ? s.color : #00000000;
                                        animate background { duration: 160ms; } }
                            if s.has-logo: VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                Image { source: s.logo; height: 22px;
                                        image-fit: contain; horizontal-alignment: left; }
                            }
                            if !s.has-logo: Text { text: s.name; color: white; vertical-alignment: center; horizontal-stretch: 1; }
                            Text { text: "\{s.count}"; color: #ffffff59; font-size: 12px; vertical-alignment: center; }
                        }
                    }
                }
                Rectangle {
                    height: 100px;
                    VerticalLayout {
                        padding: 6px;
                        spacing: 6px;
                        Btn { label: "📺 Modo TV"; bg: #ffb23e26; fg: #ffb23e; clicked => { root.open-tv(); } }
                        Btn { label: "⚙ Ajustes"; bg: #1c1f28; fg: white; clicked => { root.settings-visible = true; } }
                        Text { text: "Freeport \{root.version}"; color: #ffffff44; font-size: 10px; horizontal-alignment: center; }
                    }
                }
            }
        }

        // ── Main ────────────────────────────────
        VerticalLayout {
            if root.update-available: Rectangle {
                height: 44px;
                background: #ffb23e;
                opacity: 0;
                init => { self.opacity = 1; }
                animate opacity { duration: 260ms; easing: ease-out; }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 8px;
                    spacing: 12px;
                    Text {
                        text: root.update-busy ? "Actualizando…" : "Nueva versión v\{root.update-version} disponible";
                        color: #0b0c10;
                        font-weight: 800;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if !root.update-busy: Btn { label: "Actualizar"; bg: #0b0c10; fg: #ffb23e; clicked => { root.do-update(); } }
                    if !root.update-busy: Btn { label: "Después"; bg: #ffffff44; fg: #0b0c10; clicked => { root.dismiss-update(); } }
                }
            }
            Rectangle {
                height: 62px;
                HorizontalLayout {
                    padding-left: 22px;
                    padding-right: 22px;
                    spacing: 10px;
                    Text { text: root.header-title; color: white; font-size: 24px; font-weight: 900; vertical-alignment: center; }
                    Text { text: "\{root.header-count} juegos"; color: #ffffff66; font-size: 14px; vertical-alignment: center; }
                }
            }
            ListView {
                for row in root.rows: HorizontalLayout {
                    spacing: 14px;
                    padding: 8px;
                    alignment: start;
                    for c in row: Rectangle {
                        width: 158px;
                        height: 286px;
                        VerticalLayout {
                            spacing: 4px;
                            coverbox := Rectangle {
                                height: 196px;
                                border-radius: 10px;
                                background: #1c1f28;
                                clip: true;
                                border-width: 2px;
                                border-color: cover-ta.has-hover ? (c.installed ? #4de1c1 : #ffb23e)
                                                                 : (c.installed ? #4de1c1 : #2b2f3a);
                                drop-shadow-blur: cover-ta.has-hover ? 20px : 0px;
                                drop-shadow-color: cover-ta.has-hover ? (c.installed ? #4de1c1aa : #ffb23e99) : #00000000;
                                animate border-color, drop-shadow-blur, drop-shadow-color { duration: 200ms; easing: ease-out; }
                                Image {
                                    source: c.cover;
                                    width: cover-ta.has-hover ? parent.width * 1.09 : parent.width;
                                    height: cover-ta.has-hover ? parent.height * 1.09 : parent.height;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    image-fit: cover;
                                    animate width, height { duration: 220ms; easing: ease-out; }
                                }
                                Tag {
                                    x: 6px; y: 6px;
                                    label: c.kind;
                                    fg: c.kind == "RECOMP" ? #ffb23e : #4de1c1;
                                }
                                if c.is-windows: Tag {
                                    x: 6px; y: 26px;
                                    label: "WIN"; fg: white; bg: #2b6fb3;
                                }
                                if c.update-available: Tag {
                                    x: 6px; y: parent.height - 22px;
                                    label: "UPDATE"; fg: #ffd166; bg: #000000cc;
                                }
                                cover-ta := TouchArea { mouse-cursor: pointer; clicked => {
                                    root.anim-from-x = coverbox.absolute-position.x;
                                    root.anim-from-y = coverbox.absolute-position.y;
                                    root.anim-from-w = coverbox.width;
                                    root.anim-from-h = coverbox.height;
                                    root.open-game(c.id);
                                } }
                            }
                            Text { text: c.title; color: white; font-size: 12px; font-weight: 700; overflow: elide; }
                            Text { text: c.subtitle; color: #ffffff66; font-size: 10px; overflow: elide; }

                            // Action row
                            if c.busy: VerticalLayout {
                                height: 28px;
                                spacing: 4px;
                                Text { text: c.progress > 0 ? "Instalando \{floor(c.progress * 100)}%" : "Instalando…";
                                       color: #ffb23e; font-size: 11px; font-weight: 700;
                                       horizontal-alignment: center; }
                                Bar { value: c.progress > 0 ? c.progress : -1; }
                            }
                            if !c.busy && c.installed: HorizontalLayout {
                                height: 28px; spacing: 5px;
                                Btn { label: "▶ Jugar"; horizontal-stretch: 1; clicked => { root.play(c.id); } }
                                if c.needs-rom: Btn {
                                    label: c.rom-ok ? "ROM ✓" : "ROM";
                                    bg: #1c1f28; fg: c.rom-ok ? #4de1c1 : white;
                                    clicked => { root.pick-rom(c.id); }
                                }
                                Btn { label: "✕"; bg: #1c1f28; fg: #ff5d73; clicked => { root.uninstall(c.id); } }
                            }
                            if !c.busy && !c.installed: Btn {
                                label: "↓ Instalar"; bg: #1c1f28; fg: #ffb23e;
                                clicked => { root.install(c.id); }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Game detail overlay ──────────────────────────────
    if root.detail-visible: Rectangle {
        width: 100%;
        height: 100%;
        background: #0b0c10;
        opacity: 0;
        init => { self.opacity = 1; }
        animate opacity { duration: 170ms; easing: ease-out; }
        VerticalLayout {
            Rectangle {
                height: 46px;
                background: #14161d;
                HorizontalLayout {
                    padding: 8px;
                    alignment: start;
                    Btn { label: "← Volver"; bg: #1c1f28; fg: white; clicked => { root.close-detail(); } }
                }
            }
            dscroll := ScrollView {
                VerticalLayout {
                    // Explicit width = visible area so wrapping text (Acerca /
                    // Sobre este port) reflows instead of overflowing/overlapping.
                    width: dscroll.visible-width;
                    padding: 22px;
                    spacing: 18px;
                    HorizontalLayout {
                        spacing: 22px;
                        alignment: start;
                        Rectangle {
                            width: 180px; height: 240px; border-radius: 12px; background: #1c1f28; clip: true;
                            Image { source: root.detail.cover; width: 100%; height: 100%; image-fit: cover; }
                        }
                        VerticalLayout {
                            spacing: 10px;
                            Text { text: root.detail.title; font-size: 30px; font-weight: 900; color: white; wrap: word-wrap; }
                            Text { text: root.detail.subtitle; font-size: 16px; color: #ffb23e; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                for ch in root.detail.chips: Rectangle {
                                    border-radius: 12px; border-width: 1px; border-color: ch.color; background: #00000066; height: 24px;
                                    HorizontalLayout { padding-left: 9px; padding-right: 9px;
                                        Text { text: ch.text; color: white; font-size: 12px; vertical-alignment: center; } }
                                }
                            }
                            if root.detail.busy: VerticalLayout {
                                spacing: 5px;
                                width: 280px;
                                Text { text: root.detail.progress > 0 ? "Instalando \{floor(root.detail.progress * 100)}%" : "Instalando…";
                                       color: #ffb23e; font-weight: 700; }
                                Bar { value: root.detail.progress > 0 ? root.detail.progress : -1; height: 8px; }
                            }
                            if !root.detail.busy: HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                if root.detail.installed: Btn { label: "▶ Jugar"; clicked => { root.play(root.detail.id); } }
                                if root.detail.installed && root.detail.update-available: Btn { label: "↑ Actualizar"; bg: #1c1f28; fg: #ffd166; clicked => { root.install(root.detail.id); } }
                                if root.detail.installed && root.detail.needs-rom: Btn { label: root.detail.rom-ok ? "ROM ✓" : "Seleccionar ROM"; bg: #1c1f28; fg: root.detail.rom-ok ? #4de1c1 : white; clicked => { root.pick-rom(root.detail.id); } }
                                if root.detail.installed: Btn { label: "Eliminar"; bg: #1c1f28; fg: #ff5d73; clicked => { root.uninstall(root.detail.id); } }
                                if !root.detail.installed: Btn { label: "↓ Instalar"; clicked => { root.install(root.detail.id); } }
                            }
                        }
                    }
                    if root.detail.has-screens: ScrollView {
                        height: 152px;
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            for s in root.detail.screens: Rectangle {
                                width: 260px; height: 146px; border-radius: 8px; background: #1c1f28; clip: true;
                                Image { source: s.img; width: 100%; height: 100%; image-fit: cover; }
                                TouchArea { clicked => { root.open-screenshot(s.path); } }
                            }
                        }
                    }
                    if root.detail.about != "": VerticalLayout {
                        spacing: 6px;
                        Text { text: "Acerca del juego"; font-size: 18px; font-weight: 800; color: white; }
                        Text { text: root.detail.about; color: #ffffffcc; font-size: 14px; wrap: word-wrap;
                               width: dscroll.visible-width - 44px; }
                    }
                    if root.detail.port-notes != "": VerticalLayout {
                        spacing: 6px;
                        Text { text: "Sobre este port"; font-size: 18px; font-weight: 800; color: white; }
                        Text { text: root.detail.port-notes; color: #ffffffaa; font-size: 14px; wrap: word-wrap;
                               width: dscroll.visible-width - 44px; }
                    }
                    if root.detail.has-related: VerticalLayout {
                        spacing: 8px;
                        Text { text: "Relacionados"; font-size: 18px; font-weight: 800; color: white; }
                        ScrollView {
                            height: 184px;
                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                for r in root.detail.related: Rectangle {
                                    width: 110px; height: 172px;
                                    VerticalLayout {
                                        spacing: 4px;
                                        Rectangle { height: 146px; border-radius: 8px; background: #1c1f28; clip: true;
                                            Image { source: r.cover; width: 100%; height: 100%; image-fit: cover; }
                                            TouchArea { clicked => { root.open-game(r.id); } }
                                        }
                                        Text { text: r.title; color: white; font-size: 10px; overflow: elide; }
                                    }
                                }
                            }
                        }
                    }
                    if root.detail.has-mods: VerticalLayout {
                        spacing: 8px;
                        Text { text: "Mods"; font-size: 18px; font-weight: 800; color: white; }
                        for m in root.detail.mods: Rectangle {
                            height: 74px;
                            border-radius: 8px;
                            background: #14161d;
                            border-width: 1px;
                            border-color: m.installed ? #4de1c144 : #00000000;
                            HorizontalLayout {
                                padding: 10px;
                                spacing: 10px;
                                Rectangle {
                                    width: 54px; height: 54px; border-radius: 8px; background: #1c1f28; clip: true;
                                    if m.has-icon: Image { source: m.icon; width: 100%; height: 100%; image-fit: cover; }
                                    if !m.has-icon: Text { text: "🧩"; font-size: 24px;
                                                           horizontal-alignment: center; vertical-alignment: center; }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 3px;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        Text { text: m.name; color: white; font-weight: 700; font-size: 13px; overflow: elide; }
                                        if m.installed: Tag { label: "INSTALADO"; fg: #0b0c10; bg: #4de1c1; }
                                    }
                                    Text { text: "\{m.owner} · \{m.downloads} descargas"; color: #ffffff66; font-size: 11px; }
                                    if !m.busy: Text { text: m.description; color: #ffffff88; font-size: 11px; overflow: elide; }
                                    if m.busy: Bar { value: m.progress > 0 ? m.progress : -1; }
                                }
                                if m.busy: Text { text: m.phase == "extract" ? "Extrayendo…" : (m.progress > 0 ? "\{floor(m.progress * 100)}%" : "…");
                                                  color: #ffb23e; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                if !m.busy && m.update: Btn { label: "Actualizar"; bg: #1c1f28; fg: #ffd166; clicked => { root.install-mod(root.detail.id, m.full-name); } }
                                if !m.busy && m.installed && !m.update: Btn { label: "Quitar"; bg: #1c1f28; fg: #ff5d73; clicked => { root.uninstall-mod(root.detail.id, m.full-name); } }
                                if !m.busy && !m.installed: Btn { label: "Instalar"; clicked => { root.install-mod(root.detail.id, m.full-name); } }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Settings overlay ─────────────────────────────────
    if root.settings-visible: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000cc;
        opacity: 0;
        init => { self.opacity = 1; }
        animate opacity { duration: 160ms; easing: ease-out; }
        TouchArea { clicked => { root.settings-visible = false; } }
        card := Rectangle {
            property <length> enter: 14px;
            init => { self.enter = 0px; }
            width: 470px;
            height: 400px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 + self.enter;
            border-radius: 14px;
            background: #14161d;
            border-width: 1px;
            border-color: #2b2f3a;
            drop-shadow-blur: 40px;
            drop-shadow-color: #00000099;
            animate enter { duration: 220ms; easing: ease-out; }
            // Absorb clicks so they don't fall through to the backdrop (close).
            TouchArea { }
            VerticalLayout {
                padding: 20px;
                spacing: 14px;
                HorizontalLayout {
                    Text { text: "Ajustes"; font-size: 22px; font-weight: 900; color: white; horizontal-stretch: 1; }
                    Text { text: "Freeport \{root.version} · \{root.platform-label}"; color: #ffffff44; font-size: 12px; vertical-alignment: center; }
                }
                Rectangle {
                    border-radius: 8px;
                    background: #1c1f28;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 10px;
                            CheckBox { checked <=> root.show-windows; toggled => { root.toggle-windows(root.show-windows); } }
                            Text { text: "Mostrar juegos de Windows (Wine/Proton)"; color: white; vertical-alignment: center; horizontal-stretch: 1; }
                        }
                        if root.show-windows: ComboBox {
                            model: root.runner-labels;
                            current-value <=> root.current-runner-label;
                            selected(v) => { root.set-runner(v); }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Btn { label: "Actualizar catálogo"; clicked => { root.refresh-catalog(); } }
                    Text { text: root.settings-msg; color: #ffd166; font-size: 12px; vertical-alignment: center; }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    Btn { label: "Cerrar"; clicked => { root.settings-visible = false; } }
                }
            }
        }
    }
    } // ── end content area ───────────────────────
    } // ── end window column (titlebar + content) ─

    // ── Shared-element transition: cover flies grid → detail hero ──
    if root.detail-visible: Rectangle {
        property <float> p;
        init => { self.p = 1.0; }
        animate p { duration: 320ms; easing: ease-in-out; }
        visible: p < 0.99;
        x: root.anim-from-x + (22px - root.anim-from-x) * p;
        y: root.anim-from-y + (108px - root.anim-from-y) * p;
        width: root.anim-from-w + (180px - root.anim-from-w) * p;
        height: root.anim-from-h + (240px - root.anim-from-h) * p;
        border-radius: 10px + 2px * p;
        clip: true;
        drop-shadow-blur: 30px * (1.0 - p);
        drop-shadow-color: #000000aa;
        Image { source: root.detail.cover; width: 100%; height: 100%; image-fit: cover; }
    }

    // ── Modo TV / Big Picture ────────────────────────────
    if root.tv-visible: FocusScope {
        width: 100%;
        height: 100%;
        opacity: 0;
        init => { self.focus(); self.opacity = 1; }
        animate opacity { duration: 220ms; easing: ease-out; }
        key-pressed(e) => {
            if (e.text == Key.UpArrow) { root.tv-input("up"); return EventResult.accept; }
            if (e.text == Key.DownArrow) { root.tv-input("down"); return EventResult.accept; }
            if (e.text == Key.LeftArrow) { root.tv-input("left"); return EventResult.accept; }
            if (e.text == Key.RightArrow) { root.tv-input("right"); return EventResult.accept; }
            if (e.text == Key.Return) { root.tv-input("a"); return EventResult.accept; }
            if (e.text == Key.Escape) { root.tv-input("start"); return EventResult.accept; }
            return EventResult.reject;
        }
        Rectangle {
            background: #07080c;
            VerticalLayout {
                // Hero
                Rectangle {
                    height: 300px;
                    clip: true;
                    Image { source: root.tv-hero-cover; width: 100%; height: 100%; image-fit: cover; }
                    Rectangle { background: @linear-gradient(180deg, #07080c00 0%, #07080cee 100%); }
                    VerticalLayout {
                        padding: 28px;
                        alignment: end;
                        Text { text: root.tv-hero-title; color: white; font-size: 40px; font-weight: 900; }
                        Text { text: root.tv-hero-subtitle; color: #ffb23e; font-size: 18px; }
                    }
                }
                // Shelves (viewport follows focus on both axes)
                Flickable {
                    interactive: false;
                    viewport-height: root.tv-shelf-count * 252px;
                    viewport-y: -root.tv-shelf * 252px;
                    animate viewport-y { duration: 280ms; easing: ease-in-out; }
                    VerticalLayout {
                        for shelf[si] in root.tv-shelves: VerticalLayout {
                            height: 252px;
                            padding-left: 24px;
                            spacing: 6px;
                            Text { text: shelf.name; color: white; font-weight: 800; font-size: 16px;
                                   opacity: si == root.tv-shelf ? 1.0 : 0.55;
                                   animate opacity { duration: 220ms; } }
                            Flickable {
                                interactive: false;
                                height: 214px;
                                viewport-width: shelf.count * 170px;
                                viewport-x: si == root.tv-shelf ? -root.tv-col * 170px : 0px;
                                animate viewport-x { duration: 240ms; easing: ease-out; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    for game[col] in shelf.games: Rectangle {
                                        property <bool> focused: si == root.tv-shelf && col == root.tv-col;
                                        width: 158px;
                                        height: 210px;
                                        border-radius: 10px;
                                        clip: true;
                                        background: #1c1f28;
                                        border-width: 3px;
                                        border-color: focused ? #ffb23e : #00000000;
                                        drop-shadow-blur: focused ? 26px : 0px;
                                        drop-shadow-color: focused ? #ffb23eaa : #00000000;
                                        animate border-color, drop-shadow-blur, drop-shadow-color { duration: 200ms; easing: ease-out; }
                                        Image {
                                            source: game.cover;
                                            width: focused ? parent.width * 1.08 : parent.width;
                                            height: focused ? parent.height * 1.08 : parent.height;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            image-fit: cover;
                                            animate width, height { duration: 200ms; easing: ease-out; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                // Hint bar
                Rectangle {
                    height: 42px;
                    background: #14161d;
                    HorizontalLayout {
                        padding-left: 24px;
                        spacing: 24px;
                        Text { text: "Ⓐ Jugar"; color: #ffb23e; vertical-alignment: center; }
                        Text { text: "LB / RB  Consola"; color: #ffffff88; vertical-alignment: center; }
                        Text { text: "☰ / Esc  Salir"; color: #ffffff88; vertical-alignment: center; }
                    }
                }
            }
        }
    }

    // ── Resize handles (frameless) ───────────────────────
    // Edges
    Rectangle { x: 0; y: 0; width: root.width; height: 4px;
        TouchArea { mouse-cursor: ns-resize;
            pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-press("n"); } } } }
    Rectangle { x: 0; y: root.height - 4px; width: root.width; height: 4px;
        TouchArea { mouse-cursor: ns-resize;
            pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-press("s"); } } } }
    Rectangle { x: 0; y: 0; width: 4px; height: root.height;
        TouchArea { mouse-cursor: ew-resize;
            pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-press("w"); } } } }
    Rectangle { x: root.width - 4px; y: 0; width: 4px; height: root.height;
        TouchArea { mouse-cursor: ew-resize;
            pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-press("e"); } } } }
    // Corners (on top of edges)
    Rectangle { x: 0; y: 0; width: 9px; height: 9px;
        TouchArea { mouse-cursor: nwse-resize;
            pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-press("nw"); } } } }
    Rectangle { x: root.width - 9px; y: 0; width: 9px; height: 9px;
        TouchArea { mouse-cursor: nesw-resize;
            pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-press("ne"); } } } }
    Rectangle { x: 0; y: root.height - 9px; width: 9px; height: 9px;
        TouchArea { mouse-cursor: nesw-resize;
            pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-press("sw"); } } } }
    Rectangle { x: root.width - 9px; y: root.height - 9px; width: 9px; height: 9px;
        TouchArea { mouse-cursor: nwse-resize;
            pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-press("se"); } } } }
}
