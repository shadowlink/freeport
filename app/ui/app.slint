import { ScrollView } from "std-widgets.slint";

// ── Data ───────────────────────────────────────────────────────────────────

struct CardItem {
    id: string,
    title: string,
    subtitle: string,
    cover: image,
    installed: bool,
    is-windows: bool,
    update-available: bool,
    needs-rom: bool,
    rom-ok: bool,
    busy: bool,
    progress: float,
    kind: string,
    sys-color: color,
    favorite: bool,
    play-state: int, // 0 none, 1 launching, 2 failed
    install-error: bool,
    version: string,     // installed tag, or latest for catalog cards
    new-version: string, // target tag when an update is available
    meta: string,        // extra line for the "Seguir jugando" strip ("hace 2h")
    is-new: bool,        // recently added to the catalog
    versions: int,       // projects folded into this card (1 = plain project)
    aspect: float,       // width/height of the system's original box (1.43 N64, 1.0 PS1, 0.58 PSP…)

    experimental: bool,  // tier experimental: shown with a warning badge
    fit-cover: bool,     // art shape differs from the box: crop instead of letterboxing
    size: string,        // on-disk size when installed ("12.3 GB"), else ""
    cx: float,           // home row: centre of this box, in box heights from the first one
}

// Home (simple console-style view): one console in the carousel.
struct HomeSystem {
    id: string,
    name: string,
    color: color,
    logo: image,
    has-logo: bool,
    count: int,
    installed: int,
    covers: [CardItem],  // up to three of its games, fanned on the card
    is-recent: bool,     // the «Jugados recientemente» card
}

// Settings → disk usage: one installed game.
struct DiskGame {
    id: string,
    title: string,
    version: string,
    size: string,
}

// Settings → disk usage per system.
struct DiskRow {
    id: string,
    name: string,
    logo: image,
    has-logo: bool,
    count: int,
    size: string,
    frac: float,         // share of the biggest console (bar length)
    games: [DiskGame],
}

// «Actualizar todo»: one game of the batch.
struct BulkItem {
    title: string,
    state: int,          // 0 en cola, 1 actualizando, 2 hecho, 3 error, 4 cancelado
    progress: float,
}

// One version of a game in the detail page's selector.
struct VersionRow {
    id: string,
    name: string,
    kind: string,        // "RECOMP" | "PORT"
    is-windows: bool,
    installed: bool,
    active: bool,        // the version currently shown
    platforms: string,   // "Linux · Windows"
    meta: string,        // latest tag
}

struct SysRow {
    id: string,
    name: string,
    count: int,
    color: color,
    logo: image,
    has-logo: bool,
    exp-on: bool,     // experimental ports of this system are listed
    exp-hidden: int,  // experimental ports currently hidden
}

struct FactRow {
    label: string,
    value: string,
    accent: color,
}

// Game list side panel (ES-DE style): art and facts of the selected game.
struct HomeInfo {
    logo: image,
    has-logo: bool,
    shot: image,         // in-game screenshot (or title screen)
    has-shot: bool,
    art: image,          // fanart for the background (or the screenshot)
    has-art: bool,
    facts: [FactRow],    // año, desarrolladora, género, jugadores…
    rating: float,       // 0-5 (LaunchBox community), 0 = none
    desc: string,
}

struct RaBadge {
    img: image,
    has-img: bool,
    unlocked: bool,
}

struct ScreenShot {
    img: image,
    path: string,
}

struct ModRow {
    full-name: string,
    name: string,
    owner: string,
    downloads: string,
    description: string,
    icon: image,
    has-icon: bool,
    installed: bool,
    update: bool,
    busy: bool,
    progress: float,
    phase: string,
}

struct TabItem {
    key: string,
    label: string,
}

struct DetailData {
    id: string,
    title: string,
    subtitle: string,
    cover: image,
    installed: bool,
    is-windows: bool,
    update-available: bool,
    needs-rom: bool,
    rom-ok: bool,
    is-ps4: bool,      // PS4 port: offers the PKG importer
    is-switch: bool,   // Switch port: offers the NSP/XCI importer
    phase: string,     // busy label override (e.g. PKG import)
    busy: bool,
    progress: float,
    play-state: int,
    install-error: bool,
    fit-cover: bool,
    stats: string,
    repo-url: string,
    last-updated: string,
    changelog: string,
    about: string,
    port-notes: string,
    has-related: bool,
    has-versions: bool,
    has-mods: bool,
    has-screens: bool,
    ra-eligible: bool,
    ra-enabled: bool,
    ra-beta: bool,
    kind: string,        // "RECOMP" | "PORT"
    tier: string,        // "curado" | "comunidad" | "experimental"
    aspect: float,       // width/height of the system's original box
    default-labels: [string], // "Preguntar", then one per version
    default-index: int,       // current choice in default-labels
    version: string,     // installed tag
    new-version: string, // latest tag when an update is available
    facts: [FactRow],
    repo-label: string,      // "↗ Ver en GitHub" | "↗ Web oficial"
    ra-summary: string,      // "12/97 logros · 80/749 pts" (empty = no section)
    badge-rows: [[RaBadge]],
    related: [CardItem],
    versions: [VersionRow],
    mods: [ModRow],
    screens: [ScreenShot],
    tabs: [TabItem],          // sections of the page, in order
    sys-logo: image,
    has-sys-logo: bool,
    sys-color: color,
    status: string,           // one plain line: "Listo para jugar", "Falta añadir tu juego"…
    status-color: color,
    add-game-kind: string,    // "rom" | "pkg" | "switch" | "" (the port asks for it itself)
    add-game-label: string,
}


// ── Building blocks ────────────────────────────────────────────────────────
// Palette: bg #1b1c20 · panel #2a2c33 · raised #33363e · line #3c3f48 ·
// accent #2fd3ef (primary) · ok #4de1c1 · danger #ff5d73 · warn #ff9f43.

// Button. `kind`: "primary" (amber), "secondary" (raised), "ghost" (text only),
// "danger" (red text). `big` gives the page-level size.
component Btn inherits Rectangle {
    in property <string> label;
    in property <string> kind: "primary";
    in property <bool> big: false;
    in property <color> fg: root.kind == "primary" ? #1b1c20
                          : (root.kind == "danger" ? #ff5d73 : (root.kind == "ghost" ? #ffffffcc : white));
    in property <color> bg: root.kind == "primary" ? #2fd3ef : (root.kind == "ghost" ? #00000000 : #33363e);
    out property <bool> hovered: touch.has-hover;
    callback clicked;
    height: root.big ? 44px : 32px;
    border-radius: self.height / 2;
    background: touch.pressed ? bg.darker(20%)
              : (touch.has-hover ? (root.kind == "ghost" ? #ffffff14 : bg.brighter(18%)) : bg);
    border-width: root.kind == "secondary" || root.kind == "danger" ? 1px : 0px;
    border-color: #3c3f48;
    animate background { duration: 120ms; easing: ease-out; }
    preferred-width: t.preferred-width + (root.big ? 40px : 28px);
    min-width: t.preferred-width + (root.big ? 40px : 28px);
    t := Text { x: root.big ? 20px : 14px; width: parent.width - (root.big ? 40px : 28px); height: parent.height;
                text: root.label; color: root.fg; font-size: root.big ? 15px : 13px; font-weight: 800;
                horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Cover art that never crops the boxart: the full image is shown (contain) on
// a dark slot. Slots already follow the system's box shape, so the art fills it.
component Cover inherits Rectangle {
    in property <image> source;
    in property <string> title;
    in property <bool> hovered;
    in property <bool> fit-cover;  // crop (cover) when the art isn't the box's shape
    background: #2a2c33;
    if root.source.width == 0: Text {
        x: 8px; width: parent.width - 16px; height: parent.height;
        text: root.title; color: #ffffff66; font-size: 12px; font-weight: 700;
        wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center;
    }
    Image {
        source: root.source;
        // Always exactly the box: no zoom of its own (it lagged the box and
        // made the art zoom in/out on every move).
        width: parent.width; height: parent.height;
        image-fit: root.fit-cover ? cover : contain;
    }
}

// Soft shadow without blur: three stacked translucent rounded rectangles.
// (drop-shadow-blur is re-rendered on every frame of an animation and took the
// carousel from 60 to ~24 fps.) Place it before the element, same geometry.
component SoftShadow inherits Rectangle {
    in property <length> radius;
    in property <length> spread: 12px;
    in property <length> dy: 6px;
    in property <float> strength: 1.0;
    in property <color> tint: black;
    Rectangle { x: -root.spread; y: -root.spread + root.dy; width: parent.width + root.spread * 2; height: parent.height + root.spread * 2;
                border-radius: root.radius + root.spread; background: root.tint.with-alpha(0.07 * root.strength); }
    Rectangle { x: -root.spread * 0.6; y: -root.spread * 0.6 + root.dy; width: parent.width + root.spread * 1.2; height: parent.height + root.spread * 1.2;
                border-radius: root.radius + root.spread * 0.6; background: root.tint.with-alpha(0.10 * root.strength); }
    Rectangle { x: -root.spread * 0.25; y: -root.spread * 0.25 + root.dy; width: parent.width + root.spread * 0.5; height: parent.height + root.spread * 0.5;
                border-radius: root.radius + root.spread * 0.25; background: root.tint.with-alpha(0.16 * root.strength); }
}

// On/off switch.
component Toggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);
    width: 52px; height: 30px; border-radius: 15px;
    background: root.checked ? #2fd3ef : (tg-ta.has-hover ? #4a4d57 : #3c3f48);
    animate background { duration: 140ms; easing: ease-out; }
    Rectangle {
        x: root.checked ? 25px : 3px; y: 3px; width: 24px; height: 24px; border-radius: 12px;
        background: white;
        animate x { duration: 140ms; easing: ease-out; }
    }
    tg-ta := TouchArea { mouse-cursor: pointer; clicked => { root.checked = !root.checked; root.toggled(root.checked); } }
}

// Thin progress bar. `value` in 0.0..1.0; when < 0 shows an indeterminate sweep.
component Bar inherits Rectangle {
    in property <float> value;
    in property <color> fill: #2fd3ef;
    height: 5px;
    border-radius: 3px;
    background: #ffffff1a;
    clip: true;
    property <float> sweep;
    animate sweep { duration: 1100ms; iteration-count: -1; easing: ease-in-out; }
    init => { self.sweep = 1.0; }
    Rectangle {
        x: root.value >= 0 ? 0px : (parent.width * 0.6) * root.sweep;
        width: root.value >= 0 ? parent.width * clamp(root.value, 0.0, 1.0) : parent.width * 0.4;
        height: parent.height;
        border-radius: 3px;
        background: root.fill;
        animate width { duration: 180ms; easing: ease-out; }
    }
}

// Small status chip: tinted text on a translucent fill of the same colour.
// ── Console-style building blocks ──────────────────────────────────────────
// Big rounded "pill" button. kind: primary (cyan), secondary (soft), ghost
// (outline), update (yellow text), attention (yellow fill: something to do),
// danger (red fill).
component PillBtn inherits Rectangle {
    in property <string> label;
    in property <string> kind: "primary";
    in property <bool> wide: false;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <float> s: 1.0;      // scale (the home grows with the window)
    in property <bool> focused: false; // keyboard / gamepad focus ring
    callback clicked;
    property <color> bg: root.kind == "primary" ? #2fd3ef
                       : root.kind == "attention" ? #ffd166
                       : root.kind == "danger" ? #e04b5a
                       : root.kind == "ghost" ? #00000000 : #ffffff1c;
    property <color> fg: root.kind == "primary" || root.kind == "attention" ? #14232a
                       : root.kind == "update" ? #ffd166 : white;
    height: 52px * root.s;
    width: max((root.wide ? 220px : 120px) * root.s, pl.preferred-width + (52px + (root.has-icon ? 30px : 0px)) * root.s);
    border-radius: self.height / 2;
    background: pta.pressed ? root.bg.darker(15%) : (pta.has-hover ? (root.kind == "ghost" ? #ffffff14 : root.bg.brighter(12%)) : root.bg);
    border-width: root.kind == "ghost" ? 2px : 0px;
    border-color: #ffffff44;
    drop-shadow-blur: root.kind == "primary" ? 18px : 0px;
    drop-shadow-color: #2fd3ef55;
    animate background { duration: 120ms; }
    if root.focused: Rectangle {
        x: -6px * root.s; y: -6px * root.s; width: parent.width + 12px * root.s; height: parent.height + 12px * root.s;
        border-radius: self.height / 2; border-width: 4px * root.s; border-color: white;
    }
    HorizontalLayout {
        alignment: center;
        spacing: 10px * root.s;
        if root.has-icon: Image { source: root.icon; width: 20px * root.s; height: 20px * root.s; y: (root.height - 20px * root.s) / 2; colorize: root.fg; }
        pl := Text { text: root.label; color: root.fg; font-size: 17px * root.s; font-weight: 900; vertical-alignment: center; }
    }
    pta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Round icon button (back, settings…).
component IconCircle inherits Rectangle {
    in property <image> icon;
    in property <length> size: 42px;
    callback clicked;
    width: root.size; height: root.size; border-radius: root.size / 2;
    background: ic-ta.pressed ? #ffffff33 : (ic-ta.has-hover ? #ffffff26 : #ffffff12);
    border-width: 1px; border-color: #ffffff14;
    animate background { duration: 120ms; }
    Image { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: root.size * 0.48; height: root.size * 0.48;
            source: root.icon; colorize: white; }
    ic-ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Value picker «‹ value ›»: arrows step through the options (console style,
// works with the mouse; no drop-down list).
component Choice inherits Rectangle {
    in property <[string]> options;
    in-out property <int> index;
    callback selected(string);
    width: 300px; height: 42px; border-radius: 21px; background: #ffffff10;
    border-width: 1px; border-color: #ffffff18;
    HorizontalLayout {
        padding-left: 4px; padding-right: 4px;
        Rectangle { width: 34px; height: 34px; y: 4px; border-radius: 17px; background: chl.has-hover && root.index > 0 ? #ffffff22 : #00000000;
            Image { x: 8px; y: 8px; width: 18px; height: 18px; source: @image-url("../assets/icons/back.svg"); colorize: root.index > 0 ? white : #ffffff33; }
            chl := TouchArea { mouse-cursor: pointer; clicked => { if (root.index > 0) { root.index -= 1; root.selected(root.options[root.index]); } } } }
        Text { horizontal-stretch: 1; text: root.options[root.index]; color: white; font-size: 14px; font-weight: 800;
               horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
        Rectangle { width: 34px; height: 34px; y: 4px; border-radius: 17px; background: chr.has-hover && root.index < root.options.length - 1 ? #ffffff22 : #00000000;
            Image { x: 8px; y: 8px; width: 18px; height: 18px; source: @image-url("../assets/icons/forward.svg"); colorize: root.index < root.options.length - 1 ? white : #ffffff33; }
            chr := TouchArea { mouse-cursor: pointer; clicked => { if (root.index < root.options.length - 1) { root.index += 1; root.selected(root.options[root.index]); } } } }
    }
}

// Text field in the console style (rounded, cyan when focused).
component Field inherits Rectangle {
    in property <string> placeholder;
    in property <bool> password: false;
    in-out property <string> text;
    height: 48px; border-radius: 14px;
    background: fi.has-focus ? #ffffff16 : #ffffff0c;
    border-width: fi.has-focus ? 2px : 1px; border-color: fi.has-focus ? #2fd3ef : #ffffff18;
    if root.text == "": Text { x: 16px; height: 100%; text: root.placeholder; color: #ffffff66; font-size: 15px; vertical-alignment: center; }
    TouchArea { mouse-cursor: MouseCursor.text; clicked => { fi.focus(); } }
    fi := TextInput { x: 16px; width: parent.width - 32px; height: 100%; vertical-alignment: center; color: white; font-size: 15px;
                      single-line: true; input-type: root.password ? InputType.password : InputType.text; text <=> root.text; }
}

// Rounded panel that groups option rows.
component OptionPanel inherits Rectangle {
    border-radius: 18px;
    background: #2a2c33;
    VerticalLayout { padding: 6px; @children }
}

// A settings row: text on the left, a control on the right.
component SetRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    min-height: 72px;
    HorizontalLayout {
        padding-left: 18px; padding-right: 18px; spacing: 16px;
        VerticalLayout {
            alignment: center; spacing: 3px; horizontal-stretch: 1;
            Text { text: root.label; color: white; font-size: 15px; font-weight: 700; wrap: word-wrap; }
            if root.hint != "": Text { text: root.hint; color: #ffffff88; font-size: 12px; wrap: word-wrap; }
        }
        @children
    }
}

// A whole-row action (game page «Opciones»): label, optional hint and value, chevron.
component OptionRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <string> value;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked;
    height: root.hint != "" ? 72px : 58px;
    border-radius: 14px;
    background: ora.has-hover && root.enabled ? #ffffff10 : #00000000;
    HorizontalLayout {
        padding-left: 18px; padding-right: 18px; spacing: 12px;
        VerticalLayout {
            alignment: center; spacing: 3px; horizontal-stretch: 1;
            Text { text: root.label; color: !root.enabled ? #ffffff66 : (root.danger ? #ff6b7d : white); font-size: 15px; font-weight: 700; }
            if root.hint != "": Text { text: root.hint; color: #ffffff77; font-size: 12px; overflow: elide; }
        }
        if root.value != "": Text { text: root.value; color: #2fd3ef; font-size: 14px; font-weight: 800; vertical-alignment: center; }
        if root.enabled: Image { width: 18px; height: 18px; y: (parent.height - 18px) / 2; source: @image-url("../assets/icons/forward.svg"); colorize: #ffffff66; }
    }
    ora := TouchArea { mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
                       clicked => { if (root.enabled) { root.clicked(); } } }
}

// Per-console switch row (settings: test versions).
component SysToggleRow inherits Rectangle {
    in property <SysRow> sys;
    callback toggled(bool);
    height: 60px;
    HorizontalLayout {
        padding-left: 18px; padding-right: 18px; spacing: 16px;
        Rectangle { width: 110px;
            if root.sys.has-logo: Image { source: root.sys.logo; width: 110px; height: 24px; y: 18px; image-fit: contain; horizontal-alignment: left; }
            if !root.sys.has-logo: Text { text: root.sys.name; color: white; font-size: 13px; font-weight: 800; height: 100%; vertical-alignment: center; } }
        Text { text: root.sys.name; color: white; font-size: 15px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        Text { text: root.sys.exp-hidden > 1 ? "\{root.sys.exp-hidden} ocultos" : (root.sys.exp-hidden == 1 ? "1 oculto" : "");
               color: #ffffff77; font-size: 12px; vertical-alignment: center; }
        Toggle { checked: root.sys.exp-on; y: 15px; toggled(v) => { root.toggled(v); } }
    }
}

// Bottom bar of controller hints: [A] Jugar  [B] Volver …
component Hints inherits Rectangle {
    in property <[{k: string, t: string}]> keys;
    in property <float> s: 1.0;
    height: 50px * root.s;
    HorizontalLayout {
        alignment: center; spacing: 26px * root.s;
        for h in root.keys: HorizontalLayout {
            spacing: 8px * root.s;
            Rectangle { width: max(24px * root.s, hk.preferred-width + 12px * root.s); height: 24px * root.s; border-radius: self.height / 2; background: #ffffffdd;
                        y: (root.height - self.height) / 2;
                hk := Text { text: h.k; color: #1e1f24; font-size: 12px * root.s; font-weight: 900; width: 100%; height: 100%;
                             horizontal-alignment: center; vertical-alignment: center; } }
            Text { text: h.t; color: #ffffffbb; font-size: 13px * root.s; vertical-alignment: center; }
        }
    }
}

// ── Window ─────────────────────────────────────────────────────────────────

export component MainWindow inherits Window {
    in-out property <bool> library-tab;
    in-out property <string> search-text;
    // Bulk "update everything" state
    in property <int> updates-pending;
    in property <bool> bulk-busy;
    in property <float> bulk-progress;
    in property <string> bulk-label;
    callback update-all();
    // Library footprint on disk ("3.2 GB"), shown in settings.
    in property <string> library-size;
    // Add-to-Steam (game page side panel)
    callback add-steam(string);
    in property <string> detail-msg;
    callback cancel-update-all();
    callback cancel-install(string);
    callback refresh();
    callback toggle-favorite(string);
    callback open-folder(string);
    callback open-game(string);
    callback install(string);
    callback play(string);
    callback uninstall(string);
    callback pick-rom(string);
    callback import-pkg(string);
    callback import-switch(string);
    callback close-detail();
    callback install-mod(string, string);
    callback uninstall-mod(string, string);
    callback toggle-ra(string, bool);
    callback open-url(string);
    // In-app screenshot viewer (lightbox)
    in-out property <image> viewer-image;
    in-out property <bool> viewer-visible;
    in property <DetailData> detail;
    in property <bool> detail-visible;
    // Uninstall confirmation
    in-out property <bool> confirm-visible;
    // Version chooser (install / play / uninstall when a game has several ports)
    in-out property <bool> chooser-visible;
    in property <string> chooser-title;
    in property <string> chooser-mode;        // "install" | "play" | "uninstall"
    in property <[VersionRow]> chooser-items;
    in-out property <bool> chooser-remember;
    callback choose-version(string, bool);    // project id, remember
    callback request-uninstall(string);       // card ✕: Rust decides (chooser or confirm)
    callback set-default-version(string, int); // detail id, index in default-labels (0 = ask)
    in-out property <string> confirm-id;
    in-out property <string> confirm-title;
    // Settings
    in-out property <bool> settings-visible;
    in-out property <bool> show-windows;
    in property <[SysRow]> settings-systems;    // first half of every system (per-system experimental switches)
    in property <[SysRow]> settings-systems-b;  // second half (two columns)
    // ── Home: simple console-style view (ES-DE carousel, Switch look) ──
    in property <[HomeSystem]> home-systems;
    in-out property <int> home-sys;
    in property <[CardItem]> home-games;
    in property <HomeInfo> home-info;
    in-out property <int> home-game;
    in-out property <int> home-level;             // 0 consoles, 1 games of the console
    in property <color> home-color: #3a3d46;      // tint of the selected console
    callback home-key(string);
    in property <[CardItem]> home-preview;        // a few covers of the console in focus
    in property <string> clock;                   // "18:52"
    callback home-pick-system(int);
    callback home-pick-game(int);
    // Navigation history (mouse back/forward buttons): the app records every
    // view change and replays it.
    callback nav-push();
    callback nav-back();
    callback nav-forward();
    in property <[DiskRow]> disk-rows;        // settings: disk usage per system
    in property <string> disk-total;
    in-out property <string> expanded-sys;    // settings: console unfolded in Almacenamiento
    callback confirm-uninstall(string);       // ask to remove this exact project
    in property <string> confirm-extra;       // port data folders that «borrar también» removes
    in-out property <bool> confirm-wipe;
    // «Actualizar todo»: the games of the batch and their state.
    in property <[BulkItem]> bulk-items;
    in-out property <bool> bulk-open;
    callback bulk-dismiss();
    // Home: button row in focus inside a console (-1 = the boxes).
    in-out property <int> home-btn: -1;
    callback home-pick-preview(int);
    // Settings: experimental versions in every console at once.
    in-out property <bool> exp-all-on;
    callback set-all-experimental(bool);
    // Console-style pages: section in focus and the keys they react to (also
    // invoked from Rust for the gamepad).
    in-out property <int> detail-tab;
    in-out property <int> settings-tab;
    in-out property <int> chooser-focus;
    in-out property <bool> fullscreen;
    // Page transitions (console view): 0 hidden … 1 shown, animated.
    out property <float> dv: root.detail-visible ? 1 : 0;
    animate dv { duration: 240ms; easing: cubic-bezier(0.3, 0.7, 0.2, 1); }
    out property <float> sv: root.settings-visible ? 1 : 0;
    animate sv { duration: 240ms; easing: cubic-bezier(0.3, 0.7, 0.2, 1); }
    callback toggle-fullscreen(bool);
    callback detail-key(string);
    callback settings-key(string);
    callback dialog-key(string);
    detail-key(k) => {
        if (root.viewer-visible) { if (k == "b" || k == "a") { root.viewer-visible = false; } return; }
        if (k == "b") { root.close-detail(); return; }
        if (k == "a") {
            if (root.detail.busy) { return; }
            if (root.detail.installed) { if (root.detail.play-state != 1) { root.play(root.detail.id); } }
            else { root.install(root.detail.id); }
            return;
        }
        if (k == "left" || k == "lb") { root.detail-tab = max(0, root.detail-tab - 1); return; }
        if (k == "right" || k == "rb") { root.detail-tab = min(root.detail.tabs.length - 1, root.detail-tab + 1); return; }
    }
    settings-key(k) => {
        if (k == "b") { root.settings-visible = false; root.nav-push(); return; }
        if (k == "up" || k == "lb") { root.settings-tab = max(0, root.settings-tab - 1); return; }
        if (k == "down" || k == "rb") { root.settings-tab = min(5, root.settings-tab + 1); return; }
    }
    dialog-key(k) => {
        if (root.confirm-visible) {
            if (k == "a") { root.uninstall(root.confirm-id); root.confirm-visible = false; }
            if (k == "b") { root.confirm-visible = false; }
            return;
        }
        if (root.chooser-visible) {
            if (k == "up") { root.chooser-focus = max(0, root.chooser-focus - 1); }
            if (k == "down") { root.chooser-focus = min(root.chooser-items.length - 1, root.chooser-focus + 1); }
            if (k == "b") { root.chooser-visible = false; }
            if (k == "a" && root.chooser-items.length > 0) {
                root.chooser-visible = false;
                root.choose-version(root.chooser-items[root.chooser-focus].id, root.chooser-remember);
            }
        }
    }
    in-out property <string> notice;          // transient message bar; empty = hidden
    in-out property <string> rail-tip;        // (kept for compatibility; unused)
    in-out property <length> rail-tip-y;
    in-out property <string> current-runner-label;
    in-out property <int> runner-index;
    in property <string> version;
    in property <string> platform-label;
    in property <[string]> runner-labels;
    in property <string> settings-msg;
    in-out property <bool> catalog-busy;
    // RetroAchievements account
    in property <bool> ra-logged-in;
    in property <string> ra-status;
    callback ra-login(string, string);
    callback ra-logout();
    // RomM (the user's own ROM library server)
    in-out property <bool> romm-connected;
    in-out property <string> romm-status;
    in-out property <string> romm-url;
    in-out property <string> romm-user;
    callback romm-connect(string, string, string);
    callback romm-forget();
    callback romm-search(string);
    callback toggle-windows(bool);
    callback toggle-experimental-system(string, bool);
    callback set-runner(string);
    callback refresh-catalog();
    // Self-update
    in property <bool> update-available;
    in property <string> update-version;
    in property <string> update-notes;
    in-out property <bool> update-busy;
    in property <bool> update-error;
    callback do-update();
    callback dismiss-update();
    callback check-updates();
    // Retro CRT effect
    in-out property <bool> crt-visible;
    callback toggle-crt(bool);

    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 860px;
    min-height: 560px;
    title: "Freeport";
    icon: @image-url("../assets/app-icon.png");
    background: #1b1c20;
    default-font-size: 13px;
    default-font-family: "Nunito";

    // Navigation helpers: every sidebar action lands on a clean view.
    function go-settings() { root.settings-visible = true; root.nav-push(); }




    // ── Inicio: carrusel de consolas y de juegos (vista sencilla) ─────────
    home := FocusScope {
        x: 0; y: 0; width: root.width; height: root.height;
        property <float> pulse: 1.0;   // static: a constant animation repainted the whole window 60×/s
        property <color> cyan: #2fd3ef;
        property <CardItem> g: root.home-games[root.home-game];
        // Scale with the window: 1.0 at 1280×800, bigger when maximised.
        property <float> k: clamp(min(root.width / 1280px, root.height / 800px), 1.0, 2.4);
        property <float> kb: 1 + (home.k - 1) * 0.5;   // bars and chrome grow less
        // Level transition: consoles slide out to the left while the games
        // slide in from the right (and back), both fading.
        property <float> lv: root.home-level;
        animate lv { duration: 280ms; easing: cubic-bezier(0.3, 0.7, 0.2, 1); }
        // Under a page or dialog: take the keys back when it closes.
        property <bool> covered: root.detail-visible || root.settings-visible || root.confirm-visible || root.chooser-visible;
        changed covered => { if (!self.covered) { self.focus(); } }
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.LeftArrow) { root.home-key("left"); return EventResult.accept; }
            if (e.text == Key.RightArrow) { root.home-key("right"); return EventResult.accept; }
            if (e.text == Key.UpArrow) { root.home-key("up"); return EventResult.accept; }
            if (e.text == Key.DownArrow) { root.home-key("down"); return EventResult.accept; }
            if (e.text == Key.Return || e.text == " ") { root.home-key("a"); return EventResult.accept; }
            if (e.text == Key.Escape || e.text == Key.Backspace) { root.home-key("b"); return EventResult.accept; }
            if (e.text == "x" || e.text == "i") { root.home-key("x"); return EventResult.accept; }
            if (e.text == Key.PageUp) { root.home-key("pgup"); return EventResult.accept; }
            if (e.text == Key.PageDown) { root.home-key("pgdn"); return EventResult.accept; }
            if (e.text == Key.F11) { root.toggle-fullscreen(!root.fullscreen); return EventResult.accept; }
            return EventResult.reject;
        }

        // ── Backdrop: dark base, a glow of the console's colour, and (inside a
        // console) the selected game's art, very faint.
        Rectangle { x: 0; y: 0; width: parent.width; height: parent.height; background: #15161a; }
        // Inside a console: the game's fanart (or screenshot), dimmed.
        Image {
            x: 0; y: 0; width: parent.width; height: parent.height; image-fit: cover;
            source: root.home-info.has-art ? root.home-info.art : home.g.cover;
            opacity: (root.home-info.has-art ? 0.30 : 0.08) * home.lv;
        }
        if home.lv > 0.01 && root.home-info.has-art: Rectangle {
            x: 0; y: 0; width: parent.width; height: parent.height; opacity: home.lv;
            background: @linear-gradient(90deg, #15161af0 0%, #15161aa0 38%, #15161a40 100%);
        }
        // Glow of the console's colour from the top. A square much bigger than
        // the window, so the gradient is already transparent at its edges and
        // never shows a cut (the radius is half the diagonal).
        Rectangle {
            property <length> side: max(parent.width, parent.height) * 2.2;
            x: (parent.width - self.side) / 2; y: parent.height * 0.2 - self.side / 2;
            width: self.side; height: self.side;
            background: @radial-gradient(circle, root.home-color.with-alpha(0.50) 0%, root.home-color.with-alpha(0.15) 17%, #15161a00 33%);
        }
        Rectangle { x: 0; y: 0; width: parent.width; height: parent.height;
                    background: @linear-gradient(180deg, #15161a00 0%, #15161a00 55%, #15161ae6 100%); }

        // Wheel = previous / next anywhere; a click on empty space takes the keys back.
        // Deltas add up until a full notch (60 px): a touchpad or a free-spinning
        // wheel no longer flies past ten items, and a tiny nudge does nothing.
        property <length> wheel-acc: 0;
        Timer { interval: 300ms; running: home.wheel-acc != 0; triggered => { home.wheel-acc = 0; } }
        TouchArea {
            scroll-event(e) => {
                home.wheel-acc += Math.abs(e.delta-x) > Math.abs(e.delta-y) ? e.delta-x : e.delta-y;
                if (home.wheel-acc <= -45px) { home.wheel-acc = 0; root.home-key(root.home-level == 1 ? "down" : "right"); }
                else if (home.wheel-acc >= 45px) { home.wheel-acc = 0; root.home-key(root.home-level == 1 ? "up" : "left"); }
                return EventResult.accept;
            }
            clicked => { home.focus(); }
        }

        // ── Top bar ──
        HorizontalLayout {
            x: 0; y: 0; width: parent.width; height: 72px;
            padding-left: 30px; padding-right: 26px; spacing: 14px;
            Image { source: @image-url("../assets/logo.svg"); width: 30px; height: 30px; y: (parent.height - 30px) / 2; }
            Text { text: "Freeport"; color: white; font-size: 21px; font-weight: 900; vertical-alignment: center; letter-spacing: 0.3px; }
            Rectangle { horizontal-stretch: 1; }
            Rectangle { horizontal-stretch: 1; }
            // «Actualizar todo» in progress (or just finished): what it is
            // doing; click for the whole list.
            if root.bulk-items.length > 0: Rectangle {
                height: 40px; y: 16px; width: min(380px, bl.preferred-width + 36px); border-radius: 20px;
                background: bk-ta.has-hover || root.bulk-open ? #ffffff26 : #00000066;
                border-width: 1px; border-color: root.bulk-busy ? #2fd3ef88 : #ffffff22;
                bl := Text { x: 18px; width: parent.width - 36px; height: 100%; vertical-alignment: center; overflow: elide;
                             text: root.bulk-label; color: root.bulk-busy ? #2fd3ef : white; font-size: 13px; font-weight: 800; }
                bk-ta := TouchArea { mouse-cursor: pointer; clicked => { root.bulk-open = !root.bulk-open; } }
            }
            if root.update-available: PillBtn { height: 40px; y: 16px; label: root.update-busy ? "Actualizando…" : "Nueva versión de Freeport"; kind: "primary";
                                                clicked => { if (!root.update-busy) { root.do-update(); } } }
            if root.library-tab && root.updates-pending > 0 && !root.bulk-busy: PillBtn { height: 40px; y: 16px;
                label: root.updates-pending == 1 ? "1 actualización" : "\{root.updates-pending} actualizaciones"; kind: "update"; clicked => { root.update-all(); } }
            // Search
            Rectangle {
                width: 230px; height: 42px; y: (parent.height - 42px) / 2; border-radius: 21px;
                background: search-in.has-focus ? #ffffff1f : #00000066;
                border-width: search-in.has-focus ? 2px : 1px; border-color: search-in.has-focus ? #2fd3ef : #ffffff14;
                Image { x: 15px; y: 12px; width: 18px; height: 18px; source: @image-url("../assets/icons/search.svg"); opacity: 0.75; }
                if root.search-text == "": Text { x: 42px; height: 100%; text: "Buscar un juego"; color: #ffffff77; font-size: 14px; vertical-alignment: center; }
                search-in := TextInput {
                    x: 42px; width: parent.width - 54px; height: 100%; vertical-alignment: center;
                    color: white; font-size: 14px; single-line: true;
                    text <=> root.search-text;
                    edited => { root.home-level = 0; root.refresh(); }
                    accepted => { home.focus(); }
                    key-pressed(e) => { if (e.text == Key.Escape) { home.focus(); return EventResult.accept; } return EventResult.reject; }
                }
            }
            Text { text: root.clock; color: white; font-size: 18px; font-weight: 800; vertical-alignment: center; min-width: 52px; horizontal-alignment: right; }
            Rectangle {
                width: 42px; height: 42px; y: (parent.height - 42px) / 2; border-radius: 21px;
                background: gear-ta.has-hover ? #ffffff2a : #00000066;
                border-width: 1px; border-color: #ffffff14;
                Image { source: @image-url("../assets/icons/settings.svg"); width: 20px; height: 20px; x: 11px; y: 11px; colorize: white; }
                gear-ta := TouchArea { mouse-cursor: pointer; clicked => { root.go-settings(); } }
            }
        }

        // Mis juegos / Explorar: always in the middle, whatever the bar holds.
        Rectangle {
                x: (parent.width - 260px) / 2; width: 260px; height: 42px; y: 15px; border-radius: 21px; background: #00000066;
                border-width: 1px; border-color: #ffffff14;
                Rectangle { x: root.library-tab ? 4px : 130px; y: 4px; width: 126px; height: 34px; border-radius: 17px; background: white;
                            drop-shadow-blur: 8px; drop-shadow-color: #00000055;
                            animate x { duration: 200ms; easing: ease-out; } }
                Text { x: 4px; y: 4px; width: 126px; height: 34px; text: "Mis juegos"; font-size: 14px; font-weight: 900;
                       color: root.library-tab ? #15161a : #ffffffcc; horizontal-alignment: center; vertical-alignment: center; }
                Text { x: 130px; y: 4px; width: 126px; height: 34px; text: "Explorar"; font-size: 14px; font-weight: 900;
                       color: !root.library-tab ? #15161a : #ffffffcc; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { mouse-cursor: pointer;
                    clicked => { root.library-tab = !root.library-tab; root.home-level = 0; root.refresh(); root.nav-push(); home.focus(); } }
            }

        // ── Empty state ──
        if root.home-systems.length == 0: VerticalLayout {
            x: 0; y: 72px; width: parent.width; height: parent.height - 130px;
            alignment: center; spacing: 14px;
            Text { text: root.search-text != "" ? "No hay nada con ese nombre" : "Todavía no tienes juegos"; color: white; font-size: 30px; font-weight: 900; horizontal-alignment: center; }
            Text { text: root.search-text != "" ? "Prueba con otra búsqueda." : "Pasa a Explorar y elige uno para descargarlo."; color: #ffffffaa; font-size: 16px; horizontal-alignment: center; }
            if root.library-tab && root.search-text == "": HorizontalLayout { alignment: center; padding-top: 10px;
                PillBtn { label: "Explorar"; kind: "primary"; clicked => { root.library-tab = false; root.refresh(); home.focus(); } } }
        }

        // ── Level 0: consoles ──
        // Entering: the cards fan out from the centre while fading in (t 0→1).
        if root.home-systems.length > 0: Rectangle {
            visible: home.lv < 0.5;
            opacity: clamp(1 - home.lv * 2, 0, 1);
            x: -home.lv * 120px * home.k; y: 72px * home.kb; width: parent.width; height: parent.height - 72px * home.kb - 56px * home.kb;
            property <float> t: 1;
            property <length> sel-w: 350px * home.k;
            property <length> sel-h: 226px * home.k;
            property <length> mid: self.height * 0.40 - 40px * home.k;
            property <length> step: 270px * home.k;
            property <float> pos: root.home-sys;     // follows the selection smoothly
            animate pos { duration: 200ms; easing: cubic-bezier(0.25, 0.8, 0.25, 1); }
            for s[i] in root.home-systems: Rectangle {
                property <bool> sel: i == root.home-sys;
                property <float> d: i - parent.pos;
                // Size follows the slide (no separate zoom): full at the
                // selection, small one step away.
                property <float> grow: clamp(1 - Math.abs(self.d), 0, 1);
                property <float> cs: self.width / (350px * home.k);   // card scale for its text
                property <length> tx: root.width / 2 - self.width / 2 + self.d * parent.step + clamp(self.d, -1, 1) * 55px * home.k;
                width: 240px * home.k + (parent.sel-w - 240px * home.k) * self.grow;
                height: 156px * home.k + (parent.sel-h - 156px * home.k) * self.grow;
                x: root.width / 2 - self.width / 2 + (self.tx - (root.width / 2 - self.width / 2)) * parent.t;
                y: parent.mid - self.height / 2 + (1 - parent.t) * 30px * home.k;
                visible: Math.abs(self.d) <= 5.5;
                // Dimmed with a veil, not `opacity`: opacity renders the whole
                // card into a layer on every frame of the slide (half the fps).
                property <float> dim: sel || sys-ta.has-hover ? 0 : 1 - max(0.45, 1 - Math.abs(self.d) * 0.28);
                SoftShadow { x: 0; y: 0; width: parent.width; height: parent.height; radius: 28px * home.k;
                             spread: (sel ? 26px : 12px) * home.k; dy: 8px * home.k; strength: sel ? 1.6 : 1.0; }
                if sel: Rectangle { x: -14px * home.k; y: -14px * home.k; width: parent.width + 28px * home.k; height: parent.height + 28px * home.k;
                    border-radius: 42px * home.k; border-width: 6px * home.k; border-color: home.cyan.with-alpha(0.16); }
                if sel: Rectangle { x: -8px * home.k; y: -8px * home.k; width: parent.width + 16px * home.k; height: parent.height + 16px * home.k;
                    border-radius: 36px * home.k; border-width: 5px * home.k; border-color: home.cyan.with-alpha(home.pulse); }
                // Hover (mouse): a faint ring on the cards that aren't selected.
                if !sel && sys-ta.has-hover: Rectangle { x: -6px * home.k; y: -6px * home.k; width: parent.width + 12px * home.k; height: parent.height + 12px * home.k;
                    border-radius: 34px * home.k; border-width: 3px * home.k; border-color: #ffffff55; }
                Rectangle {
                    border-radius: 28px * home.k; clip: true;
                    // Deep tint of the console's own colour, fading to night on the right.
                    background: @linear-gradient(120deg, s.color.mix(#101114, 0.55) 0%, s.color.mix(#101114, 0.25) 55%, #101114 100%);
                    border-width: 1px; border-color: sel ? s.color.with-alpha(0.6) : #ffffff1a;
                    // A fan of its games coming out of the right edge.
                    for c[j] in s.covers: Rectangle {
                        property <length> h: parent.height * 0.82;
                        width: self.h * 0.72; height: self.h;
                        x: parent.width * 0.52 + j * parent.width * 0.14;
                        y: parent.height * 0.34 - j * parent.height * 0.05 + (sel ? 0px : 8px * home.k);
                        transform-rotation: (j * 8 - 6) * 1deg;
                        border-radius: 9px * home.k; clip: true; background: #2a2c33;
                        border-width: 1px; border-color: #ffffff22;

                        Image { width: 100%; height: 100%; source: c.cover; image-fit: cover; }
                    }
                    // Keeps the logo readable over the art.
                    Rectangle { background: @linear-gradient(90deg, s.color.mix(#101114, 0.5) 0%, s.color.mix(#101114, 0.42).with-alpha(0.8) 40%, #10111400 70%); }
                    Rectangle { x: 0; y: parent.height - 5px * home.k; width: parent.width; height: 5px * home.k; background: s.color; opacity: sel ? 1.0 : 0.6; }
                    if s.has-logo: Image { source: s.logo; x: parent.width * 0.08; y: parent.height * 0.27;
                                           width: parent.width * 0.48; height: parent.height * 0.42; image-fit: contain;
                                           horizontal-alignment: left; }
                    if !s.has-logo: Text { x: parent.width * 0.08; y: parent.height * 0.16; width: parent.width * 0.5; height: parent.height * 0.44;
                                           text: s.is-recent ? "Jugados recientemente" : s.name; color: white; font-size: 25px * home.k * cs; font-weight: 900;
                                           wrap: word-wrap; vertical-alignment: center; }
                    if s.is-recent: Text { x: parent.width * 0.08; y: parent.height * 0.66; width: parent.width * 0.5;
                           text: "Vuelve a lo último";
                           color: #ffffffbb; font-size: 14px * home.k * cs; font-weight: 800; overflow: elide; }
                    if dim > 0.01: Rectangle { background: #15161a; opacity: dim; }
                }
                sys-ta := TouchArea { mouse-cursor: pointer; clicked => { root.home-pick-system(i); home.focus(); } }
            }
            Text { x: 0; y: parent.mid + parent.sel-h / 2 + 28px * home.k; width: parent.width; text: root.home-systems[root.home-sys].name;
                   color: white; font-size: 34px * home.k; font-weight: 900; horizontal-alignment: center; opacity: parent.t; }
            Text { x: 0; y: parent.mid + parent.sel-h / 2 + 76px * home.k; width: parent.width; horizontal-alignment: center; color: #ffffffaa;
                   font-size: 16px * home.k; font-weight: 600; opacity: parent.t;
                   text: root.home-systems[root.home-sys].is-recent
                         ? "Tus últimas partidas, con el tiempo que llevas"
                         : root.library-tab
                         ? (root.home-systems[root.home-sys].count == 1 ? "1 juego" : "\{root.home-systems[root.home-sys].count} juegos")
                         : "\{root.home-systems[root.home-sys].count} juegos · \{root.home-systems[root.home-sys].installed} en tu biblioteca"; }
            // A peek at what's inside
            HorizontalLayout {
                x: 0; y: parent.mid + parent.sel-h / 2 + 120px * home.k + (1 - parent.t) * 20px; width: parent.width; height: 96px * home.k;
                alignment: center; spacing: 12px * home.k; opacity: parent.t;
                // Click one: straight into the console with that game selected.
                for c[pi] in root.home-preview: Rectangle {
                    width: 96px * home.k * Math.min(1.4, Math.max(0.6, c.aspect)); height: 96px * home.k; border-radius: 10px * home.k; clip: true; background: #2a2c33;
                    opacity: pv-ta.has-hover ? 1.0 : 0.85;
                    border-width: pv-ta.has-hover ? 3px : 0px; border-color: white;
                    Cover { width: 100%; height: 100%; source: c.cover; title: c.title; fit-cover: c.fit-cover; }
                    pv-ta := TouchArea { mouse-cursor: pointer; clicked => { root.home-pick-preview(pi); home.focus(); } }
                }
            }
        }

        // ── Level 1: games of the console, ES-DE style ──
        // A list of titles on the left; on the right the selected game: its
        // logo, box, a screenshot, facts, description and the buttons. Its
        // fanart (or screenshot) fills the background, dimmed.
        lv1 := Rectangle {
            visible: home.lv > 0.5;
            opacity: clamp(home.lv * 2 - 1, 0, 1);
            x: (1 - home.lv) * 120px * home.k; y: 72px * home.kb; width: parent.width; height: parent.height - 72px * home.kb - 56px * home.kb;
            property <float> t: 1;
            // Console header: back to consoles, position
            HorizontalLayout {
                x: 30px; y: 6px; width: parent.width - 60px; height: 40px * home.kb; spacing: 14px;
                IconCircle { size: 40px * home.kb; icon: @image-url("../assets/icons/back.svg"); clicked => { root.home-key("b"); home.focus(); } }
                if root.home-systems[root.home-sys].has-logo: Image { source: root.home-systems[root.home-sys].logo; height: 28px * home.kb; width: 170px * home.kb;
                    image-fit: contain; horizontal-alignment: left; y: 6px * home.kb; }
                if !root.home-systems[root.home-sys].has-logo: Text { text: root.home-systems[root.home-sys].name; color: white; font-size: 18px * home.kb;
                    font-weight: 900; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: "\{root.home-game + 1} de \{root.home-games.length}"; color: #ffffff99; font-size: 14px * home.kb; font-weight: 700; vertical-alignment: center; }
            }

            // ── The list ──
            list := Rectangle {
                x: 30px; y: 62px * home.kb; width: clamp(parent.width * 0.3, 300px, 560px * home.k); height: parent.height - 62px * home.kb - 10px;
                border-radius: 18px * home.k; background: #0d0e11b0; clip: true;
                border-width: 1px; border-color: #ffffff12;
                property <length> rh: 44px * home.k;
                property <int> vis: floor((self.height - 16px) / self.rh);
                property <int> n: root.home-games.length;
                // First row shown: the selection stays in the middle, except at the ends.
                property <float> top: Math.max(0, Math.min(self.n - self.vis, root.home-game - (self.vis - 1) / 2));
                property <float> scroll: self.top;
                animate scroll { duration: 140ms; easing: ease-out; }
                for c[i] in root.home-games: Rectangle {
                    property <bool> sel: i == root.home-game;
                    property <float> rel: i - list.scroll;
                    visible: self.rel > -1.5 && self.rel < list.vis + 1;
                    x: 8px; width: parent.width - 16px; height: list.rh;
                    y: 8px + self.rel * list.rh;
                    // Only the rows on screen are built (a console can hold 120 games).
                    if self.rel > -1.5 && self.rel < list.vis + 1: Rectangle {
                        border-radius: 12px * home.k;
                        background: sel ? (root.home-btn >= 0 ? #ffffff1f : home.cyan) : (row-ta.has-hover ? #ffffff14 : transparent);
                        Text { x: 16px * home.k; width: parent.width - 60px * home.k; height: 100%; vertical-alignment: center; overflow: elide;
                               text: c.title; font-size: 16px * home.k; font-weight: sel ? 900 : 600;
                               color: sel && root.home-btn < 0 ? #101114 : (sel ? white : #ffffffc4); }
                        // installed ✓ / update ↑ / downloading %
                        if c.busy: Text { x: parent.width - 52px * home.k; width: 40px * home.k; height: 100%; horizontal-alignment: right; vertical-alignment: center;
                               text: "\{Math.round(c.progress * 100)}%"; font-size: 12px * home.k; font-weight: 800;
                               color: sel && root.home-btn < 0 ? #101114 : home.cyan; }
                        if !c.busy && c.installed: Rectangle {
                            x: parent.width - 34px * home.k; y: (parent.height - self.height) / 2; width: 20px * home.k; height: self.width; border-radius: self.width / 2;
                            background: sel && root.home-btn < 0 ? #101114 : (c.update-available ? #ffd166 : #2fd3ef);
                            Image { x: parent.width * 0.2; y: parent.width * 0.2; width: parent.width * 0.6; height: parent.width * 0.6;
                                    colorize: sel && root.home-btn < 0 ? (c.update-available ? #ffd166 : #2fd3ef) : #15161a;
                                    source: c.update-available ? @image-url("../assets/icons/arrow-up.svg") : @image-url("../assets/icons/check.svg"); }
                        }
                    }
                    row-ta := TouchArea { mouse-cursor: pointer;
                        clicked => { root.home-btn = -1; if (sel) { root.home-key("a"); } else { root.home-pick-game(i); } home.focus(); } }
                }
                // Scroll position (thin bar on the right)
                if list.n > list.vis: Rectangle {
                    x: parent.width - 5px; width: 3px; border-radius: 1.5px; background: #ffffff40;
                    height: Math.max(24px, (parent.height - 16px) * list.vis / list.n);
                    y: 8px + (parent.height - 16px - self.height) * list.scroll / Math.max(1, list.n - list.vis);
                }
            }

            // ── The selected game ──
            panel := Rectangle {
                x: list.x + list.width + 44px * home.k; y: list.y; width: parent.width - self.x - 40px; height: list.height;
                // Same composition for every game, whatever its art:
                //  left column  — logo (same visual weight: same area, within
                //                 limits) and the screenshot in a fixed 16:10
                //                 frame, the box (its shape, same area) on its corner;
                //  right column — rating, facts, description;
                //  bottom       — status and buttons.
                property <length> gap: 40px * home.k;
                property <length> bottom-h: 20px * home.k + 14px * home.k + 52px * home.k;
                property <length> logo-h: min(110px * home.k, self.height * 0.15);
                property <length> over: 30px * home.k;     // the box hangs below the frame
                property <length> avail-h: self.height - self.logo-h - 20px * home.k - self.over - 28px * home.k - self.bottom-h;
                property <length> frame-w: min(self.width * 0.58, self.avail-h * 1.6);
                property <length> frame-h: self.frame-w / 1.6;
                // the whole block centred vertically in the panel
                property <length> top: max(0px, (self.height - (self.logo-h + 20px * home.k + self.frame-h + self.over + 28px * home.k + self.bottom-h)) / 2);
                property <length> frame-y: self.top + self.logo-h + 20px * home.k;
                property <float> asp: Math.min(1.45, Math.max(0.56, home.g.aspect));
                property <length> box-h: self.frame-h * 0.6 * Math.sqrt(0.7 / self.asp);
                property <length> box-w: self.box-h * self.asp;
                property <float> la: root.home-info.has-logo ? Math.max(0.4, root.home-info.logo.width / Math.max(1, root.home-info.logo.height)) : 3.2;
                property <length> lg-h: min(self.logo-h, min(self.frame-w * 0.85, self.logo-h * 0.72 * Math.sqrt(3.2 * self.la)) / self.la);
                property <length> col-x: self.frame-w + self.gap + 20px * home.k;

                if root.home-info.has-logo: Image {
                    x: 0; y: parent.top + (parent.logo-h - parent.lg-h) / 2; height: parent.lg-h; width: parent.lg-h * parent.la;
                    source: root.home-info.logo; image-fit: contain;
                }
                if !root.home-info.has-logo: Text {
                    x: 0; y: parent.top; width: parent.frame-w; height: parent.logo-h;
                    text: home.g.title; color: white; font-size: 36px * home.k; font-weight: 900;
                    wrap: word-wrap; overflow: elide; vertical-alignment: center;
                }
                // Frame: screenshot (or the box art blown up and dimmed when there is none)
                Rectangle {
                    x: 0; y: parent.frame-y; width: parent.frame-w; height: parent.frame-h;
                    SoftShadow { x: 0; y: 0; width: parent.width; height: parent.height; radius: 16px * home.k; spread: 16px * home.k; dy: 8px * home.k; strength: 1.3; }
                    Rectangle { border-radius: 16px * home.k; clip: true; background: #0b0c0f;
                        border-width: 1px; border-color: #ffffff14;
                        if root.home-info.has-shot: Image { width: 100%; height: 100%; source: root.home-info.shot; image-fit: cover; }
                        if !root.home-info.has-shot: Image { width: 100%; height: 100%; source: home.g.cover; image-fit: cover; opacity: 0.35; }
                    }
                }
                // Box on the frame's bottom-right corner
                Rectangle {
                    x: parent.frame-w - self.width + 20px * home.k;
                    y: parent.frame-y + parent.frame-h - self.height + parent.over;
                    width: parent.box-w; height: parent.box-h;
                    SoftShadow { x: 0; y: 0; width: parent.width; height: parent.height; radius: 12px * home.k; spread: 20px * home.k; dy: 10px * home.k; strength: 1.7; }
                    Rectangle { border-radius: 12px * home.k; clip: true; background: #2a2c33;
                        border-width: 1px; border-color: #ffffff22;
                        Cover { width: 100%; height: 100%; source: home.g.cover; title: home.g.title; fit-cover: home.g.fit-cover; } }
                    if home.g.busy: Rectangle { x: 0; y: parent.height - 10px; width: parent.width; height: 10px; background: #000000aa;
                        Rectangle { x: 0; width: parent.width * home.g.progress; background: home.cyan; } }
                }
                // Right column: rating, facts, description
                VerticalLayout {
                    x: parent.col-x; y: parent.frame-y; width: parent.width - parent.col-x; height: parent.frame-h + parent.over;
                    spacing: 10px * home.k;
                    if root.home-info.rating > 0: HorizontalLayout {
                        spacing: 10px * home.k; alignment: start; padding-bottom: 4px * home.k;
                        Text { text: "★"; color: #ffd166; font-size: 26px * home.k; vertical-alignment: center; }
                        Text { text: "\{round(root.home-info.rating * 10) / 10}"; color: white; font-size: 26px * home.k; font-weight: 900; vertical-alignment: center; }
                        Text { text: "/ 5"; color: #ffffff66; font-size: 16px * home.k; font-weight: 700; vertical-alignment: center; }
                    }
                    for f in root.home-info.facts: HorizontalLayout {
                        spacing: 12px * home.k;
                        Text { text: f.label; color: #ffffff77; font-size: 14px * home.k; font-weight: 700; width: 104px * home.k; vertical-alignment: center; }
                        Text { text: f.value; color: #ffffffee; font-size: 15px * home.k; font-weight: 800; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                    }
                    Rectangle { height: 6px * home.k; }
                    desc := Rectangle {
                        vertical-stretch: 1; clip: true;
                        Text { x: 0; y: 0; width: parent.width; height: parent.height;
                               text: root.home-info.desc; color: #ffffffbb; font-size: 15px * home.k; wrap: word-wrap; overflow: elide;
                               vertical-alignment: TextVerticalAlignment.top; }
                    }
                }
                // Bottom: status and buttons
                VerticalLayout {
                    x: 0; y: parent.frame-y + parent.frame-h + parent.over + 28px * home.k; width: parent.width; height: parent.bottom-h;
                    spacing: 14px * home.k;
                    Text { font-size: 15px * home.k; font-weight: 800; height: 20px * home.k;
                           color: home.g.busy ? home.cyan : (home.g.update-available ? #ffd166 : (home.g.installed ? #4de1c1 : #ffffffaa));
                           text: home.g.busy ? "Descargando… \{Math.round(home.g.progress * 100)}%"
                               : (home.g.installed
                                   ? (home.g.update-available ? "Hay una versión nueva" : (home.g.meta != "" ? home.g.meta : "Listo para jugar"))
                                   : (home.g.experimental ? "Disponible · versión de pruebas" : "Disponible para descargar"))
                                 + (home.g.versions > 1 ? " · \{home.g.versions} versiones" : ""); }
                    HorizontalLayout {
                        alignment: start; spacing: 14px * home.k;
                        // ▶ from the list walks these with the keys / gamepad
                        // (home-btn: 0 main, then «Actualizar» if shown, then «Más opciones»).
                        PillBtn { s: home.k; wide: true; kind: "primary"; focused: root.home-btn == 0;
                                  icon: home.g.installed ? @image-url("../assets/icons/play.svg") : @image-url("../assets/icons/download.svg");
                                  has-icon: !home.g.busy;
                                  label: home.g.busy ? "Descargando…" : (home.g.installed ? "Jugar" : "Descargar");
                                  clicked => { root.home-btn = -1; root.home-key("a"); home.focus(); } }
                        if home.g.installed && home.g.update-available: PillBtn { s: home.k; label: "Actualizar"; kind: "update";
                                  focused: root.home-btn == 1;
                                  icon: @image-url("../assets/icons/arrow-up.svg"); has-icon: true;
                                  clicked => { root.home-btn = -1; root.install(home.g.id); home.focus(); } }
                        PillBtn { s: home.k; label: "Más opciones"; kind: "secondary";
                                  focused: root.home-btn == (home.g.installed && home.g.update-available ? 2 : 1);
                                  clicked => { root.home-btn = -1; root.home-key("x"); } }
                    }
                }
            }
        }

        // ── «Actualizar todo»: the list of games and how each one went (on top) ──
        if root.bulk-open && root.bulk-items.length > 0: Rectangle {
            x: parent.width - self.width - 26px; y: 66px; width: 440px; height: bp-l.preferred-height;
            border-radius: 22px; background: #2c2e35; border-width: 1px; border-color: #ffffff1a;
            SoftShadow { x: 0; y: 0; width: parent.width; height: parent.height; radius: 22px; spread: 18px; strength: 1.6; }
            Rectangle { border-radius: 22px; background: #2c2e35; }
            TouchArea { }
            bp-l := VerticalLayout {
                padding: 18px; spacing: 6px;
                Text { text: root.bulk-busy ? "Actualizando tus juegos" : "Actualización terminada"; color: white; font-size: 17px; font-weight: 900; }
                if root.bulk-busy: Bar { value: root.bulk-progress; height: 8px; }
                for b in root.bulk-items: Rectangle {
                    height: 40px;
                    Text { x: 0; width: parent.width - 120px; height: 100%; text: b.title; color: b.state == 1 ? white : #ffffffcc;
                           font-size: 14px; font-weight: b.state == 1 ? 900 : 600; vertical-alignment: center; overflow: elide; }
                    Text { x: parent.width - 116px; width: 116px; height: 100%; horizontal-alignment: right; vertical-alignment: center;
                           font-size: 13px; font-weight: 800;
                           text: b.state == 0 ? "En cola" : b.state == 1 ? (b.progress > 0 ? "\{floor(b.progress * 100)}%" : "Empezando…")
                               : b.state == 2 ? "✓ Al día" : b.state == 3 ? "✕ Falló" : "Cancelado";
                           color: b.state == 1 ? #2fd3ef : b.state == 2 ? #4de1c1 : b.state == 3 ? #ff5d73 : #ffffff77; }
                }
                HorizontalLayout {
                    alignment: end; spacing: 10px; padding-top: 8px;
                    if root.bulk-busy: PillBtn { s: 0.75; label: "Cancelar"; kind: "ghost"; clicked => { root.cancel-update-all(); } }
                    if !root.bulk-busy: PillBtn { s: 0.75; label: "Cerrar"; kind: "secondary"; clicked => { root.bulk-open = false; root.bulk-dismiss(); } }
                    if root.bulk-busy: PillBtn { s: 0.75; label: "Ocultar"; kind: "secondary"; clicked => { root.bulk-open = false; } }
                }
            }
        }

        // ── Button hints (bottom) ──
        Hints {
            x: 0; y: parent.height - 54px * home.kb; width: parent.width; s: home.kb;
            keys: root.home-level == 0
                  ? [{k: "A", t: "Abrir"}, {k: "◀ ▶", t: "Elegir consola"}, {k: "F11", t: "Pantalla completa"}]
                  : root.home-btn >= 0
                    ? [{k: "A", t: "Pulsar"}, {k: "◀ ▶", t: "Elegir botón"}, {k: "B", t: "Volver a la lista"}]
                    : [{k: "A", t: home.g.installed ? "Jugar" : "Descargar"}, {k: "B", t: "Volver"}, {k: "X", t: "Más opciones"}, {k: "▲ ▼", t: "Elegir juego"}, {k: "LB RB", t: "Saltar 10"}, {k: "▶", t: "Botones"}];
        }
    }

    // ── Páginas (ficha, configuración) y vista clásica, por encima del inicio.
    // En la vista consola entran y salen con un fundido y un leve desplazamiento.
    if root.dv > 0.002 || root.sv > 0.002: Rectangle {
        x: 0; y: 0; width: root.width; height: root.height;
        background: #15161a;
        opacity: min(1, max(root.dv, root.sv) * 2.2);
    }
    if root.dv > 0.002 || root.sv > 0.002: Rectangle {
        property <float> p: max(root.dv, root.sv);
        x: 0; y: (1 - self.p) * 48px;
        width: root.width; height: root.height;
        opacity: clamp((self.p - 0.35) / 0.65, 0, 1);
        HorizontalLayout {
            // ── Main column ─────────────────────────────────────────────────
            VerticalLayout {
                // Self-update banner. Absolute geometry: nothing here can push the
                // buttons out of view, whatever the window width.
                if root.update-available: Rectangle {
                    height: 44px;
                    background: #33363e;
                    Rectangle { x: 0; width: 3px; height: 100%; background: #2fd3ef; }
                    Rectangle { y: parent.height - 1px; height: 1px; background: #3c3f48; }
                    Text {
                        x: 18px; y: 0; height: parent.height;
                        width: parent.width - 18px - (root.update-busy ? 200px : 214px);
                        text: root.update-busy ? "Actualizando Freeport…"
                              : (root.update-error ? "La actualización falló"
                                 : (root.update-notes != ""
                                    ? "Freeport v\{root.update-version} disponible · \{root.update-notes}"
                                    : "Freeport v\{root.update-version} disponible"));
                        color: white; font-size: 12px; font-weight: 700; overflow: elide; vertical-alignment: center;
                    }
                    if root.update-busy: Bar { x: parent.width - 190px; y: (parent.height - 5px) / 2; width: 176px; value: -1; }
                    if !root.update-busy: Btn { x: parent.width - 204px; y: 8px; width: 100px;
                                                label: root.update-error ? "Reintentar" : "Actualizar"; clicked => { root.do-update(); } }
                    if !root.update-busy: Btn { x: parent.width - 96px; y: 8px; width: 84px; kind: "ghost"; label: "Después";
                                                clicked => { root.dismiss-update(); } }
                }

                // ── Configuración: categorías a la izquierda, opciones a la derecha ──
                if root.settings-visible || root.sv > 0.002: settings-root := FocusScope {
                    vertical-stretch: 1;
                    property <[string]> cats: ["Juegos de Windows", "Pantalla", "Versiones de pruebas", "Cuentas", "Almacenamiento", "Actualizaciones"];
                    property <float> pulse: 1.0;   // static: a constant animation repainted the whole window 60×/s
                    property <length> body-w: max(260px, sscroll.visible-width - 40px);
                    init => { self.focus(); }
                    key-pressed(e) => {
                        if (e.text == Key.Escape || e.text == Key.Backspace) { root.settings-key("b"); return EventResult.accept; }
                        if (e.text == Key.UpArrow) { root.settings-key("up"); return EventResult.accept; }
                        if (e.text == Key.DownArrow) { root.settings-key("down"); return EventResult.accept; }
                        if (e.text == Key.F11) { root.toggle-fullscreen(!root.fullscreen); return EventResult.accept; }
                        return EventResult.reject;
                    }
                    Rectangle { background: #1b1c20; }
                    TouchArea { clicked => { settings-root.focus(); } }
                    VerticalLayout {
                        HorizontalLayout {
                            height: 64px; padding-left: 26px; padding-right: 26px; spacing: 14px;
                            IconCircle { y: 11px; icon: @image-url("../assets/icons/back.svg"); clicked => { root.settings-key("b"); } }
                            Image { source: @image-url("../assets/icons/settings.svg"); width: 24px; height: 24px; y: 20px; colorize: white; }
                            Text { text: "Configuración"; color: white; font-size: 22px; font-weight: 900; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: "Freeport \{root.version}"; color: #ffffff66; font-size: 13px; vertical-alignment: center; }
                        }
                        Rectangle { height: 1px; background: #ffffff14; }
                        HorizontalLayout {
                            vertical-stretch: 1; padding-left: 26px; padding-top: 18px; spacing: 30px;
                            // Categories
                            VerticalLayout {
                                width: 270px; spacing: 6px; alignment: start;
                                for c[i] in settings-root.cats: Rectangle {
                                    height: 54px; border-radius: 16px;
                                    background: i == root.settings-tab ? #3b3e47 : (cta.has-hover ? #ffffff0c : #00000000);
                                    if i == root.settings-tab: Rectangle { x: -4px; y: -4px; width: parent.width + 8px; height: parent.height + 8px;
                                        border-radius: 20px; border-width: 3px; border-color: #2fd3ef.with-alpha(settings-root.pulse); }
                                    Text { x: 20px; text: c; color: i == root.settings-tab ? white : #ffffffbb; font-size: 15px; font-weight: 800;
                                           height: 100%; vertical-alignment: center; }
                                    cta := TouchArea { mouse-cursor: pointer; clicked => { root.settings-tab = i; settings-root.focus(); } }
                                }
                            }
                            // Options of the category
                            sscroll := ScrollView {
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    width: sscroll.visible-width;
                                    padding-right: 30px; padding-bottom: 40px; spacing: 16px; alignment: start;

                                    if root.settings-tab == 0: VerticalLayout {
                                        spacing: 16px;
                                        Text { text: "Muchos juegos solo existen en versión de Windows. Freeport puede abrirlos igualmente con una capa de compatibilidad.";
                                               color: #ffffffaa; font-size: 14px; wrap: word-wrap; width: settings-root.body-w; }
                                        OptionPanel {
                                            SetRow { label: "Mostrar los juegos de Windows"; hint: "Aparecen en Explorar y se abren con Proton.";
                                                Toggle { checked <=> root.show-windows; y: (parent.height - 30px) / 2; toggled(v) => { root.toggle-windows(v); } } }
                                            if root.show-windows: SetRow { label: "Programa de compatibilidad"; hint: "GE-Proton es el que mejor funciona con estos juegos.";
                                                Choice { y: (parent.height - 42px) / 2; options: root.runner-labels; index <=> root.runner-index;
                                                         selected(v) => { root.current-runner-label = v; root.set-runner(v); } } }
                                        }
                                    }

                                    if root.settings-tab == 1: OptionPanel {
                                        SetRow { label: "Pantalla completa"; hint: "También con la tecla F11.";
                                            Toggle { checked: root.fullscreen; y: (parent.height - 30px) / 2; toggled(v) => { root.toggle-fullscreen(v); } } }
                                        SetRow { label: "Efecto de televisor antiguo"; hint: "Líneas de barrido sobre toda la pantalla.";
                                            Toggle { checked <=> root.crt-visible; y: (parent.height - 30px) / 2; toggled(v) => { root.toggle-crt(v); } } }
                                    }

                                    if root.settings-tab == 2: VerticalLayout {
                                        spacing: 16px;
                                        Text { text: "Juegos recién publicados o de un solo autor: pueden cerrarse o fallar. Elige en qué consolas quieres verlos.";
                                               color: #ffffffaa; font-size: 14px; wrap: word-wrap; width: settings-root.body-w; }
                                        OptionPanel {
                                            SetRow { label: "Todas las consolas"; hint: "Activa o quita las versiones de pruebas en todas a la vez.";
                                                Toggle { checked <=> root.exp-all-on; y: (parent.height - 30px) / 2; toggled(v) => { root.set-all-experimental(v); } } }
                                        }
                                        OptionPanel {
                                            for sys in root.settings-systems: SysToggleRow { sys: sys; toggled(v) => { root.toggle-experimental-system(sys.id, v); } }
                                            for sys in root.settings-systems-b: SysToggleRow { sys: sys; toggled(v) => { root.toggle-experimental-system(sys.id, v); } }
                                        }
                                    }

                                    if root.settings-tab == 3: VerticalLayout {
                                        spacing: 22px;
                                        VerticalLayout {
                                            spacing: 10px;
                                            Text { text: "RetroAchievements"; color: white; font-size: 18px; font-weight: 900; }
                                            Text { text: "Logros en los juegos compatibles. Freeport no guarda tu contraseña."; color: #ffffffaa; font-size: 14px; wrap: word-wrap; width: settings-root.body-w; }
                                            OptionPanel {
                                                if root.ra-logged-in: SetRow { label: root.ra-status;
                                                    PillBtn { y: 10px; label: "Cerrar sesión"; kind: "ghost"; clicked => { root.ra-logout(); } } }
                                                if !root.ra-logged-in: VerticalLayout {
                                                    padding: 16px; spacing: 10px;
                                                    ra-user := Field { placeholder: "Usuario"; }
                                                    ra-pass := Field { placeholder: "Contraseña"; password: true; }
                                                    HorizontalLayout { spacing: 12px; alignment: start;
                                                        PillBtn { label: "Iniciar sesión"; kind: "primary"; clicked => { root.ra-login(ra-user.text, ra-pass.text); } }
                                                        Text { text: root.ra-status; color: #ffd166; font-size: 13px; vertical-alignment: center; wrap: word-wrap; } }
                                                }
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 10px;
                                            Text { text: "RomM (tu servidor de juegos)"; color: white; font-size: 18px; font-weight: 900; }
                                            Text { text: "Si tienes tus copias en RomM, cada juego ofrece «Traer de RomM» y Freeport lo deja listo."; color: #ffffffaa; font-size: 14px; wrap: word-wrap; width: settings-root.body-w; }
                                            OptionPanel {
                                                if root.romm-connected: SetRow { label: root.romm-status;
                                                    PillBtn { y: 10px; label: "Desconectar"; kind: "ghost"; clicked => { root.romm-forget(); } } }
                                                if !root.romm-connected: VerticalLayout {
                                                    padding: 16px; spacing: 10px;
                                                    romm-url-e := Field { placeholder: "Dirección, p. ej. http://192.168.1.10:8080"; text: root.romm-url; }
                                                    HorizontalLayout { spacing: 10px;
                                                        romm-user-e := Field { placeholder: "Usuario"; text: root.romm-user; }
                                                        romm-pass-e := Field { placeholder: "Contraseña"; password: true; } }
                                                    HorizontalLayout { spacing: 12px; alignment: start;
                                                        PillBtn { label: "Conectar"; kind: "primary"; clicked => { root.romm-connect(romm-url-e.text, romm-user-e.text, romm-pass-e.text); } }
                                                        Text { text: root.romm-status; color: #ffd166; font-size: 13px; vertical-alignment: center; wrap: word-wrap; } }
                                                }
                                            }
                                        }
                                    }

                                    if root.settings-tab == 4: VerticalLayout {
                                        spacing: 16px;
                                        Text { text: root.disk-total != "" ? "Tus juegos ocupan \{root.disk-total}." : "Todavía no hay juegos instalados.";
                                               color: white; font-size: 20px; font-weight: 900; }
                                        Text { text: "Pulsa una consola para ver sus juegos y eliminarlos."; color: #ffffffaa; font-size: 14px; }
                                        OptionPanel {
                                            for d[i] in root.disk-rows: VerticalLayout {
                                                Rectangle {
                                                    height: 64px;
                                                    background: dk-ta.has-hover ? #ffffff08 : #00000000;
                                                    if i > 0: Rectangle { x: 16px; y: 0; width: parent.width - 32px; height: 1px; background: #ffffff12; }
                                                    if d.has-logo: Image { x: 18px; y: 20px; source: d.logo; width: 110px; height: 24px; image-fit: contain; horizontal-alignment: left; }
                                                    if !d.has-logo: Text { x: 18px; text: d.name; color: white; font-size: 14px; font-weight: 800; height: 100%; vertical-alignment: center; }
                                                    Text { x: 146px; y: 12px; text: d.count == 1 ? "1 juego" : "\{d.count} juegos"; color: #ffffffaa; font-size: 13px; }
                                                    Rectangle { x: 146px; y: 36px; width: parent.width - 146px - 150px; height: 8px; border-radius: 4px; background: #ffffff14;
                                                        Rectangle { x: 0; width: parent.width * d.frac; border-radius: 4px; background: #2fd3ef; } }
                                                    Text { x: parent.width - 138px; width: 90px; text: d.size; color: white; font-size: 15px; font-weight: 800;
                                                           height: 100%; vertical-alignment: center; horizontal-alignment: right; }
                                                    Text { x: parent.width - 38px; width: 24px; height: 100%; vertical-alignment: center; horizontal-alignment: center;
                                                           text: root.expanded-sys == d.id ? "▲" : "▼"; color: #ffffff88; font-size: 12px; }
                                                    dk-ta := TouchArea { mouse-cursor: pointer;
                                                        clicked => { root.expanded-sys = root.expanded-sys == d.id ? "" : d.id; } }
                                                }
                                                if root.expanded-sys == d.id: VerticalLayout {
                                                    padding-left: 146px; padding-right: 16px; padding-bottom: 10px;
                                                    for g in d.games: Rectangle {
                                                        height: 52px;
                                                        Rectangle { x: 0; y: 0; width: parent.width; height: 1px; background: #ffffff0c; }
                                                        Text { x: 0; y: 8px; width: parent.width - 260px; text: g.title; color: white; font-size: 14px; font-weight: 800; overflow: elide; }
                                                        Text { x: 0; y: 28px; width: parent.width - 260px; text: g.version != "" ? "Versión \{g.version}" : "";
                                                               color: #ffffff77; font-size: 12px; overflow: elide; }
                                                        Text { x: parent.width - 250px; width: 100px; height: 100%; text: g.size != "" ? g.size : "…";
                                                               color: #ffffffcc; font-size: 14px; font-weight: 800; vertical-alignment: center; horizontal-alignment: right; }
                                                        PillBtn { x: parent.width - self.width; y: (parent.height - self.height) / 2; s: 0.7; label: "Eliminar"; kind: "ghost";
                                                                  clicked => { root.confirm-uninstall(g.id); } }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    if root.settings-tab == 5: VerticalLayout {
                                        spacing: 16px;
                                        OptionPanel {
                                            SetRow { label: "Freeport \{root.version}";
                                                hint: root.update-available ? "Hay una versión nueva: \{root.update-version}." : "Se actualiza solo cuando sale una versión nueva.";
                                                if root.update-available: PillBtn { y: 10px; label: root.update-busy ? "Actualizando…" : "Instalar ahora"; kind: "primary";
                                                                                     clicked => { if (!root.update-busy) { root.do-update(); } } }
                                                if !root.update-available: PillBtn { y: 10px; label: "Buscar ahora"; kind: "secondary"; clicked => { root.check-updates(); } } }
                                            SetRow { label: "Lista de juegos"; hint: "Se descarga sola al abrir Freeport.";
                                                PillBtn { y: 10px; label: root.catalog-busy ? "Actualizando…" : "Actualizar ahora"; kind: "secondary";
                                                          clicked => { if (!root.catalog-busy) { root.refresh-catalog(); } } } }
                                        }
                                        if root.settings-msg != "": Text { text: root.settings-msg; color: #2fd3ef; font-size: 14px; font-weight: 700; wrap: word-wrap; width: settings-root.body-w; }
                                    }
                                }
                            }
                        }
                        Hints { keys: [{k: "▲ ▼", t: "Elegir"}, {k: "B", t: "Volver"}]; }
                    }
                }

                // ── Game page: console style (cover, plain status, big buttons, tabs) ──
                if !root.settings-visible && (root.detail-visible || root.dv > 0.002): detail-root := FocusScope {
                    vertical-stretch: 1;
                    property <length> body-w: max(240px, dscroll.visible-width - 80px);
                    property <string> tab: root.detail.tabs.length > 0
                        ? root.detail.tabs[min(root.detail-tab, root.detail.tabs.length - 1)].key : "";
                    property <float> pulse: 1.0;   // static: a constant animation repainted the whole window 60×/s
                    init => { self.focus(); }
                    key-pressed(e) => {
                        if (e.text == Key.Escape || e.text == Key.Backspace) { root.detail-key("b"); return EventResult.accept; }
                        if (e.text == Key.Return) { root.detail-key("a"); return EventResult.accept; }
                        if (e.text == Key.LeftArrow) { root.detail-key("left"); return EventResult.accept; }
                        if (e.text == Key.RightArrow) { root.detail-key("right"); return EventResult.accept; }
                        if (e.text == Key.F11) { root.toggle-fullscreen(!root.fullscreen); return EventResult.accept; }
                        return EventResult.reject;
                    }
                    Rectangle { background: #1b1c20; }
                    Image { x: 0; y: 0; source: root.detail.cover; width: parent.width; height: parent.height * 0.66; image-fit: cover; opacity: 0.16; }
                    Rectangle { x: 0; y: 0; width: parent.width; height: parent.height * 0.66 + 1px;
                                background: @linear-gradient(180deg, root.detail.sys-color.with-alpha(0.38) 0%, #1b1c2000 35%, #1b1c20 100%); }
                    TouchArea { clicked => { detail-root.focus(); } }
                    VerticalLayout {
                        // ── Top bar: back, console logo ──
                        HorizontalLayout {
                            height: 64px; padding-left: 26px; padding-right: 26px; spacing: 14px;
                            IconCircle { y: 11px; icon: @image-url("../assets/icons/back.svg"); clicked => { root.close-detail(); } }
                            if root.detail.has-sys-logo: Image { source: root.detail.sys-logo; height: 28px; width: 170px; y: 18px;
                                                                 image-fit: contain; horizontal-alignment: left; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        dscroll := ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                width: dscroll.visible-width;
                                padding-left: 40px; padding-right: 40px; padding-top: 6px; padding-bottom: 40px;
                                spacing: 28px;
                                alignment: start;

                                // ── Hero: box, title, status, buttons ──
                                HorizontalLayout {
                                    spacing: 38px; alignment: start;
                                    Rectangle {
                                        property <float> a: root.detail.aspect > 0 ? root.detail.aspect : 0.667;
                                        width: min(360px, 300px * self.a);
                                        height: self.width / self.a;
                                        border-radius: 16px; clip: true; background: #2c2e35;
                                        border-width: 1px; border-color: #ffffff14;
                                        Cover { width: 100%; height: 100%; source: root.detail.cover; title: root.detail.title; fit-cover: root.detail.fit-cover; }
                                    }
                                    VerticalLayout {
                                        alignment: center; spacing: 12px; horizontal-stretch: 1;
                                        Text { text: root.detail.title; font-size: 34px; font-weight: 900; color: white; wrap: word-wrap; }
                                        if root.detail.has-versions: Text { text: "Versión: \{root.detail.subtitle}"; font-size: 15px; color: #ffffffaa; }
                                        Text { text: root.detail.status; font-size: 16px; font-weight: 700; color: root.detail.status-color; wrap: word-wrap; }
                                        if root.detail.stats != "": Text { text: root.detail.stats; font-size: 13px; color: #ffffff88; }
                                        if root.detail.busy: HorizontalLayout {
                                            spacing: 16px; alignment: start; padding-top: 8px;
                                            VerticalLayout {
                                                width: 360px; spacing: 8px; alignment: center;
                                                Text { text: root.detail.phase != ""
                                                           ? (root.detail.progress > 0 ? "\{root.detail.phase} \{floor(root.detail.progress * 100)}%" : root.detail.phase)
                                                           : root.detail.installed
                                                           ? (root.detail.progress > 0 ? "Actualizando \{floor(root.detail.progress * 100)}%" : "Actualizando…")
                                                           : (root.detail.progress > 0 ? "Descargando \{floor(root.detail.progress * 100)}%" : "Descargando…");
                                                       color: #2fd3ef; font-size: 15px; font-weight: 800; wrap: word-wrap; }
                                                Bar { value: root.detail.progress > 0 ? root.detail.progress : -1; height: 10px; }
                                            }
                                            PillBtn { label: "Cancelar"; kind: "ghost"; clicked => { root.cancel-install(root.detail.id); } }
                                        }
                                        if !root.detail.busy: HorizontalLayout {
                                            spacing: 12px; alignment: start; padding-top: 10px;
                                            PillBtn {
                                                kind: root.detail.play-state == 2 || root.detail.install-error ? "danger" : "primary"; wide: true;
                                                label: root.detail.installed
                                                    ? (root.detail.play-state == 1 ? "Abriendo…" : (root.detail.play-state == 2 ? "Reintentar" : "Jugar"))
                                                    : (root.detail.install-error ? "Reintentar" : "Descargar");
                                                has-icon: root.detail.play-state == 0 && !root.detail.install-error;
                                                icon: root.detail.installed ? @image-url("../assets/icons/play.svg") : @image-url("../assets/icons/download.svg");
                                                clicked => { root.detail-key("a"); }
                                            }
                                            if root.detail.installed && root.detail.update-available: PillBtn {
                                                label: "Actualizar"; kind: "update"; has-icon: true; icon: @image-url("../assets/icons/arrow-up.svg");
                                                clicked => { root.install(root.detail.id); } }
                                            if root.detail.installed && root.detail.add-game-kind != "": PillBtn {
                                                label: root.detail.add-game-label; kind: root.detail.rom-ok ? "secondary" : "attention";
                                                clicked => {
                                                    if (root.detail.add-game-kind == "rom") { root.pick-rom(root.detail.id); }
                                                    if (root.detail.add-game-kind == "pkg") { root.import-pkg(root.detail.id); }
                                                    if (root.detail.add-game-kind == "switch") { root.import-switch(root.detail.id); }
                                                } }
                                            if root.detail.installed && root.romm-connected: PillBtn {
                                                label: "Traer de RomM"; kind: "secondary"; clicked => { root.romm-search(root.detail.id); } }
                                        }
                                    }
                                }

                                // ── Versions of the same game ──
                                if root.detail.has-versions: VerticalLayout {
                                    spacing: 12px;
                                    Text { text: "Versiones de este juego"; color: white; font-size: 17px; font-weight: 800; }
                                    HorizontalLayout {
                                        spacing: 12px; alignment: start;
                                        for v in root.detail.versions: Rectangle {
                                            height: 64px; width: max(200px, vl.preferred-width + 36px); border-radius: 18px;
                                            background: v.active ? #3b3e47 : (vta.has-hover ? #ffffff14 : #2c2e35);
                                            border-width: v.active ? 3px : 0px;
                                            border-color: #2fd3ef.with-alpha(detail-root.pulse);
                                            vl := VerticalLayout {
                                                x: 18px; width: parent.width - 36px; alignment: center; spacing: 2px;
                                                Text { text: v.name; color: white; font-size: 15px; font-weight: 800; }
                                                Text { text: (v.installed ? "Instalada" : "Sin instalar") + (v.is-windows ? " · versión de Windows" : "");
                                                       color: v.installed ? #4de1c1 : #ffffff88; font-size: 12px; }
                                            }
                                            vta := TouchArea { mouse-cursor: pointer; clicked => { if (!v.active) { root.open-game(v.id); } } }
                                        }
                                    }
                                    if root.detail.default-labels.length > 1: HorizontalLayout {
                                        spacing: 8px; alignment: start;
                                        Text { text: "Al pulsar Jugar desde la portada:"; color: #ffffffaa; font-size: 13px; vertical-alignment: center; }
                                        for l[i] in root.detail.default-labels: Rectangle {
                                            height: 34px; width: dl.preferred-width + 26px; border-radius: 17px;
                                            background: i == root.detail.default-index ? white : (dla.has-hover ? #ffffff22 : #ffffff12);
                                            dl := Text { text: l; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center;
                                                         color: i == root.detail.default-index ? #1b1c20 : white; font-size: 13px; font-weight: 700; }
                                            dla := TouchArea { mouse-cursor: pointer; clicked => { root.set-default-version(root.detail.id, i); } }
                                        }
                                    }
                                }

                                // ── Section tabs ──
                                HorizontalLayout {
                                    spacing: 10px; alignment: start;
                                    for t[i] in root.detail.tabs: Rectangle {
                                        height: 42px; width: tl.preferred-width + 34px; border-radius: 21px;
                                        background: i == root.detail-tab ? white : (tta.has-hover ? #ffffff22 : #ffffff12);
                                        animate background { duration: 140ms; }
                                        tl := Text { text: t.label; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center;
                                                     color: i == root.detail-tab ? #1b1c20 : white; font-size: 14px; font-weight: 800; }
                                        tta := TouchArea { mouse-cursor: pointer; clicked => { root.detail-tab = i; detail-root.focus(); } }
                                    }
                                }

                                // ── Información ──
                                if detail-root.tab == "info": VerticalLayout {
                                    spacing: 22px;
                                    if root.detail.about != "": Text { text: root.detail.about; color: #ffffffdd; font-size: 15px; wrap: word-wrap; width: detail-root.body-w; }
                                    Rectangle {
                                        border-radius: 18px; background: #2a2c33;
                                        VerticalLayout {
                                            padding: 8px;
                                            for f[i] in root.detail.facts: Rectangle {
                                                height: 46px;
                                                if i > 0: Rectangle { x: 16px; y: 0; width: parent.width - 32px; height: 1px; background: #ffffff12; }
                                                HorizontalLayout {
                                                    padding-left: 16px; padding-right: 16px;
                                                    Text { text: f.label; color: #ffffffaa; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                                                    Text { text: f.value; color: f.accent; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                                }
                                            }
                                        }
                                    }
                                    if root.detail.has-related: VerticalLayout {
                                        spacing: 12px;
                                        Text { text: "Más juegos de esta consola"; color: white; font-size: 17px; font-weight: 800; }
                                        ScrollView {
                                            height: 214px;
                                            HorizontalLayout {
                                                spacing: 14px; alignment: start;
                                                for r in root.detail.related: Rectangle {
                                                    width: clamp(170px * (r.aspect > 0 ? r.aspect : 0.667), 100px, 240px); height: 206px;
                                                    Rectangle { height: 170px; border-radius: 12px; clip: true; background: #2c2e35;
                                                        Cover { width: 100%; height: 100%; source: r.cover; title: r.title; hovered: rta.has-hover; fit-cover: r.fit-cover; }
                                                        rta := TouchArea { mouse-cursor: pointer; clicked => { root.open-game(r.id); } } }
                                                    Text { y: 178px; width: parent.width; text: r.title; color: #ffffffcc; font-size: 12px; overflow: elide; }
                                                }
                                            }
                                        }
                                    }
                                }

                                // ── Cómo se instala ──
                                if detail-root.tab == "setup": Rectangle {
                                    border-radius: 18px; background: #2a2c33;
                                    VerticalLayout {
                                        padding: 24px; spacing: 10px;
                                        Text { text: "Qué necesitas y cómo se prepara"; color: #2fd3ef; font-size: 16px; font-weight: 800; }
                                        Text { text: root.detail.port-notes; color: #ffffffdd; font-size: 14px; wrap: word-wrap; width: detail-root.body-w - 48px; }
                                    }
                                }

                                // ── Novedades ──
                                if detail-root.tab == "news": Rectangle {
                                    border-radius: 18px; background: #2a2c33;
                                    VerticalLayout {
                                        padding: 24px; spacing: 10px;
                                        if root.detail.last-updated != "": Text { text: root.detail.last-updated; color: #2fd3ef; font-size: 14px; font-weight: 800; }
                                        Text { text: root.detail.changelog; color: #ffffffdd; font-size: 14px; wrap: word-wrap; width: detail-root.body-w - 48px; }
                                    }
                                }

                                // ── Capturas ──
                                if detail-root.tab == "screens": ScrollView {
                                    height: 236px;
                                    HorizontalLayout {
                                        spacing: 14px; alignment: start;
                                        for s in root.detail.screens: Rectangle {
                                            width: 400px; height: 225px; border-radius: 14px; clip: true; background: #2c2e35;
                                            Image { source: s.img; width: 100%; height: 100%; image-fit: cover; }
                                            TouchArea { mouse-cursor: pointer; clicked => { root.viewer-image = s.img; root.viewer-visible = true; } }
                                        }
                                    }
                                }

                                // ── Logros ──
                                if detail-root.tab == "ra": VerticalLayout {
                                    spacing: 14px;
                                    Text { text: root.detail.ra-summary; color: #2fd3ef; font-size: 16px; font-weight: 800; }
                                    for row in root.detail.badge-rows: HorizontalLayout {
                                        spacing: 8px; alignment: start;
                                        for b in row: Rectangle {
                                            width: 52px; height: 52px; border-radius: 10px; clip: true; background: #2a2c33;
                                            opacity: b.unlocked ? 1.0 : 0.35;
                                            if b.has-img: Image { source: b.img; width: 100%; height: 100%; image-fit: cover; }
                                            if !b.has-img: Text { text: "?"; color: #ffffff44; font-size: 18px; width: 100%; height: 100%;
                                                                  horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                }

                                // ── Mods ──
                                if detail-root.tab == "mods": VerticalLayout {
                                    spacing: 10px;
                                    for m in root.detail.mods: Rectangle {
                                        height: 84px; border-radius: 18px; background: #2a2c33;
                                        border-width: m.installed ? 2px : 0px; border-color: #4de1c166;
                                        HorizontalLayout {
                                            padding: 12px; spacing: 14px;
                                            Rectangle { width: 60px; height: 60px; border-radius: 12px; background: #33363e; clip: true;
                                                if m.has-icon: Image { source: m.icon; width: 100%; height: 100%; image-fit: cover; }
                                                if !m.has-icon: Text { text: "◈"; font-size: 26px; color: #ffffff66; width: 100%; height: 100%;
                                                                       horizontal-alignment: center; vertical-alignment: center; } }
                                            VerticalLayout {
                                                horizontal-stretch: 1; spacing: 3px; alignment: center;
                                                Text { text: m.name + (m.installed ? "  ·  instalado" : ""); color: white; font-weight: 800; font-size: 15px; overflow: elide; }
                                                if !m.busy: Text { text: m.description; color: #ffffff99; font-size: 12px; overflow: elide; }
                                                if m.busy: Bar { value: m.progress > 0 ? m.progress : -1; height: 8px; }
                                            }
                                            if !m.busy && m.update: PillBtn { y: 6px; label: "Actualizar"; kind: "update"; clicked => { root.install-mod(root.detail.id, m.full-name); } }
                                            if !m.busy && m.installed && !m.update: PillBtn { y: 6px; label: "Quitar"; kind: "ghost"; clicked => { root.uninstall-mod(root.detail.id, m.full-name); } }
                                            if !m.busy && !m.installed: PillBtn { y: 6px; label: "Añadir"; kind: "secondary"; clicked => { root.install-mod(root.detail.id, m.full-name); } }
                                        }
                                    }
                                }

                                // ── Opciones ──
                                if detail-root.tab == "more": Rectangle {
                                    border-radius: 18px; background: #2a2c33;
                                    VerticalLayout {
                                        padding: 8px;
                                        if root.detail.installed: OptionRow { label: "Abrir la carpeta del juego"; clicked => { root.open-folder(root.detail.id); } }
                                        if root.detail.installed: OptionRow { label: "Añadir a Steam"; hint: "Aparece en tu biblioteca de Steam y en el modo Big Picture.";
                                                                              clicked => { root.add-steam(root.detail.id); } }
                                        if root.detail.installed && root.detail.ra-eligible && root.ra-logged-in: OptionRow {
                                            label: "Logros de RetroAchievements" + (root.detail.ra-beta ? " (beta)" : "");
                                            value: root.detail.ra-enabled ? "Activados" : "Desactivados";
                                            clicked => { root.toggle-ra(root.detail.id, !root.detail.ra-enabled); } }
                                        if root.detail.repo-url != "": OptionRow { label: "Ver la página del proyecto"; hint: root.detail.repo-url;
                                                                                   clicked => { root.open-url(root.detail.repo-url); } }
                                        if root.detail.installed: OptionRow { label: "Eliminar del equipo"; danger: true;
                                            hint: "Borra el juego y lo que hayas añadido. Tus copias originales no se tocan.";
                                            clicked => { root.confirm-uninstall(root.detail.id); } }
                                        if !root.detail.installed: OptionRow { label: "Descárgalo para ver más opciones"; enabled: false; }
                                    }
                                }
                                if root.detail-msg != "": Text { text: root.detail-msg; color: #ffd166; font-size: 14px; wrap: word-wrap; width: detail-root.body-w; }
                            }
                        }
                        Hints { keys: [{k: "A", t: root.detail.installed ? "Jugar" : "Descargar"}, {k: "B", t: "Volver"}, {k: "◀ ▶", t: "Secciones"}]; }
                    }
                }

            }
        }
    }

    // ── Aviso (arriba, centrado): se oculta solo ─────────
    if root.notice != "": Rectangle {
        y: 74px; height: 48px;
        width: min(root.width - 80px, nt-l.preferred-width);
        x: (root.width - self.width) / 2;
        border-radius: 24px; background: #3b3e47;
        drop-shadow-blur: 24px; drop-shadow-color: #000000aa;
        Timer { interval: 14s; running: root.notice != ""; triggered => { root.notice = ""; } }
        nt-l := HorizontalLayout { padding-left: 20px; padding-right: 8px; spacing: 10px;
            Text { text: "ⓘ"; color: #2fd3ef; font-size: 18px; vertical-alignment: center; }
            Text { text: root.notice; color: white; font-size: 14px; vertical-alignment: center; overflow: elide; }
            Rectangle { width: 34px; height: 34px; y: 7px; border-radius: 17px; background: ntx.has-hover ? #ffffff22 : #00000000;
                Text { text: "✕"; color: #ffffffaa; font-size: 14px; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                ntx := TouchArea { mouse-cursor: pointer; clicked => { root.notice = ""; } } } }
    }

    // ── Confirmar borrado ────────────────────────────────
    if root.confirm-visible: confirm-dlg := FocusScope {
        width: 100%; height: 100%;
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Escape || e.text == Key.Backspace) { root.dialog-key("b"); return EventResult.accept; }
            if (e.text == Key.Return) { root.dialog-key("a"); return EventResult.accept; }
            return EventResult.reject;
        }
        Rectangle { background: #000000bb; }
        TouchArea { clicked => { root.confirm-visible = false; } }
        Rectangle {
            width: 520px; height: cf-l.preferred-height;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            border-radius: 26px; background: #2c2e35;
            drop-shadow-blur: 50px; drop-shadow-color: #000000cc;
            TouchArea { }
            cf-l := VerticalLayout {
                padding: 30px; spacing: 14px;
                Text { text: "¿Eliminar «\{root.confirm-title}»?"; color: white; font-size: 22px; font-weight: 900; wrap: word-wrap; horizontal-alignment: center; }
                Text { text: "Se borra el juego y todo lo que Freeport preparó para él. Tus copias originales no se tocan.";
                       color: #ffffffaa; font-size: 14px; wrap: word-wrap; horizontal-alignment: center; }
                if root.confirm-extra != "": HorizontalLayout {
                    spacing: 12px; padding-top: 6px;
                    Toggle { checked <=> root.confirm-wipe; }
                    Text { text: "Borrar también sus partidas y ajustes"; color: white; font-size: 14px; font-weight: 800; vertical-alignment: center; wrap: word-wrap; }
                }
                if root.confirm-extra != "": Text {
                    text: root.confirm-wipe ? "Se borrará también:\n" + root.confirm-extra : "Se conservan en:\n" + root.confirm-extra;
                    color: root.confirm-wipe ? #ff9aa6 : #ffffff77; font-size: 12px; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: center; spacing: 14px; padding-top: 12px;
                    PillBtn { label: "Cancelar"; kind: "secondary"; clicked => { root.confirm-visible = false; } }
                    PillBtn { label: "Eliminar"; kind: "danger"; clicked => { root.uninstall(root.confirm-id); root.confirm-visible = false; } }
                }
                Hints { keys: [{k: "A", t: "Eliminar"}, {k: "B", t: "Cancelar"}]; }
            }
        }
    }

    // ── Elegir versión ───────────────────────────────────
    if root.chooser-visible: chooser-dlg := FocusScope {
        width: 100%; height: 100%;
        property <float> pulse: 1.0;   // static: a constant animation repainted the whole window 60×/s
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Escape || e.text == Key.Backspace) { root.dialog-key("b"); return EventResult.accept; }
            if (e.text == Key.Return) { root.dialog-key("a"); return EventResult.accept; }
            if (e.text == Key.UpArrow) { root.dialog-key("up"); return EventResult.accept; }
            if (e.text == Key.DownArrow) { root.dialog-key("down"); return EventResult.accept; }
            return EventResult.reject;
        }
        Rectangle { background: #000000bb; }
        TouchArea { clicked => { root.chooser-visible = false; } }
        Rectangle {
            width: 580px; height: ch-l.preferred-height;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            border-radius: 26px; background: #2c2e35;
            drop-shadow-blur: 50px; drop-shadow-color: #000000cc;
            TouchArea { }
            ch-l := VerticalLayout {
                padding: 28px; spacing: 12px;
                Text { text: root.chooser-title; color: white; font-size: 22px; font-weight: 900; wrap: word-wrap; horizontal-alignment: center; }
                Text { text: root.chooser-mode == "install" ? "Hay varias versiones de este juego. ¿Cuál quieres descargar?"
                           : (root.chooser-mode == "play" ? "Tienes varias versiones. ¿Con cuál quieres jugar?"
                              : (root.chooser-mode == "romm" ? "Esto es lo que hay en tu RomM. ¿Cuál es?"
                                 : "Tienes varias versiones. ¿Cuál quieres eliminar?"));
                       color: #ffffffaa; font-size: 14px; wrap: word-wrap; horizontal-alignment: center; }
                for v[i] in root.chooser-items: Rectangle {
                    height: 66px; border-radius: 18px;
                    background: i == root.chooser-focus ? #3b3e47 : (cha.has-hover ? #ffffff10 : #ffffff08);
                    if i == root.chooser-focus: Rectangle { x: -4px; y: -4px; width: parent.width + 8px; height: parent.height + 8px;
                        border-radius: 22px; border-width: 3px; border-color: #2fd3ef.with-alpha(chooser-dlg.pulse); }
                    HorizontalLayout {
                        padding-left: 20px; padding-right: 20px; spacing: 10px;
                        VerticalLayout {
                            alignment: center; spacing: 2px; horizontal-stretch: 1;
                            Text { text: v.name; color: white; font-size: 16px; font-weight: 800; overflow: elide; }
                            Text { text: root.chooser-mode == "romm" ? v.meta
                                         : (v.is-windows ? "Versión de Windows" : (v.platforms != "" ? v.platforms : ""));
                                   color: #ffffff88; font-size: 12px; overflow: elide; }
                        }
                        if v.installed: Text { text: "✓ Instalada"; color: #4de1c1; font-size: 13px; font-weight: 800; vertical-alignment: center; }
                    }
                    cha := TouchArea { mouse-cursor: pointer; clicked => { root.chooser-focus = i; root.dialog-key("a"); } }
                }
                if root.chooser-mode == "play": HorizontalLayout {
                    spacing: 12px; padding-top: 4px;
                    Toggle { checked <=> root.chooser-remember; }
                    Text { text: "Recordar mi elección (se cambia en la ficha del juego)"; color: #ffffffaa; font-size: 13px; vertical-alignment: center; wrap: word-wrap; }
                }
                Hints { keys: [{k: "A", t: "Elegir"}, {k: "▲ ▼", t: "Moverse"}, {k: "B", t: "Cancelar"}]; }
            }
        }
    }

    // ── Visor de capturas ────────────────────────────────
    if root.viewer-visible: Rectangle {
        width: 100%; height: 100%;
        background: #000000ee;
        TouchArea { clicked => { root.viewer-visible = false; } }
        Image { source: root.viewer-image; width: parent.width * 0.92; height: parent.height * 0.86;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2 - 16px; image-fit: contain; }
        Text { y: parent.height - 40px; width: parent.width; text: "Toca o pulsa B para cerrar";
               color: #ffffff88; font-size: 13px; horizontal-alignment: center; }
    }

    // ── Retro CRT effect (scanlines + vignette), purely visual ───────────
    if root.crt-visible: Rectangle {
        width: 100%; height: 100%;
        Image {
            source: @image-url("../assets/crt-scanlines.png");
            width: 100%; height: 100%;
            vertical-tiling: repeat;
            horizontal-tiling: repeat;
            image-rendering: pixelated;
            opacity: 0.7;
        }
        Rectangle { background: @radial-gradient(circle, #00000000 48%, #000000b0 120%); }
    }
}
